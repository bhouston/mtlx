<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Pale cream recycled-polymer composite with pink, mint, and blue plastic flecks and a smooth satin finish. -->
  <!-- Clean newly manufactured surface. UV 0..1 = 1 metre; height in metres. Recipe: terrazzoChips. -->
  <nodegraph name="NG_recycledPlasticTerrazzoPastel">
    <texcoord name="uv" type="vector2"></texcoord>
    <multiply name="multiply_7" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="65" /></multiply>
    <worleynoise2d name="worleynoise2d_8" type="float"><input name="texcoord" type="vector2" nodename="multiply_7" /><input name="style" type="integer" value="1" /></worleynoise2d>
    <worleynoise2d name="worleynoise2d_9" type="vector2"><input name="texcoord" type="vector2" nodename="multiply_7" /></worleynoise2d>
    <dotproduct name="dotproduct_10" type="float"><input name="in1" type="vector2" nodename="worleynoise2d_9" /><input name="in2" type="vector2" value="-1, 1" /></dotproduct>
    <smoothstep name="smoothstep_11" type="float"><input name="in" type="float" nodename="dotproduct_10" /><input name="low" type="float" value="0.055" /><input name="high" type="float" value="0.12" /></smoothstep>
    <mix name="mix_12" type="color3"><input name="bg" type="color3" value="0.16000000000000003, 0.128, 0.08800000000000001" /><input name="fg" type="color3" value="0.58, 0.46399999999999997, 0.319" /><input name="mix" type="float" nodename="worleynoise2d_8" /></mix>
    <smoothstep name="smoothstep_13" type="float"><input name="in" type="float" nodename="worleynoise2d_8" /><input name="low" type="float" value="0.7" /><input name="high" type="float" value="0.85" /></smoothstep>
    <mix name="mix_14" type="color3"><input name="bg" type="color3" nodename="mix_12" /><input name="fg" type="color3" value="0.4, 0.15, 0.08" /><input name="mix" type="float" nodename="smoothstep_13" /></mix>
    <mix name="mix_15" type="color3"><input name="bg" type="color3" value="0.4, 0.32, 0.22" /><input name="fg" type="color3" nodename="mix_14" /><input name="mix" type="float" nodename="smoothstep_11" /></mix>
    <multiply name="multiply_16" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="65" /></multiply>
    <add name="add_17" type="vector2"><input name="in1" type="vector2" nodename="multiply_16" /><input name="in2" type="vector2" value="13.37, 7.91" /></add>
    <noise2d name="noise2d_18" type="float"><input name="texcoord" type="vector2" nodename="add_17" /><input name="amplitude" type="float" value="0.000035" /><input name="pivot" type="float" value="0" /></noise2d>
    <subtract name="subtract_19" type="float"><input name="in1" type="float" nodename="smoothstep_11" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="multiply_20" type="float"><input name="in1" type="float" nodename="subtract_19" /><input name="in2" type="float" value="0.072" /></multiply>
    <add name="add_21" type="float"><input name="in1" type="float" value="0.48" /><input name="in2" type="float" nodename="multiply_20" /></add>
    <clamp name="clamp_22" type="float"><input name="in" type="float" nodename="add_21" /><input name="low" type="float" value="0.025" /><input name="high" type="float" value="0.98" /></clamp>
    <multiply name="multiply_23" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="multiply_24" type="float"><input name="in1" type="float" nodename="noise2d_18" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="heighttonormal_25" type="vector3"><input name="in" type="float" nodename="multiply_24" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="multiply_23" /></heighttonormal>
    <normalmap name="normalmap_26" type="vector3"><input name="in" type="vector3" nodename="heighttonormal_25" /></normalmap>
    <constant name="constant_27" type="float"><input name="value" type="float" value="0" /></constant>
    <output name="base_color" type="color3" nodename="mix_15" />
    <output name="specular_roughness" type="float" nodename="clamp_22" />
    <output name="metalness" type="float" nodename="constant_27" />
    <output name="normal" type="vector3" nodename="normalmap_26" />
    <output name="height" type="float" nodename="noise2d_18" />
  </nodegraph>
  <standard_surface name="SR_recycledPlasticTerrazzoPastel" type="surfaceshader">
    <input name="base" type="float" value="1" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_anisotropy" type="float" value="0" />
    <input name="base_color" type="color3" nodegraph="NG_recycledPlasticTerrazzoPastel" output="base_color" />
    <input name="specular_roughness" type="float" nodegraph="NG_recycledPlasticTerrazzoPastel" output="specular_roughness" />
    <input name="metalness" type="float" nodegraph="NG_recycledPlasticTerrazzoPastel" output="metalness" />
    <input name="normal" type="vector3" nodegraph="NG_recycledPlasticTerrazzoPastel" output="normal" />
  </standard_surface>
  <surfacematerial name="M_recycledPlasticTerrazzoPastel" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_recycledPlasticTerrazzoPastel" /></surfacematerial>
</materialx>
