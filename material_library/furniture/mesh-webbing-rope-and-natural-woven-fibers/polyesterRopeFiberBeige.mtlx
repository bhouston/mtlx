<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Clean new furniture sample. UV 0..1 = 1 metre; heights in metres. -->
  <!-- warm beige polyester rope-fiber surface; densely aligned fine fibers and low sheen. -->
  <!-- rope: pitch 0.005 m, relief 0.00012 m. Microfiber detail is statistical roughness below resolved yarn scale. -->
  <nodegraph name="NG_polyesterRopeFiberBeige">
    <texcoord name="uv" type="vector2"></texcoord>
    <multiply name="multiply_1" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="900, 900" /></multiply>
    <add name="add_2" type="vector2"><input name="in1" type="vector2" nodename="multiply_1" /><input name="in2" type="vector2" value="0.137, 0.731" /></add>
    <noise2d name="noise2d_3" type="float"><input name="texcoord" type="vector2" nodename="add_2" /><input name="amplitude" type="float" value="0.8" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <multiply name="multiply_4" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="4, 4" /></multiply>
    <add name="add_5" type="vector2"><input name="in1" type="vector2" nodename="multiply_4" /><input name="in2" type="vector2" value="0.137, 0.731" /></add>
    <noise2d name="noise2d_6" type="float"><input name="texcoord" type="vector2" nodename="add_5" /><input name="amplitude" type="float" value="0.8" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <multiply name="multiply_7" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="700, 12" /></multiply>
    <add name="add_8" type="vector2"><input name="in1" type="vector2" nodename="multiply_7" /><input name="in2" type="vector2" value="0.137, 0.731" /></add>
    <noise2d name="noise2d_9" type="float"><input name="texcoord" type="vector2" nodename="add_8" /><input name="amplitude" type="float" value="0.8" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <mix name="mix_10" type="float"><input name="bg" type="float" value="0.72" /><input name="fg" type="float" value="1.03" /><input name="mix" type="float" nodename="noise2d_9" /></mix>
    <multiply name="multiply_11" type="color3"><input name="in1" type="color3" value="0.45, 0.33, 0.22" /><input name="in2" type="color3" value="1, 1, 1" /></multiply>
    <mix name="mix_12" type="float"><input name="bg" type="float" value="0.97" /><input name="fg" type="float" value="1.03" /><input name="mix" type="float" nodename="noise2d_6" /></mix>
    <multiply name="multiply_13" type="float"><input name="in1" type="float" nodename="mix_10" /><input name="in2" type="float" nodename="mix_12" /></multiply>
    <multiply name="base_color" type="color3"><input name="in1" type="color3" nodename="multiply_11" /><input name="in2" type="float" nodename="multiply_13" /></multiply>
    <mix name="roughness" type="float"><input name="bg" type="float" value="0.735" /><input name="fg" type="float" value="0.805" /><input name="mix" type="float" nodename="noise2d_9" /></mix>
    <multiply name="multiply_14" type="float"><input name="in1" type="float" nodename="noise2d_9" /><input name="in2" type="float" value="0.00012" /></multiply>
    <multiply name="multiply_15" type="float"><input name="in1" type="float" nodename="noise2d_3" /><input name="in2" type="float" value="0.000009600000000000001" /></multiply>
    <add name="height" type="float"><input name="in1" type="float" nodename="multiply_14" /><input name="in2" type="float" nodename="multiply_15" /></add>
    <multiply name="multiply_16" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="1000, 1000" /></multiply>
    <multiply name="multiply_17" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="n_tangent" type="vector3"><input name="in" type="float" nodename="multiply_17" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="multiply_16" /></heighttonormal>
    <normalmap name="n_world" type="vector3"><input name="in" type="vector3" nodename="n_tangent" /></normalmap>
    <constant name="metalness" type="float"><input name="value" type="float" value="0" /></constant>
    <constant name="specular" type="float"><input name="value" type="float" value="0.2" /></constant>
    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="specular_roughness_out" type="float" nodename="roughness" />
    <output name="metalness_out" type="float" nodename="metalness" />
    <output name="normal_out" type="vector3" nodename="n_world" />
    <output name="specular_out" type="float" nodename="specular" />
  </nodegraph>
  <standard_surface name="SR_polyesterRopeFiberBeige" type="surfaceshader">
    <input name="base" type="float" value="1" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="base_color" type="color3" nodegraph="NG_polyesterRopeFiberBeige" output="base_color_out" />
    <input name="specular_roughness" type="float" nodegraph="NG_polyesterRopeFiberBeige" output="specular_roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_polyesterRopeFiberBeige" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_polyesterRopeFiberBeige" output="normal_out" />
    <input name="specular" type="float" nodegraph="NG_polyesterRopeFiberBeige" output="specular_out" />
    <input name="sheen" type="float" value="0.12" />
    <input name="sheen_color" type="color3" value="0.5425, 0.4045, 0.278" />
    <input name="sheen_roughness" type="float" value="0.7" />
    <input name="specular_anisotropy" type="float" value="0.1" />
    <input name="diffuse_roughness" type="float" value="0.25" />
  </standard_surface>
  <surfacematerial name="M_polyesterRopeFiberBeige" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_polyesterRopeFiberBeige" /></surfacematerial>
</materialx>
