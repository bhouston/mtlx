<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- New cream decorative enamel with a fine intentional crackle color pattern and smooth glossy surface. -->
  <!-- Clean newly manufactured surface. UV 0..1 = 1 metre; height in metres. Recipe: decorativeCrackle. -->
  <nodegraph name="NG_enamelCrackleCream">
    <texcoord name="uv" type="vector2"></texcoord>
    <multiply name="multiply_7" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="85" /></multiply>
    <worleynoise2d name="worleynoise2d_8" type="vector2"><input name="texcoord" type="vector2" nodename="multiply_7" /></worleynoise2d>
    <dotproduct name="dotproduct_9" type="float"><input name="in1" type="vector2" nodename="worleynoise2d_8" /><input name="in2" type="vector2" value="-1, 1" /></dotproduct>
    <smoothstep name="smoothstep_10" type="float"><input name="in" type="float" nodename="dotproduct_9" /><input name="low" type="float" value="0.012" /><input name="high" type="float" value="0.035" /></smoothstep>
    <mix name="mix_11" type="color3"><input name="bg" type="color3" value="0.22499999999999998, 0.192, 0.129" /><input name="fg" type="color3" value="0.75, 0.64, 0.43" /><input name="mix" type="float" nodename="smoothstep_10" /></mix>
    <multiply name="multiply_12" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="170" /></multiply>
    <add name="add_13" type="vector2"><input name="in1" type="vector2" nodename="multiply_12" /><input name="in2" type="vector2" value="13.37, 7.91" /></add>
    <noise2d name="noise2d_14" type="float"><input name="texcoord" type="vector2" nodename="add_13" /><input name="amplitude" type="float" value="0.000001" /><input name="pivot" type="float" value="0" /></noise2d>
    <subtract name="subtract_15" type="float"><input name="in1" type="float" nodename="smoothstep_10" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="multiply_16" type="float"><input name="in1" type="float" nodename="subtract_15" /><input name="in2" type="float" value="0.018" /></multiply>
    <add name="add_17" type="float"><input name="in1" type="float" value="0.12" /><input name="in2" type="float" nodename="multiply_16" /></add>
    <clamp name="clamp_18" type="float"><input name="in" type="float" nodename="add_17" /><input name="low" type="float" value="0.025" /><input name="high" type="float" value="0.98" /></clamp>
    <multiply name="multiply_19" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="multiply_20" type="float"><input name="in1" type="float" nodename="noise2d_14" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="heighttonormal_21" type="vector3"><input name="in" type="float" nodename="multiply_20" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="multiply_19" /></heighttonormal>
    <normalmap name="normalmap_22" type="vector3"><input name="in" type="vector3" nodename="heighttonormal_21" /></normalmap>
    <constant name="constant_23" type="float"><input name="value" type="float" value="0" /></constant>
    <output name="base_color" type="color3" nodename="mix_11" />
    <output name="specular_roughness" type="float" nodename="clamp_18" />
    <output name="metalness" type="float" nodename="constant_23" />
    <output name="normal" type="vector3" nodename="normalmap_22" />
    <output name="height" type="float" nodename="noise2d_14" />
  </nodegraph>
  <standard_surface name="SR_enamelCrackleCream" type="surfaceshader">
    <input name="base" type="float" value="1" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_anisotropy" type="float" value="0" />
    <input name="base_color" type="color3" nodegraph="NG_enamelCrackleCream" output="base_color" />
    <input name="specular_roughness" type="float" nodegraph="NG_enamelCrackleCream" output="specular_roughness" />
    <input name="metalness" type="float" nodegraph="NG_enamelCrackleCream" output="metalness" />
    <input name="normal" type="vector3" nodegraph="NG_enamelCrackleCream" output="normal" />
  </standard_surface>
  <surfacematerial name="M_enamelCrackleCream" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_enamelCrackleCream" /></surfacematerial>
</materialx>
