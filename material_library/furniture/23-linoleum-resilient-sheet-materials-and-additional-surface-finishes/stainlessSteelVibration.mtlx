<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Clean silver stainless steel with fine multidirectional circular abrasion texture and broad metallic highlights. -->
  <!-- Clean newly manufactured surface. UV 0..1 = 1 metre; height in metres. Recipe: multidirectionalBrush. -->
  <nodegraph name="NG_stainlessSteelVibration">
    <texcoord name="uv" type="vector2"></texcoord>
    <multiply name="multiply_7" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="330" /></multiply>
    <add name="add_8" type="vector2"><input name="in1" type="vector2" nodename="multiply_7" /><input name="in2" type="vector2" value="13.37, 7.91" /></add>
    <noise2d name="noise2d_9" type="float"><input name="texcoord" type="vector2" nodename="add_8" /><input name="amplitude" type="float" value="0.6" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <multiply name="multiply_10" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="70, 290" /></multiply>
    <add name="add_11" type="vector2"><input name="in1" type="vector2" nodename="multiply_10" /><input name="in2" type="vector2" value="13.37, 7.91" /></add>
    <noise2d name="noise2d_12" type="float"><input name="texcoord" type="vector2" nodename="add_11" /><input name="amplitude" type="float" value="0.000018" /><input name="pivot" type="float" value="0" /></noise2d>
    <multiply name="multiply_13" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="320, 90" /></multiply>
    <add name="add_14" type="vector2"><input name="in1" type="vector2" nodename="multiply_13" /><input name="in2" type="vector2" value="13.37, 7.91" /></add>
    <noise2d name="noise2d_15" type="float"><input name="texcoord" type="vector2" nodename="add_14" /><input name="amplitude" type="float" value="0.000018" /><input name="pivot" type="float" value="0" /></noise2d>
    <add name="add_16" type="float"><input name="in1" type="float" nodename="noise2d_12" /><input name="in2" type="float" nodename="noise2d_15" /></add>
    <mix name="mix_17" type="color3"><input name="bg" type="color3" value="0.5488000000000001, 0.5683999999999999, 0.5781999999999999" /><input name="fg" type="color3" value="0.5712, 0.5916, 0.6018" /><input name="mix" type="float" nodename="noise2d_9" /></mix>
    <subtract name="subtract_18" type="float"><input name="in1" type="float" nodename="noise2d_9" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="multiply_19" type="float"><input name="in1" type="float" nodename="subtract_18" /><input name="in2" type="float" value="0.054" /></multiply>
    <add name="add_20" type="float"><input name="in1" type="float" value="0.36" /><input name="in2" type="float" nodename="multiply_19" /></add>
    <clamp name="clamp_21" type="float"><input name="in" type="float" nodename="add_20" /><input name="low" type="float" value="0.025" /><input name="high" type="float" value="0.98" /></clamp>
    <multiply name="multiply_22" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="multiply_23" type="float"><input name="in1" type="float" nodename="add_16" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="heighttonormal_24" type="vector3"><input name="in" type="float" nodename="multiply_23" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="multiply_22" /></heighttonormal>
    <normalmap name="normalmap_25" type="vector3"><input name="in" type="vector3" nodename="heighttonormal_24" /></normalmap>
    <constant name="constant_26" type="float"><input name="value" type="float" value="1" /></constant>
    <output name="base_color" type="color3" nodename="mix_17" />
    <output name="specular_roughness" type="float" nodename="clamp_21" />
    <output name="metalness" type="float" nodename="constant_26" />
    <output name="normal" type="vector3" nodename="normalmap_25" />
    <output name="height" type="float" nodename="add_16" />
  </nodegraph>
  <standard_surface name="SR_stainlessSteelVibration" type="surfaceshader">
    <input name="base" type="float" value="1" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_anisotropy" type="float" value="0.15" />
    <input name="base_color" type="color3" nodegraph="NG_stainlessSteelVibration" output="base_color" />
    <input name="specular_roughness" type="float" nodegraph="NG_stainlessSteelVibration" output="specular_roughness" />
    <input name="metalness" type="float" nodegraph="NG_stainlessSteelVibration" output="metalness" />
    <input name="normal" type="vector3" nodegraph="NG_stainlessSteelVibration" output="normal" />
  </standard_surface>
  <surfacematerial name="M_stainlessSteelVibration" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_stainlessSteelVibration" /></surfacematerial>
</materialx>
