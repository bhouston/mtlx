<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Pale straw bamboo laminate cross-section appearance with alternating fine fiber bands; clear matte finish. -->
  <!-- UV 0..1 = 1 metre. Height output is in metres. Clean new finish; no wear. -->
  <!-- Scales: growth bands 11-18 mm; pores 0.83 mm across / 5.6 mm along; end-grain fiber clusters 1.5 mm; rays 10 x 4.5 mm, sparse 10 percent pale modulation. -->
  <!-- End grain rings 5.6 mm; plywood plies 1.9 mm; cork cells 2.4-11 mm; polymer texture 1.8-5.6 mm. -->
  <!-- Relief: wood pores 1-45 micrometres by finish; cork 75 micrometres; polymer 1-45 micrometres. -->
  <nodegraph name="NG_laminatedBambooEdgeNatural">
    <texcoord name="uv" type="vector2"></texcoord>
    <multiply name="n1" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="500, 70" /></multiply>
    <add name="n2" type="vector2"><input name="in1" type="vector2" nodename="n1" /><input name="in2" type="vector2" value="3.17, 7.43" /></add>
    <fractal2d name="n3" type="float"><input name="texcoord" type="vector2" nodename="n2" /><input name="amplitude" type="float" value="1" /><input name="octaves" type="integer" value="2" /></fractal2d>
    <smoothstep name="n4" type="float"><input name="in" type="float" nodename="n3" /><input name="low" type="float" value="-0.55" /><input name="high" type="float" value="0.55" /></smoothstep>
    <mix name="n5" type="float"><input name="bg" type="float" value="0.86" /><input name="fg" type="float" value="1.1400000000000001" /><input name="mix" type="float" nodename="n4" /></mix>
    <multiply name="n6" type="float"><input name="in1" type="float" nodename="n3" /><input name="in2" type="float" value="0.000018" /></multiply>
    <separate2 name="n7" type="multioutput"><input name="in" type="vector2" nodename="uv" /></separate2>
    <multiply name="n8" type="float"><input name="in1" type="float" nodename="n7" output="outy" /><input name="in2" type="float" value="3300" /></multiply>
    <sin name="n9" type="float"><input name="in" type="float" nodename="n8" /></sin>
    <multiply name="n10" type="float"><input name="in1" type="float" nodename="n9" /><input name="in2" type="float" value="0.5" /></multiply>
    <add name="n11" type="float"><input name="in1" type="float" nodename="n10" /><input name="in2" type="float" value="0.5" /></add>
    <smoothstep name="n12" type="float"><input name="in" type="float" nodename="n11" /><input name="low" type="float" value="0.25" /><input name="high" type="float" value="0.75" /></smoothstep>
    <mix name="n13" type="float"><input name="bg" type="float" value="0.55" /><input name="fg" type="float" value="1.1" /><input name="mix" type="float" nodename="n12" /></mix>
    <multiply name="n14" type="float"><input name="in1" type="float" nodename="n5" /><input name="in2" type="float" nodename="n13" /></multiply>
    <constant name="n15" type="color3"><input name="value" type="color3" value="0.52, 0.37, 0.2" /></constant>
    <multiply name="n16" type="color3"><input name="in1" type="color3" nodename="n15" /><input name="in2" type="float" nodename="n14" /></multiply>
    <constant name="n17" type="float"><input name="value" type="float" value="0.85" /></constant>
    <multiply name="n18" type="float"><input name="in1" type="float" nodename="n4" /><input name="in2" type="float" value="0.025" /></multiply>
    <add name="n19" type="float"><input name="in1" type="float" nodename="n17" /><input name="in2" type="float" nodename="n18" /></add>
    <add name="height_m" type="float"><input name="in1" type="float" nodename="n6" /><input name="in2" type="float" value="0" /></add>
    <multiply name="n20" type="float"><input name="in1" type="float" nodename="height_m" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="n21" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="n22" type="vector3"><input name="in" type="float" nodename="n20" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="n21" /></heighttonormal>
    <normalmap name="n23" type="vector3"><input name="in" type="vector3" nodename="n22" /></normalmap>
    <constant name="n24" type="float"><input name="value" type="float" value="0" /></constant>
    <output name="base_color" type="color3" nodename="n16" />
    <output name="roughness" type="float" nodename="n19" />
    <output name="metalness" type="float" nodename="n24" />
    <output name="normal" type="vector3" nodename="n23" />
    <output name="height" type="float" nodename="height_m" />
  </nodegraph>
  <standard_surface name="SR_laminatedBambooEdgeNatural" type="surfaceshader">
    <input name="base" type="float" value="1" />
    <input name="base_color" type="color3" nodegraph="NG_laminatedBambooEdgeNatural" output="base_color" />
    <input name="specular_roughness" type="float" nodegraph="NG_laminatedBambooEdgeNatural" output="roughness" />
    <input name="metalness" type="float" nodegraph="NG_laminatedBambooEdgeNatural" output="metalness" />
    <input name="normal" type="vector3" nodegraph="NG_laminatedBambooEdgeNatural" output="normal" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="coat" type="float" value="0" />
    <input name="coat_roughness" type="float" value="0.08" />
    <input name="coat_normal" type="vector3" nodegraph="NG_laminatedBambooEdgeNatural" output="normal" />
    <input name="specular_anisotropy" type="float" value="0" />
    <input name="sheen" type="float" value="0" />
  </standard_surface>
  <surfacematerial name="M_laminatedBambooEdgeNatural" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_laminatedBambooEdgeNatural" /></surfacematerial>
</materialx>
