<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Clean new furniture sample. UV 0..1 = 1 metre; heights in metres. -->
  <!-- warm beige coated leather; fine diagonal crosshatch embossing and satin finish. -->
  <!-- leather: pitch 0.001 m, relief 0.000025 m. Microfiber detail is statistical roughness below resolved yarn scale. -->
  <nodegraph name="NG_leatherSaffianoBeige">
    <texcoord name="uv" type="vector2"></texcoord>
    <multiply name="multiply_1" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="900, 900" /></multiply>
    <add name="add_2" type="vector2"><input name="in1" type="vector2" nodename="multiply_1" /><input name="in2" type="vector2" value="0.137, 0.731" /></add>
    <noise2d name="noise2d_3" type="float"><input name="texcoord" type="vector2" nodename="add_2" /><input name="amplitude" type="float" value="0.8" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <multiply name="multiply_4" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="4, 4" /></multiply>
    <add name="add_5" type="vector2"><input name="in1" type="vector2" nodename="multiply_4" /><input name="in2" type="vector2" value="0.137, 0.731" /></add>
    <noise2d name="noise2d_6" type="float"><input name="texcoord" type="vector2" nodename="add_5" /><input name="amplitude" type="float" value="0.8" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <separate2 name="uv_sep" type="multioutput"><input name="in" type="vector2" nodename="uv" /></separate2>
    <add name="add_7" type="float"><input name="in1" type="float" nodename="uv_sep" output="outx" /><input name="in2" type="float" nodename="uv_sep" output="outy" /></add>
    <multiply name="multiply_8" type="float"><input name="in1" type="float" nodename="add_7" /><input name="in2" type="float" value="2199.114857512855" /></multiply>
    <sin name="sin_9" type="float"><input name="in" type="float" nodename="multiply_8" /></sin>
    <multiply name="multiply_10" type="float"><input name="in1" type="float" nodename="sin_9" /><input name="in2" type="float" value="0.5" /></multiply>
    <add name="add_11" type="float"><input name="in1" type="float" nodename="multiply_10" /><input name="in2" type="float" value="0.5" /></add>
    <subtract name="subtract_12" type="float"><input name="in1" type="float" nodename="uv_sep" output="outx" /><input name="in2" type="float" nodename="uv_sep" output="outy" /></subtract>
    <multiply name="multiply_13" type="float"><input name="in1" type="float" nodename="subtract_12" /><input name="in2" type="float" value="2199.114857512855" /></multiply>
    <sin name="sin_14" type="float"><input name="in" type="float" nodename="multiply_13" /></sin>
    <multiply name="multiply_15" type="float"><input name="in1" type="float" nodename="sin_14" /><input name="in2" type="float" value="0.5" /></multiply>
    <add name="add_16" type="float"><input name="in1" type="float" nodename="multiply_15" /><input name="in2" type="float" value="0.5" /></add>
    <multiply name="multiply_17" type="float"><input name="in1" type="float" nodename="add_11" /><input name="in2" type="float" nodename="add_16" /></multiply>
    <mix name="mix_18" type="float"><input name="bg" type="float" value="0.84" /><input name="fg" type="float" value="1.04" /><input name="mix" type="float" nodename="multiply_17" /></mix>
    <multiply name="multiply_19" type="color3"><input name="in1" type="color3" value="0.45, 0.33, 0.22" /><input name="in2" type="color3" value="1, 1, 1" /></multiply>
    <mix name="mix_20" type="float"><input name="bg" type="float" value="0.97" /><input name="fg" type="float" value="1.03" /><input name="mix" type="float" nodename="noise2d_6" /></mix>
    <multiply name="multiply_21" type="float"><input name="in1" type="float" nodename="mix_18" /><input name="in2" type="float" nodename="mix_20" /></multiply>
    <multiply name="base_color" type="color3"><input name="in1" type="color3" nodename="multiply_19" /><input name="in2" type="float" nodename="multiply_21" /></multiply>
    <mix name="roughness" type="float"><input name="bg" type="float" value="0.43499999999999994" /><input name="fg" type="float" value="0.505" /><input name="mix" type="float" nodename="multiply_17" /></mix>
    <multiply name="multiply_22" type="float"><input name="in1" type="float" nodename="multiply_17" /><input name="in2" type="float" value="0.000025" /></multiply>
    <multiply name="multiply_23" type="float"><input name="in1" type="float" nodename="noise2d_3" /><input name="in2" type="float" value="0.0000020000000000000003" /></multiply>
    <add name="height" type="float"><input name="in1" type="float" nodename="multiply_22" /><input name="in2" type="float" nodename="multiply_23" /></add>
    <multiply name="multiply_24" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="1000, 1000" /></multiply>
    <multiply name="multiply_25" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="n_tangent" type="vector3"><input name="in" type="float" nodename="multiply_25" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="multiply_24" /></heighttonormal>
    <normalmap name="n_world" type="vector3"><input name="in" type="vector3" nodename="n_tangent" /></normalmap>
    <constant name="metalness" type="float"><input name="value" type="float" value="0" /></constant>
    <constant name="specular" type="float"><input name="value" type="float" value="0.5" /></constant>
    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="specular_roughness_out" type="float" nodename="roughness" />
    <output name="metalness_out" type="float" nodename="metalness" />
    <output name="normal_out" type="vector3" nodename="n_world" />
    <output name="specular_out" type="float" nodename="specular" />
  </nodegraph>
  <standard_surface name="SR_leatherSaffianoBeige" type="surfaceshader">
    <input name="base" type="float" value="1" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="base_color" type="color3" nodegraph="NG_leatherSaffianoBeige" output="base_color_out" />
    <input name="specular_roughness" type="float" nodegraph="NG_leatherSaffianoBeige" output="specular_roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_leatherSaffianoBeige" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_leatherSaffianoBeige" output="normal_out" />
    <input name="specular" type="float" nodegraph="NG_leatherSaffianoBeige" output="specular_out" />
    <input name="sheen" type="float" value="0.04" />
    <input name="sheen_color" type="color3" value="0.5425, 0.4045, 0.278" />
    <input name="sheen_roughness" type="float" value="0.7" />
    <input name="specular_anisotropy" type="float" value="0.1" />
    <input name="diffuse_roughness" type="float" value="0.25" />
  </standard_surface>
  <surfacematerial name="M_leatherSaffianoBeige" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_leatherSaffianoBeige" /></surfacematerial>
</materialx>
