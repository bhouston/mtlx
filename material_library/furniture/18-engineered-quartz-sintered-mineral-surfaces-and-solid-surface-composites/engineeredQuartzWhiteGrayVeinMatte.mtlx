<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Engineered quartz-resin composite, white with soft gray marble-like veins and fine quartz particles; smooth low-sheen surface. -->
  <!-- Clean newly manufactured surface. UV 0..1 = 1 metre; height in metres. Recipe: mineralVeins. -->
