<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Amber horn material with dark brown organic streaks, slight translucency, and polished surface. -->
  <!-- Clean newly manufactured surface. UV 0..1 = 1 metre; height in metres. Recipe: organicLongitudinalStriation. -->
  <nodegraph name="NG_hornAmberPolished">
    <texcoord name="uv" type="vector2"></texcoord>
    <multiply name="multiply_7" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="160, 7" /></multiply>
    <add name="add_8" type="vector2"><input name="in1" type="vector2" nodename="multiply_7" /><input name="in2" type="vector2" value="13.37, 7.91" /></add>
    <noise2d name="noise2d_9" type="float"><input name="texcoord" type="vector2" nodename="add_8" /><input name="amplitude" type="float" value="0.7" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <mix name="mix_10" type="color3"><input name="bg" type="color3" value="0.325, 0.155, 0.0325" /><input name="fg" type="color3" value="0.8125, 0.3875, 0.08125" /><input name="mix" type="float" nodename="noise2d_9" /></mix>
    <multiply name="multiply_11" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="160, 7" /></multiply>
    <add name="add_12" type="vector2"><input name="in1" type="vector2" nodename="multiply_11" /><input name="in2" type="vector2" value="13.37, 7.91" /></add>
    <noise2d name="noise2d_13" type="float"><input name="texcoord" type="vector2" nodename="add_12" /><input name="amplitude" type="float" value="0.000012" /><input name="pivot" type="float" value="0" /></noise2d>
    <subtract name="subtract_14" type="float"><input name="in1" type="float" nodename="noise2d_9" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="multiply_15" type="float"><input name="in1" type="float" nodename="subtract_14" /><input name="in2" type="float" value="0.0135" /></multiply>
    <add name="add_16" type="float"><input name="in1" type="float" value="0.09" /><input name="in2" type="float" nodename="multiply_15" /></add>
    <clamp name="clamp_17" type="float"><input name="in" type="float" nodename="add_16" /><input name="low" type="float" value="0.025" /><input name="high" type="float" value="0.98" /></clamp>
    <multiply name="multiply_18" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="multiply_19" type="float"><input name="in1" type="float" nodename="noise2d_13" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="heighttonormal_20" type="vector3"><input name="in" type="float" nodename="multiply_19" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="multiply_18" /></heighttonormal>
    <normalmap name="normalmap_21" type="vector3"><input name="in" type="vector3" nodename="heighttonormal_20" /></normalmap>
    <constant name="constant_22" type="float"><input name="value" type="float" value="0" /></constant>
    <output name="base_color" type="color3" nodename="mix_10" />
    <output name="specular_roughness" type="float" nodename="clamp_17" />
    <output name="metalness" type="float" nodename="constant_22" />
    <output name="normal" type="vector3" nodename="normalmap_21" />
    <output name="height" type="float" nodename="noise2d_13" />
  </nodegraph>
  <standard_surface name="SR_hornAmberPolished" type="surfaceshader">
    <input name="base" type="float" value="1" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_anisotropy" type="float" value="0" />
    <input name="transmission" type="float" value="0.3" />
    <input name="transmission_color" type="color3" value="0.9099999999999999, 0.434, 0.091" />
    <input name="transmission_depth" type="float" value="0.015" />
    <input name="transmission_scatter" type="color3" value="8, 8, 8" />
    <input name="thin_walled" type="boolean" value="false" />
    <input name="subsurface" type="float" value="0.4" />
    <input name="subsurface_color" type="color3" value="0.65, 0.31, 0.065" />
    <input name="subsurface_scale" type="float" value="0.002" />
    <input name="base_color" type="color3" nodegraph="NG_hornAmberPolished" output="base_color" />
    <input name="specular_roughness" type="float" nodegraph="NG_hornAmberPolished" output="specular_roughness" />
    <input name="metalness" type="float" nodegraph="NG_hornAmberPolished" output="metalness" />
    <input name="normal" type="vector3" nodegraph="NG_hornAmberPolished" output="normal" />
  </standard_surface>
  <surfacematerial name="M_hornAmberPolished" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_hornAmberPolished" /></surfacematerial>
</materialx>
