    <constant name="n36" type="color3"><input name="value" type="color3" value="0.2, 0.12, 0.075" /></constant>
    <multiply name="n37" type="color3"><input name="in1" type="color3" nodename="n36" /><input name="in2" type="float" nodename="n35" /></multiply>
