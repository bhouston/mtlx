    <add name="n43" type="float"><input name="in1" type="float" nodename="n41" /><input name="in2" type="float" nodename="n42" /></add>
    <constant name="n44" type="float"><input name="value" type="float" value="0.67" /></constant>
    <multiply name="n45" type="float"><input name="in1" type="float" nodename="n40" /><input name="in2" type="float" value="0.05" /></multiply>
    <add name="n46" type="float"><input name="in1" type="float" nodename="n44" /><input name="in2" type="float" nodename="n45" /></add>
    <add name="height_m" type="float"><input name="in1" type="float" nodename="n43" /><input name="in2" type="float" value="0" /></add>
    <multiply name="n47" type="float"><input name="in1" type="float" nodename="height_m" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="n48" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="n49" type="vector3"><input name="in" type="float" nodename="n47" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="n48" /></heighttonormal>
    <normalmap name="n50" type="vector3"><input name="in" type="vector3" nodename="n49" /></normalmap>
    <constant name="n51" type="float"><input name="value" type="float" value="0" /></constant>
    <output name="base_color" type="color3" nodename="n37" />
    <output name="roughness" type="float" nodename="n46" />
    <output name="metalness" type="float" nodename="n51" />
    <output name="normal" type="vector3" nodename="n50" />
    <output name="height" type="float" nodename="height_m" />
  </nodegraph>
  <standard_surface name="SR_europeanWalnutEndGrainMatte" type="surfaceshader">
    <input name="base" type="float" value="1" />
    <input name="base_color" type="color3" nodegraph="NG_europeanWalnutEndGrainMatte" output="base_color" />
    <input name="specular_roughness" type="float" nodegraph="NG_europeanWalnutEndGrainMatte" output="roughness" />
