    <multiply name="n9" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="18, 4" /></multiply>
    <add name="n10" type="vector2"><input name="in1" type="vector2" nodename="n9" /><input name="in2" type="vector2" value="3.4, 14.6" /></add>
    <fractal2d name="n11" type="float"><input name="texcoord" type="vector2" nodename="n10" /><input name="amplitude" type="float" value="0.45" /><input name="octaves" type="integer" value="2" /></fractal2d>
    <add name="n12" type="float"><input name="in1" type="float" nodename="n8" /><input name="in2" type="float" nodename="n11" /></add>
    <multiply name="n13" type="float"><input name="in1" type="float" nodename="n12" /><input name="in2" type="float" value="6.283185" /></multiply>
    <sin name="n14" type="float"><input name="in" type="float" nodename="n13" /></sin>
    <multiply name="n15" type="float"><input name="in1" type="float" nodename="n14" /><input name="in2" type="float" value="0.5" /></multiply>
    <add name="n16" type="float"><input name="in1" type="float" nodename="n15" /><input name="in2" type="float" value="0.5" /></add>
    <smoothstep name="n17" type="float"><input name="in" type="float" nodename="n16" /><input name="low" type="float" value="0.18" /><input name="high" type="float" value="0.9" /></smoothstep>
    <multiply name="n18" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="650, 650" /></multiply>
    <add name="n19" type="vector2"><input name="in1" type="vector2" nodename="n18" /><input name="in2" type="vector2" value="14.7, 9.3" /></add>
    <fractal2d name="n20" type="float"><input name="texcoord" type="vector2" nodename="n19" /><input name="amplitude" type="float" value="0.5" /><input name="octaves" type="integer" value="2" /></fractal2d>
    <add name="n21" type="float"><input name="in1" type="float" nodename="n20" /><input name="in2" type="float" value="0.5" /></add>
    <mix name="n22" type="float"><input name="bg" type="float" value="0.87" /><input name="fg" type="float" value="1.025" /><input name="mix" type="float" nodename="n17" /></mix>
