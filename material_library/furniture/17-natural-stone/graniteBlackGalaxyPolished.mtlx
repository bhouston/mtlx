<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Black granite with small reflective bronze-gold mineral flecks; polished surface with sharp glossy dielectric reflections and enhanced color depth. -->
  <!-- Clean newly manufactured surface. UV 0..1 = 1 metre; height in metres. Recipe: mineralGranules. -->
  <nodegraph name="NG_graniteBlackGalaxyPolished">
    <texcoord name="uv" type="vector2"></texcoord>
    <multiply name="multiply_7" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="260" /></multiply>
    <worleynoise2d name="worleynoise2d_9" type="vector2"><input name="texcoord" type="vector2" nodename="multiply_7" /></worleynoise2d>
    <dotproduct name="dotproduct_10" type="float"><input name="in1" type="vector2" nodename="worleynoise2d_9" /><input name="in2" type="vector2" value="-1, 1" /></dotproduct>
    <smoothstep name="smoothstep_11" type="float"><input name="in" type="float" nodename="dotproduct_10" /><input name="low" type="float" value="0.055" /><input name="high" type="float" value="0.12" /></smoothstep>
    <constant name="constant_13" type="color3"><input name="value" type="color3" value="0.55, 0.34, 0.08" /></constant>
    <mix name="mix_14" type="color3"><input name="bg" type="color3" value="0.01, 0.009, 0.008" /><input name="fg" type="color3" nodename="constant_13" /><input name="mix" type="float" nodename="smoothstep_11" /></mix>
    <multiply name="multiply_15" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="260" /></multiply>
    <add name="add_16" type="vector2"><input name="in1" type="vector2" nodename="multiply_15" /><input name="in2" type="vector2" value="13.37, 7.91" /></add>
    <noise2d name="noise2d_17" type="float"><input name="texcoord" type="vector2" nodename="add_16" /><input name="amplitude" type="float" value="0.000001" /><input name="pivot" type="float" value="0" /></noise2d>
    <subtract name="subtract_18" type="float"><input name="in1" type="float" nodename="smoothstep_11" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="multiply_19" type="float"><input name="in1" type="float" nodename="subtract_18" /><input name="in2" type="float" value="0.0135" /></multiply>
    <add name="add_20" type="float"><input name="in1" type="float" value="0.09" /><input name="in2" type="float" nodename="multiply_19" /></add>
    <clamp name="clamp_21" type="float"><input name="in" type="float" nodename="add_20" /><input name="low" type="float" value="0.025" /><input name="high" type="float" value="0.98" /></clamp>
    <multiply name="multiply_22" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="multiply_23" type="float"><input name="in1" type="float" nodename="noise2d_17" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="heighttonormal_24" type="vector3"><input name="in" type="float" nodename="multiply_23" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="multiply_22" /></heighttonormal>
    <normalmap name="normalmap_25" type="vector3"><input name="in" type="vector3" nodename="heighttonormal_24" /></normalmap>
    <constant name="constant_26" type="float"><input name="value" type="float" value="0" /></constant>
    <output name="base_color" type="color3" nodename="mix_14" />
    <output name="specular_roughness" type="float" nodename="clamp_21" />
    <output name="metalness" type="float" nodename="constant_26" />
    <output name="normal" type="vector3" nodename="normalmap_25" />
    <output name="height" type="float" nodename="noise2d_17" />
  </nodegraph>
  <standard_surface name="SR_graniteBlackGalaxyPolished" type="surfaceshader">
    <input name="base" type="float" value="1" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_anisotropy" type="float" value="0" />
    <input name="base_color" type="color3" nodegraph="NG_graniteBlackGalaxyPolished" output="base_color" />
    <input name="specular_roughness" type="float" nodegraph="NG_graniteBlackGalaxyPolished" output="specular_roughness" />
    <input name="metalness" type="float" nodegraph="NG_graniteBlackGalaxyPolished" output="metalness" />
    <input name="normal" type="vector3" nodegraph="NG_graniteBlackGalaxyPolished" output="normal" />
  </standard_surface>
  <surfacematerial name="M_graniteBlackGalaxyPolished" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_graniteBlackGalaxyPolished" /></surfacematerial>
</materialx>
