<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Black volcanic stone with fine irregular open pores and matte mineral scattering. -->
  <!-- Clean newly manufactured surface. UV 0..1 = 1 metre; height in metres. Recipe: mineralMottle. -->
  <nodegraph name="NG_lavaStoneBlackMatte">
    <texcoord name="uv" type="vector2"></texcoord>
    <multiply name="multiply_7" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="7" /></multiply>
    <add name="add_8" type="vector2"><input name="in1" type="vector2" nodename="multiply_7" /><input name="in2" type="vector2" value="13.37, 7.91" /></add>
    <noise2d name="noise2d_9" type="float"><input name="texcoord" type="vector2" nodename="add_8" /><input name="amplitude" type="float" value="0.6" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <mix name="mix_10" type="color3"><input name="bg" type="color3" value="0.00704, 0.00792, 0.0088" /><input name="fg" type="color3" value="0.00864, 0.00972, 0.0108" /><input name="mix" type="float" nodename="noise2d_9" /></mix>
    <multiply name="multiply_11" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="45" /></multiply>
    <add name="add_12" type="vector2"><input name="in1" type="vector2" nodename="multiply_11" /><input name="in2" type="vector2" value="13.37, 7.91" /></add>
    <noise2d name="noise2d_13" type="float"><input name="texcoord" type="vector2" nodename="add_12" /><input name="amplitude" type="float" value="0.00005" /><input name="pivot" type="float" value="0" /></noise2d>
    <multiply name="multiply_14" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="450" /></multiply>
    <add name="add_15" type="vector2"><input name="in1" type="vector2" nodename="multiply_14" /><input name="in2" type="vector2" value="13.37, 7.91" /></add>
    <noise2d name="noise2d_16" type="float"><input name="texcoord" type="vector2" nodename="add_15" /><input name="amplitude" type="float" value="0.000012" /><input name="pivot" type="float" value="0" /></noise2d>
    <add name="add_17" type="float"><input name="in1" type="float" nodename="noise2d_13" /><input name="in2" type="float" nodename="noise2d_16" /></add>
    <multiply name="multiply_18" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="250" /></multiply>
    <worleynoise2d name="worleynoise2d_19" type="float"><input name="texcoord" type="vector2" nodename="multiply_18" /><input name="jitter" type="float" value="0.7" /></worleynoise2d>
    <smoothstep name="smoothstep_20" type="float"><input name="in" type="float" nodename="worleynoise2d_19" /><input name="low" type="float" value="0.045" /><input name="high" type="float" value="0.13" /></smoothstep>
    <subtract name="subtract_21" type="float"><input name="in1" type="float" value="1" /><input name="in2" type="float" nodename="smoothstep_20" /></subtract>
    <multiply name="multiply_22" type="float"><input name="in1" type="float" nodename="subtract_21" /><input name="in2" type="float" value="0.000075" /></multiply>
    <subtract name="subtract_23" type="float"><input name="in1" type="float" nodename="add_17" /><input name="in2" type="float" nodename="multiply_22" /></subtract>
    <mix name="mix_24" type="color3"><input name="bg" type="color3" nodename="mix_10" /><input name="fg" type="color3" value="0.00384, 0.004319999999999999, 0.0048" /><input name="mix" type="float" nodename="subtract_21" /></mix>
    <subtract name="subtract_25" type="float"><input name="in1" type="float" nodename="noise2d_9" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="multiply_26" type="float"><input name="in1" type="float" nodename="subtract_25" /><input name="in2" type="float" value="0.08" /></multiply>
    <add name="add_27" type="float"><input name="in1" type="float" value="0.79" /><input name="in2" type="float" nodename="multiply_26" /></add>
    <clamp name="clamp_28" type="float"><input name="in" type="float" nodename="add_27" /><input name="low" type="float" value="0.025" /><input name="high" type="float" value="0.98" /></clamp>
    <multiply name="multiply_29" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="multiply_30" type="float"><input name="in1" type="float" nodename="subtract_23" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="heighttonormal_31" type="vector3"><input name="in" type="float" nodename="multiply_30" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="multiply_29" /></heighttonormal>
    <normalmap name="normalmap_32" type="vector3"><input name="in" type="vector3" nodename="heighttonormal_31" /></normalmap>
    <constant name="constant_33" type="float"><input name="value" type="float" value="0" /></constant>
    <output name="base_color" type="color3" nodename="mix_24" />
    <output name="specular_roughness" type="float" nodename="clamp_28" />
    <output name="metalness" type="float" nodename="constant_33" />
    <output name="normal" type="vector3" nodename="normalmap_32" />
    <output name="height" type="float" nodename="subtract_23" />
  </nodegraph>
  <standard_surface name="SR_lavaStoneBlackMatte" type="surfaceshader">
    <input name="base" type="float" value="1" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_anisotropy" type="float" value="0" />
    <input name="base_color" type="color3" nodegraph="NG_lavaStoneBlackMatte" output="base_color" />
    <input name="specular_roughness" type="float" nodegraph="NG_lavaStoneBlackMatte" output="specular_roughness" />
    <input name="metalness" type="float" nodegraph="NG_lavaStoneBlackMatte" output="metalness" />
    <input name="normal" type="vector3" nodegraph="NG_lavaStoneBlackMatte" output="normal" />
  </standard_surface>
  <surfacematerial name="M_lavaStoneBlackMatte" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_lavaStoneBlackMatte" /></surfacematerial>
</materialx>
