<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Clear decorative glass with sparse small internal air inclusions and a polished refractive surface. -->
  <!-- Clean newly manufactured surface. UV 0..1 = 1 metre; height in metres. Recipe: seededGlass. -->
  <nodegraph name="NG_glassSeededClear">
    <texcoord name="uv" type="vector2"></texcoord>
    <multiply name="multiply_1" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="240" /></multiply>
    <add name="add_2" type="vector2"><input name="in1" type="vector2" nodename="multiply_1" /><input name="in2" type="vector2" value="13.37, 7.91" /></add>
    <noise2d name="noise2d_3" type="float"><input name="texcoord" type="vector2" nodename="add_2" /><input name="amplitude" type="float" value="0.6" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <constant name="constant_7" type="color3"><input name="value" type="color3" value="0.95, 0.95, 0.95" /></constant>
    <multiply name="multiply_11" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="130" /></multiply>
    <worleynoise2d name="worleynoise2d_12" type="float"><input name="texcoord" type="vector2" nodename="multiply_11" /><input name="jitter" type="float" value="0.7" /></worleynoise2d>
    <smoothstep name="smoothstep_13" type="float"><input name="in" type="float" nodename="worleynoise2d_12" /><input name="low" type="float" value="0.045" /><input name="high" type="float" value="0.12" /></smoothstep>
    <subtract name="subtract_14" type="float"><input name="in1" type="float" value="1" /><input name="in2" type="float" nodename="smoothstep_13" /></subtract>
    <multiply name="multiply_15" type="float"><input name="in1" type="float" nodename="subtract_14" /><input name="in2" type="float" value="0.000035" /></multiply>
    <subtract name="subtract_16" type="float"><input name="in1" type="float" nodename="noise2d_3" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="multiply_17" type="float"><input name="in1" type="float" nodename="subtract_16" /><input name="in2" type="float" value="0.00825" /></multiply>
    <add name="add_18" type="float"><input name="in1" type="float" value="0.055" /><input name="in2" type="float" nodename="multiply_17" /></add>
    <clamp name="clamp_19" type="float"><input name="in" type="float" nodename="add_18" /><input name="low" type="float" value="0.025" /><input name="high" type="float" value="0.98" /></clamp>
    <multiply name="multiply_20" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="multiply_21" type="float"><input name="in1" type="float" nodename="multiply_15" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="heighttonormal_22" type="vector3"><input name="in" type="float" nodename="multiply_21" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="multiply_20" /></heighttonormal>
    <normalmap name="normalmap_23" type="vector3"><input name="in" type="vector3" nodename="heighttonormal_22" /></normalmap>
    <constant name="constant_24" type="float"><input name="value" type="float" value="0" /></constant>
    <output name="base_color" type="color3" nodename="constant_7" />
    <output name="specular_roughness" type="float" nodename="clamp_19" />
    <output name="metalness" type="float" nodename="constant_24" />
    <output name="normal" type="vector3" nodename="normalmap_23" />
    <output name="height" type="float" nodename="multiply_15" />
  </nodegraph>
  <standard_surface name="SR_glassSeededClear" type="surfaceshader">
    <input name="base" type="float" value="0" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.52" />
    <input name="specular_anisotropy" type="float" value="0" />
    <input name="transmission" type="float" value="1" />
    <input name="transmission_color" type="color3" value="0.995, 0.997, 0.996" />
    <input name="transmission_depth" type="float" value="0.01" />
    <input name="transmission_scatter" type="color3" value="0, 0, 0" />
    <input name="thin_walled" type="boolean" value="false" />
    <input name="base_color" type="color3" nodegraph="NG_glassSeededClear" output="base_color" />
    <input name="specular_roughness" type="float" nodegraph="NG_glassSeededClear" output="specular_roughness" />
    <input name="metalness" type="float" nodegraph="NG_glassSeededClear" output="metalness" />
    <input name="normal" type="vector3" nodegraph="NG_glassSeededClear" output="normal" />
  </standard_surface>
  <surfacematerial name="M_glassSeededClear" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_glassSeededClear" /></surfacematerial>
</materialx>
