<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Warm gold metallic-flake lacquer with fine reflective particles beneath a glossy dielectric clearcoat. -->
  <!-- UV 0..1 = 1 metre. Height output is in metres. Clean new finish; no wear. -->
  <!-- Scales: growth bands 11-18 mm; pores 0.83 mm across / 5.6 mm along; end-grain fiber clusters 1.5 mm; rays 10 x 4.5 mm, sparse 10 percent pale modulation. -->
  <!-- End grain rings 5.6 mm; plywood plies 1.9 mm; cork cells 2.4-11 mm; polymer texture 1.8-5.6 mm. -->
  <!-- Relief: wood pores 1-45 micrometres by finish; cork 75 micrometres; polymer 1-45 micrometres. -->
  <nodegraph name="NG_lacquerMetallicGold">
    <texcoord name="uv" type="vector2"></texcoord>
    <multiply name="n1" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="180, 180" /></multiply>
    <add name="n2" type="vector2"><input name="in1" type="vector2" nodename="n1" /><input name="in2" type="vector2" value="3.17, 7.43" /></add>
    <fractal2d name="n3" type="float"><input name="texcoord" type="vector2" nodename="n2" /><input name="amplitude" type="float" value="1" /><input name="octaves" type="integer" value="2" /></fractal2d>
    <smoothstep name="n4" type="float"><input name="in" type="float" nodename="n3" /><input name="low" type="float" value="-0.55" /><input name="high" type="float" value="0.55" /></smoothstep>
    <smoothstep name="n7" type="float"><input name="in" type="float" nodename="n3" /><input name="low" type="float" value="0.3" /><input name="high" type="float" value="0.6" /></smoothstep>
    <mix name="n8" type="float"><input name="bg" type="float" value="0.85" /><input name="fg" type="float" value="1.2" /><input name="mix" type="float" nodename="n7" /></mix>
    <multiply name="n9" type="float"><input name="in1" type="float" nodename="n7" /><input name="in2" type="float" value="0.75" /></multiply>
    <multiply name="n10" type="float"><input name="in1" type="float" nodename="n3" /><input name="in2" type="float" value="0.000001" /></multiply>
    <constant name="n11" type="color3"><input name="value" type="color3" value="0.72, 0.42, 0.09" /></constant>
    <multiply name="n12" type="color3"><input name="in1" type="color3" nodename="n11" /><input name="in2" type="float" nodename="n8" /></multiply>
    <constant name="n13" type="float"><input name="value" type="float" value="0.21" /></constant>
    <multiply name="n14" type="float"><input name="in1" type="float" nodename="n4" /><input name="in2" type="float" value="0.025" /></multiply>
    <add name="n15" type="float"><input name="in1" type="float" nodename="n13" /><input name="in2" type="float" nodename="n14" /></add>
    <add name="height_m" type="float"><input name="in1" type="float" nodename="n10" /><input name="in2" type="float" value="0" /></add>
    <multiply name="n16" type="float"><input name="in1" type="float" nodename="height_m" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="n17" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="n18" type="vector3"><input name="in" type="float" nodename="n16" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="n17" /></heighttonormal>
    <normalmap name="n19" type="vector3"><input name="in" type="vector3" nodename="n18" /></normalmap>
    <output name="base_color" type="color3" nodename="n12" />
    <output name="roughness" type="float" nodename="n15" />
    <output name="metalness" type="float" nodename="n9" />
    <output name="normal" type="vector3" nodename="n19" />
    <output name="height" type="float" nodename="height_m" />
  </nodegraph>
  <standard_surface name="SR_lacquerMetallicGold" type="surfaceshader">
    <input name="base" type="float" value="1" />
    <input name="base_color" type="color3" nodegraph="NG_lacquerMetallicGold" output="base_color" />
    <input name="specular_roughness" type="float" nodegraph="NG_lacquerMetallicGold" output="roughness" />
    <input name="metalness" type="float" nodegraph="NG_lacquerMetallicGold" output="metalness" />
    <input name="normal" type="vector3" nodegraph="NG_lacquerMetallicGold" output="normal" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="coat" type="float" value="0.9" />
    <input name="coat_roughness" type="float" value="0.08" />
    <input name="coat_normal" type="vector3" nodegraph="NG_lacquerMetallicGold" output="normal" />
    <input name="specular_anisotropy" type="float" value="0" />
    <input name="sheen" type="float" value="0" />
  </standard_surface>
  <surfacematerial name="M_lacquerMetallicGold" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_lacquerMetallicGold" /></surfacematerial>
</materialx>
