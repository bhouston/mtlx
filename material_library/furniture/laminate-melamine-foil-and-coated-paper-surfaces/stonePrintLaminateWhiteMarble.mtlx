<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- White laminate with soft gray printed marble veining and a smooth satin resin surface. -->
  <!-- UV 0..1 = 1 metre. Height output is in metres. Clean new finish; no wear. -->
  <!-- Scales: growth bands 11-18 mm; pores 0.83 mm across / 5.6 mm along; end-grain fiber clusters 1.5 mm; rays 10 x 4.5 mm, sparse 10 percent pale modulation. -->
  <!-- End grain rings 5.6 mm; plywood plies 1.9 mm; cork cells 2.4-11 mm; polymer texture 1.8-5.6 mm. -->
  <!-- Relief: wood pores 1-45 micrometres by finish; cork 75 micrometres; polymer 1-45 micrometres. -->
  <nodegraph name="NG_stonePrintLaminateWhiteMarble">
    <texcoord name="uv" type="vector2"></texcoord>
    <constant name="n7" type="float"><input name="value" type="float" value="1" /></constant>
    <multiply name="n8" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="3, 12" /></multiply>
    <add name="n9" type="vector2"><input name="in1" type="vector2" nodename="n8" /><input name="in2" type="vector2" value="3.17, 7.43" /></add>
    <fractal2d name="n10" type="float"><input name="texcoord" type="vector2" nodename="n9" /><input name="amplitude" type="float" value="1" /><input name="octaves" type="integer" value="3" /></fractal2d>
    <absval name="n11" type="float"><input name="in" type="float" nodename="n10" /></absval>
    <smoothstep name="n12" type="float"><input name="in" type="float" nodename="n11" /><input name="low" type="float" value="0.025" /><input name="high" type="float" value="0.1" /></smoothstep>
    <subtract name="n13" type="float"><input name="in1" type="float" nodename="n7" /><input name="in2" type="float" nodename="n12" /></subtract>
    <mix name="n14" type="color3"><input name="bg" type="color3" value="0.76, 0.76, 0.76" /><input name="fg" type="color3" value="0.22, 0.23, 0.24" /><input name="mix" type="float" nodename="n13" /></mix>
    <constant name="n15" type="float"><input name="value" type="float" value="0.38" /></constant>
    <constant name="n16" type="float"><input name="value" type="float" value="0" /></constant>
    <add name="height_m" type="float"><input name="in1" type="float" nodename="n16" /><input name="in2" type="float" value="0" /></add>
    <multiply name="n17" type="float"><input name="in1" type="float" nodename="height_m" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="n18" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="n19" type="vector3"><input name="in" type="float" nodename="n17" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="n18" /></heighttonormal>
    <normalmap name="n20" type="vector3"><input name="in" type="vector3" nodename="n19" /></normalmap>
    <constant name="n21" type="float"><input name="value" type="float" value="0" /></constant>
    <output name="base_color" type="color3" nodename="n14" />
    <output name="roughness" type="float" nodename="n15" />
    <output name="metalness" type="float" nodename="n21" />
    <output name="normal" type="vector3" nodename="n20" />
    <output name="height" type="float" nodename="height_m" />
  </nodegraph>
  <standard_surface name="SR_stonePrintLaminateWhiteMarble" type="surfaceshader">
    <input name="base" type="float" value="1" />
    <input name="base_color" type="color3" nodegraph="NG_stonePrintLaminateWhiteMarble" output="base_color" />
    <input name="specular_roughness" type="float" nodegraph="NG_stonePrintLaminateWhiteMarble" output="roughness" />
    <input name="metalness" type="float" nodegraph="NG_stonePrintLaminateWhiteMarble" output="metalness" />
    <input name="normal" type="vector3" nodegraph="NG_stonePrintLaminateWhiteMarble" output="normal" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="coat" type="float" value="0" />
    <input name="coat_roughness" type="float" value="0.3" />
    <input name="coat_normal" type="vector3" nodegraph="NG_stonePrintLaminateWhiteMarble" output="normal" />
    <input name="specular_anisotropy" type="float" value="0" />
    <input name="sheen" type="float" value="0" />
  </standard_surface>
  <surfacematerial name="M_stonePrintLaminateWhiteMarble" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_stonePrintLaminateWhiteMarble" /></surfacematerial>
</materialx>
