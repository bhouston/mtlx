<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- neutral white mineral plaster; subtle powdery microtexture and diffuse matte scattering. -->
  <!-- Clean newly manufactured surface. UV 0..1 = 1 metre; height in metres. Recipe: mineralMottle. -->
  <nodegraph name="NG_plasterSmoothWhite">
    <texcoord name="uv" type="vector2"></texcoord>
    <multiply name="multiply_7" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="7" /></multiply>
    <add name="add_8" type="vector2"><input name="in1" type="vector2" nodename="multiply_7" /><input name="in2" type="vector2" value="13.37, 7.91" /></add>
    <noise2d name="noise2d_9" type="float"><input name="texcoord" type="vector2" nodename="add_8" /><input name="amplitude" type="float" value="0.6" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <mix name="mix_10" type="color3"><input name="bg" type="color3" value="0.6688000000000001, 0.6688000000000001, 0.6512" /><input name="fg" type="color3" value="0.8208000000000001, 0.8208000000000001, 0.7992" /><input name="mix" type="float" nodename="noise2d_9" /></mix>
    <multiply name="multiply_11" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="45" /></multiply>
    <add name="add_12" type="vector2"><input name="in1" type="vector2" nodename="multiply_11" /><input name="in2" type="vector2" value="13.37, 7.91" /></add>
    <noise2d name="noise2d_13" type="float"><input name="texcoord" type="vector2" nodename="add_12" /><input name="amplitude" type="float" value="0.000018" /><input name="pivot" type="float" value="0" /></noise2d>
    <multiply name="multiply_14" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="450" /></multiply>
    <add name="add_15" type="vector2"><input name="in1" type="vector2" nodename="multiply_14" /><input name="in2" type="vector2" value="13.37, 7.91" /></add>
    <noise2d name="noise2d_16" type="float"><input name="texcoord" type="vector2" nodename="add_15" /><input name="amplitude" type="float" value="0.000012" /><input name="pivot" type="float" value="0" /></noise2d>
    <add name="add_17" type="float"><input name="in1" type="float" nodename="noise2d_13" /><input name="in2" type="float" nodename="noise2d_16" /></add>
    <subtract name="subtract_18" type="float"><input name="in1" type="float" nodename="noise2d_9" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="multiply_19" type="float"><input name="in1" type="float" nodename="subtract_18" /><input name="in2" type="float" value="0.08" /></multiply>
    <add name="add_20" type="float"><input name="in1" type="float" value="0.79" /><input name="in2" type="float" nodename="multiply_19" /></add>
    <clamp name="clamp_21" type="float"><input name="in" type="float" nodename="add_20" /><input name="low" type="float" value="0.025" /><input name="high" type="float" value="0.98" /></clamp>
    <multiply name="multiply_22" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="multiply_23" type="float"><input name="in1" type="float" nodename="add_17" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="heighttonormal_24" type="vector3"><input name="in" type="float" nodename="multiply_23" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="multiply_22" /></heighttonormal>
    <normalmap name="normalmap_25" type="vector3"><input name="in" type="vector3" nodename="heighttonormal_24" /></normalmap>
    <constant name="constant_26" type="float"><input name="value" type="float" value="0" /></constant>
    <output name="base_color" type="color3" nodename="mix_10" />
    <output name="specular_roughness" type="float" nodename="clamp_21" />
    <output name="metalness" type="float" nodename="constant_26" />
    <output name="normal" type="vector3" nodename="normalmap_25" />
    <output name="height" type="float" nodename="add_17" />
  </nodegraph>
  <standard_surface name="SR_plasterSmoothWhite" type="surfaceshader">
    <input name="base" type="float" value="1" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_anisotropy" type="float" value="0" />
    <input name="base_color" type="color3" nodegraph="NG_plasterSmoothWhite" output="base_color" />
    <input name="specular_roughness" type="float" nodegraph="NG_plasterSmoothWhite" output="specular_roughness" />
    <input name="metalness" type="float" nodegraph="NG_plasterSmoothWhite" output="metalness" />
    <input name="normal" type="vector3" nodegraph="NG_plasterSmoothWhite" output="normal" />
  </standard_surface>
  <surfacematerial name="M_plasterSmoothWhite" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_plasterSmoothWhite" /></surfacematerial>
</materialx>
