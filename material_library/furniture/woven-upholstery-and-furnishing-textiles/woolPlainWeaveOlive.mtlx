    <multiply name="multiply_16" type="float"><input name="in1" type="float" nodename="sin_15" /><input name="in2" type="float" value="0.5" /></multiply>
    <add name="add_17" type="float"><input name="in1" type="float" nodename="multiply_16" /><input name="in2" type="float" value="0.5" /></add>
