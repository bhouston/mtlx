    <mix name="mix_39" type="float"><input name="bg" type="float" value="0.96" /><input name="fg" type="float" value="1.01" /><input name="mix" type="float" nodename="mix_38" /></mix>
    <multiply name="multiply_40" type="color3"><input name="in1" type="color3" value="0.19, 0.2, 0.067" /><input name="in2" type="color3" value="1, 1, 1" /></multiply>
    <mix name="mix_41" type="float"><input name="bg" type="float" value="0.97" /><input name="fg" type="float" value="1.03" /><input name="mix" type="float" nodename="noise2d_6" /></mix>
    <multiply name="multiply_42" type="float"><input name="in1" type="float" nodename="mix_39" /><input name="in2" type="float" nodename="mix_41" /></multiply>
    <multiply name="base_color" type="color3"><input name="in1" type="color3" nodename="multiply_40" /><input name="in2" type="float" nodename="multiply_42" /></multiply>
