<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Clean new furniture sample. UV 0..1 = 1 metre; heights in metres. -->
  <!-- yellow-green olive wool plain weave; fine dense weave with soft fuzzy fibers and broad diffuse highlights. -->
  <!-- weave: pitch 0.00055 m, relief 0.000004 m. Microfiber detail is statistical roughness below resolved yarn scale. -->
  <nodegraph name="NG_woolPlainWeaveOlive">
    <texcoord name="uv" type="vector2"></texcoord>
    <multiply name="multiply_1" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="900, 900" /></multiply>
