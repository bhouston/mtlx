<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- beige boucle upholstery textile; dense curled-yarn surface texture with soft diffuse color and restrained grazing-angle sheen. -->
  <!-- Factory-new appearance target; colors are linear Rec.709 artistic reflectances, not measured OEM data.  -->
  <nodegraph name="NG_decorativeBoucleBeige">
    <!-- UV 0..1 is exactly one metre; all height values below are metres. boucle: frequencies 420 × 420 cycles/metre; relief amplitude 0.00009 m. -->
    <texcoord name="uv" type="vector2"></texcoord>
    <multiply name="feature_uv" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="420, 420" /></multiply>
    <noise2d name="micro" type="float"><input name="texcoord" type="vector2" nodename="feature_uv" /><input name="amplitude" type="float" value="0.45" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <!-- Curled boucle yarn: irregular 1.3–1.8 mm loops at 2.38 mm spacing, rounded ~0.7 mm yarn width, 90 micrometre relief. -->
    <worleynoise2d name="loop_distance" type="float"><input name="texcoord" type="vector2" nodename="feature_uv" /><input name="jitter" type="float" value="0.75" /></worleynoise2d>
    <multiply name="loop_radius_jitter" type="float"><input name="in1" type="float" nodename="micro" /><input name="in2" type="float" value="0.1" /></multiply>
    <add name="loop_radius" type="float"><input name="in1" type="float" nodename="loop_radius_jitter" /><input name="in2" type="float" value="0.26" /></add>
    <subtract name="loop_centerline" type="float"><input name="in1" type="float" nodename="loop_distance" /><input name="in2" type="float" nodename="loop_radius" /></subtract>
    <absval name="yarn_distance" type="float"><input name="in" type="float" nodename="loop_centerline" /></absval>
    <smoothstep name="loop_gap" type="float"><input name="in" type="float" nodename="yarn_distance" /><input name="low" type="float" value="0.025" /><input name="high" type="float" value="0.2" /></smoothstep>
    <subtract name="plush_loop" type="float"><input name="in1" type="float" value="1" /><input name="in2" type="float" nodename="loop_gap" /></subtract>
    <multiply name="micro_relief" type="float"><input name="in1" type="float" nodename="micro" /><input name="in2" type="float" value="0.000013500000000000001" /></multiply>
    <multiply name="structure_relief" type="float"><input name="in1" type="float" nodename="plush_loop" /><input name="in2" type="float" value="0.00009" /></multiply>
    <add name="height" type="float"><input name="in1" type="float" nodename="structure_relief" /><input name="in2" type="float" nodename="micro_relief" /></add>
    <mix name="base_color" type="color3"><input name="bg" type="color3" value="0.3496, 0.26599999999999996, 0.1596" /><input name="fg" type="color3" value="0.5704, 0.434, 0.26039999999999996" /><input name="mix" type="float" nodename="plush_loop" /></mix>
    <multiply name="roughness_detail" type="float"><input name="in1" type="float" nodename="plush_loop" /><input name="in2" type="float" value="0.04" /></multiply>
    <add name="roughness" type="float"><input name="in1" type="float" nodename="roughness_detail" /><input name="in2" type="float" value="0.9199999999999999" /></add>
    <constant name="metalness" type="float"><input name="value" type="float" value="0" /></constant>
    <multiply name="uv_mm" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="height_mm" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="normal_tangent" type="vector3"><input name="in" type="float" nodename="height_mm" /><input name="texcoord" type="vector2" nodename="uv_mm" /><input name="scale" type="float" value="16" /></heighttonormal>
    <normalmap name="normal_world" type="vector3"><input name="in" type="vector3" nodename="normal_tangent" /></normalmap>
    <constant name="specular" type="float"><input name="value" type="float" value="0.2" /></constant>
    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="specular_roughness_out" type="float" nodename="roughness" />
    <output name="metalness_out" type="float" nodename="metalness" />
    <output name="normal_out" type="vector3" nodename="normal_world" />
    <output name="specular_out" type="float" nodename="specular" />
  </nodegraph>
  <standard_surface name="SR_decorativeBoucleBeige" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_decorativeBoucleBeige" output="base_color_out" />
    <input name="specular_roughness" type="float" nodegraph="NG_decorativeBoucleBeige" output="specular_roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_decorativeBoucleBeige" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_decorativeBoucleBeige" output="normal_out" />
    <input name="specular" type="float" nodegraph="NG_decorativeBoucleBeige" output="specular_out" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="sheen" type="float" value="0.45" />
    <input name="sheen_color" type="color3" value="0.6782329983125268, 0.5916079783099616, 0.458257569495584" />
    <input name="sheen_roughness" type="float" value="0.6" />
  </standard_surface>
  <surfacematerial name="M_decorativeBoucleBeige" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_decorativeBoucleBeige" /></surfacematerial>
</materialx>
