<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- New oil-impregnated sintered bronze; warm bronze metallic body with fine porosity and a restrained thin oil sheen. -->
  <!-- Factory-new appearance target; colors are linear Rec.709 artistic reflectances, not measured OEM data.  -->
  <nodegraph name="NG_oilImpregnatedBronze">
    <!-- UV 0..1 is exactly one metre; all height values below are metres. granule: frequencies 1000 × 1000 cycles/metre; relief amplitude 0.000009 m. -->
    <texcoord name="uv" type="vector2"></texcoord>
    <multiply name="feature_uv" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="1000, 1000" /></multiply>
    <noise2d name="micro" type="float"><input name="texcoord" type="vector2" nodename="feature_uv" /><input name="amplitude" type="float" value="0.45" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <multiply name="height" type="float"><input name="in1" type="float" nodename="micro" /><input name="in2" type="float" value="0.000009" /></multiply>
    <mix name="base_color" type="color3"><input name="bg" type="color3" value="0.48400000000000004, 0.2816, 0.1144" /><input name="fg" type="color3" value="0.6160000000000001, 0.35840000000000005, 0.1456" /><input name="mix" type="float" nodename="micro" /></mix>
    <multiply name="roughness_detail" type="float"><input name="in1" type="float" nodename="micro" /><input name="in2" type="float" value="0.0256" /></multiply>
    <add name="roughness" type="float"><input name="in1" type="float" nodename="roughness_detail" /><input name="in2" type="float" value="0.3" /></add>
    <constant name="metalness" type="float"><input name="value" type="float" value="1" /></constant>
    <multiply name="uv_mm" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="height_mm" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="normal_tangent" type="vector3"><input name="in" type="float" nodename="height_mm" /><input name="texcoord" type="vector2" nodename="uv_mm" /><input name="scale" type="float" value="16" /></heighttonormal>
    <normalmap name="normal_world" type="vector3"><input name="in" type="vector3" nodename="normal_tangent" /></normalmap>
    <constant name="specular" type="float"><input name="value" type="float" value="0.5" /></constant>
    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="specular_roughness_out" type="float" nodename="roughness" />
    <output name="metalness_out" type="float" nodename="metalness" />
    <output name="normal_out" type="vector3" nodename="normal_world" />
    <output name="specular_out" type="float" nodename="specular" />
  </nodegraph>
  <standard_surface name="SR_oilImpregnatedBronze" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_oilImpregnatedBronze" output="base_color_out" />
    <input name="specular_roughness" type="float" nodegraph="NG_oilImpregnatedBronze" output="specular_roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_oilImpregnatedBronze" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_oilImpregnatedBronze" output="normal_out" />
    <input name="specular" type="float" nodegraph="NG_oilImpregnatedBronze" output="specular_out" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="coat" type="float" value="0.65" />
    <input name="coat_roughness" type="float" value="0.08" />
  </standard_surface>
  <surfacematerial name="M_oilImpregnatedBronze" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_oilImpregnatedBronze" /></surfacematerial>
</materialx>
