<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Fresh red synthetic grease appearance; translucent-to-opaque red waxy paste with smooth glossy highlights. -->
  <!-- Factory-new appearance target; colors are linear Rec.709 artistic reflectances, not measured OEM data.  -->
  <nodegraph name="NG_greaseSyntheticRed">
    <!-- UV 0..1 is exactly one metre; all height values below are metres. skin: frequencies 850 × 850 cycles/metre; relief amplitude 0.000003 m. -->
    <texcoord name="uv" type="vector2"></texcoord>
    <multiply name="feature_uv" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="850, 850" /></multiply>
    <noise2d name="micro" type="float"><input name="texcoord" type="vector2" nodename="feature_uv" /><input name="amplitude" type="float" value="0.45" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <multiply name="height" type="float"><input name="in1" type="float" nodename="micro" /><input name="in2" type="float" value="0.000003" /></multiply>
    <mix name="base_color" type="color3"><input name="bg" type="color3" value="0.5319, 0.01182, 0.01773" /><input name="fg" type="color3" value="0.5481, 0.01218, 0.018269999999999998" /><input name="mix" type="float" nodename="micro" /></mix>
    <multiply name="roughness_detail" type="float"><input name="in1" type="float" nodename="micro" /><input name="in2" type="float" value="0.0184" /></multiply>
    <add name="roughness" type="float"><input name="in1" type="float" nodename="roughness_detail" /><input name="in2" type="float" value="0.21000000000000002" /></add>
    <constant name="metalness" type="float"><input name="value" type="float" value="0" /></constant>
    <multiply name="uv_mm" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="height_mm" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="normal_tangent" type="vector3"><input name="in" type="float" nodename="height_mm" /><input name="texcoord" type="vector2" nodename="uv_mm" /><input name="scale" type="float" value="16" /></heighttonormal>
    <normalmap name="normal_world" type="vector3"><input name="in" type="vector3" nodename="normal_tangent" /></normalmap>
    <constant name="specular" type="float"><input name="value" type="float" value="0.5" /></constant>
    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="specular_roughness_out" type="float" nodename="roughness" />
    <output name="metalness_out" type="float" nodename="metalness" />
    <output name="normal_out" type="vector3" nodename="normal_world" />
    <output name="specular_out" type="float" nodename="specular" />
  </nodegraph>
  <standard_surface name="SR_greaseSyntheticRed" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_greaseSyntheticRed" output="base_color_out" />
    <input name="specular_roughness" type="float" nodegraph="NG_greaseSyntheticRed" output="specular_roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_greaseSyntheticRed" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_greaseSyntheticRed" output="normal_out" />
    <input name="specular" type="float" nodegraph="NG_greaseSyntheticRed" output="specular_out" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="coat" type="float" value="0.25" />
    <input name="coat_roughness" type="float" value="0.08" />
    <input name="transmission" type="float" value="0.25" />
    <input name="transmission_color" type="color3" value="0.7393168228664094, 0.19530372500589893, 0.21672274842548905" />
    <input name="transmission_depth" type="float" value="0.004" />
    <input name="transmission_scatter" type="color3" value="0.4, 0.4, 0.4" />
  </standard_surface>
  <surfacematerial name="M_greaseSyntheticRed" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_greaseSyntheticRed" /></surfacematerial>
</materialx>
