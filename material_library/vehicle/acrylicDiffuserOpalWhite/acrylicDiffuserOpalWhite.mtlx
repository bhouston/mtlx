<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- opal white translucent acrylic diffuser; soft bulk scattering and low-to-medium gloss, with no self-emission. -->
  <!-- Volume absorption reference distance 0.005 m. Supply physical closed mesh thickness in metres; opacity remains one. Scattering needs renderer support. -->
  <nodegraph name="NG_acrylicDiffuserOpalWhite">
    <!-- Real-world scale: texcoord 0 to 1 = one metre. All height values below are metres. Factory-new process texture only. -->
    <texcoord name="uv" type="vector2"></texcoord>
    <!-- Finish microstructure: coordinate frequencies 450, 450 per metre; relief amplitude 5e-06 m, correlated color and roughness. -->
    <multiply name="finish_noise_coordinates" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="450, 450" /></multiply>
    <fractal2d name="finish_noise" type="float"><input name="texcoord" type="vector2" nodename="finish_noise_coordinates" /><input name="octaves" type="integer" value="2" /><input name="amplitude" type="float" value="1" /></fractal2d>
    <multiply name="finish_gain" type="float"><input name="in1" type="float" nodename="finish_noise" /><input name="in2" type="float" value="0.45" /></multiply>
    <add name="finish_remap" type="float"><input name="in1" type="float" nodename="finish_gain" /><input name="in2" type="float" value="0.5" /></add>
    <clamp name="finish_mask" type="float"><input name="in" type="float" nodename="finish_remap" /><input name="low" type="float" value="0" /><input name="high" type="float" value="1" /></clamp>
    <multiply name="height" type="float"><input name="in1" type="float" nodename="finish_noise" /><input name="in2" type="float" value="5e-06" /></multiply>
    <mix name="base_color" type="color3"><input name="bg" type="color3" value="0.76615, 0.76615, 0.76615" /><input name="fg" type="color3" value="0.77385, 0.77385, 0.77385" /><input name="mix" type="float" nodename="finish_mask" /></mix>
    <mix name="roughness" type="float"><input name="bg" type="float" value="0.40499999999999997" /><input name="fg" type="float" value="0.455" /><input name="mix" type="float" nodename="finish_mask" /></mix>
    <constant name="metalness" type="float"><input name="value" type="float" value="0.0" /></constant>
    <multiply name="uv_mm" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000.0" /></multiply>
    <multiply name="height_mm" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" value="1000.0" /></multiply>
    <heighttonormal name="n_tangent" type="vector3"><input name="in" type="float" nodename="height_mm" /><input name="scale" type="float" value="16.0" /><input name="texcoord" type="vector2" nodename="uv_mm" /></heighttonormal>
    <normalmap name="n_world" type="vector3"><input name="in" type="vector3" nodename="n_tangent" /></normalmap>
    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="roughness_out" type="float" nodename="roughness" />
    <output name="metalness_out" type="float" nodename="metalness" />
    <output name="normal_out" type="vector3" nodename="n_world" />
  </nodegraph>
  <standard_surface name="SR_acrylicDiffuserOpalWhite" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_acrylicDiffuserOpalWhite" output="base_color_out" />
    <input name="specular_roughness" type="float" nodegraph="NG_acrylicDiffuserOpalWhite" output="roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_acrylicDiffuserOpalWhite" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_acrylicDiffuserOpalWhite" output="normal_out" />
    <input name="base" type="float" value="1.0" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.49" />
    <input name="specular_anisotropy" type="float" value="0.0" />
    <input name="coat" type="float" value="0.0" />
    <input name="coat_roughness" type="float" value="0.09" />
    <input name="coat_IOR" type="float" value="1.5" />
    <input name="sheen" type="float" value="0.0" />
    <input name="sheen_roughness" type="float" value="0.65" />
    <input name="transmission" type="float" value="0.88" />
    <input name="transmission_color" type="color3" value="0.77, 0.77, 0.77" />
    <input name="transmission_depth" type="float" value="0.005" />
    <input name="transmission_scatter" type="color3" value="0.7, 0.7, 0.7" />
    <input name="transmission_scatter_anisotropy" type="float" value="0.2" />
    <input name="thin_walled" type="boolean" value="false" />
  </standard_surface>
  <surfacematerial name="M_acrylicDiffuserOpalWhite" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_acrylicDiffuserOpalWhite" /></surfacematerial>
</materialx>
