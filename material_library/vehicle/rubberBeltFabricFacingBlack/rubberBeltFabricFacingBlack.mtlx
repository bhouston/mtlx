<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Black rubber-impregnated textile facing; fine woven albedo/normal texture, low gloss, and muted fiber sheen. -->
  <nodegraph name="NG_rubberBeltFabricFacingBlack">
    <!-- Real-world scale: texcoord 0 to 1 = one metre. All height values below are metres. Factory-new process texture only. -->
    <texcoord name="uv" type="vector2"></texcoord>
    <!-- Finish microstructure: coordinate frequencies 800, 800 per metre; relief amplitude 1.1e-05 m, correlated color and roughness. -->
    <multiply name="finish_noise_coordinates" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="800, 800" /></multiply>
    <fractal2d name="finish_noise" type="float"><input name="texcoord" type="vector2" nodename="finish_noise_coordinates" /><input name="octaves" type="integer" value="2" /><input name="amplitude" type="float" value="1" /></fractal2d>
    <multiply name="finish_gain" type="float"><input name="in1" type="float" nodename="finish_noise" /><input name="in2" type="float" value="0.45" /></multiply>
    <add name="finish_remap" type="float"><input name="in1" type="float" nodename="finish_gain" /><input name="in2" type="float" value="0.5" /></add>
    <clamp name="finish_mask" type="float"><input name="in" type="float" nodename="finish_remap" /><input name="low" type="float" value="0" /><input name="high" type="float" value="1" /></clamp>
    <multiply name="height" type="float"><input name="in1" type="float" nodename="finish_noise" /><input name="in2" type="float" value="1.1e-05" /></multiply>
    <!-- Printed carbon twill: 2 mm yarn pitch; rubber fabric facing: 0.8 mm yarn pitch. No geometry or stitch arrangement. -->
    <multiply name="weave_uv" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="1250, 1250" /></multiply>
    <extract name="weave_x" type="float"><input name="in" type="vector2" nodename="weave_uv" /><input name="index" type="integer" value="0" /></extract>
    <extract name="weave_y" type="float"><input name="in" type="vector2" nodename="weave_uv" /><input name="index" type="integer" value="1" /></extract>
    <floor name="weave_rows" type="float"><input name="in" type="float" nodename="weave_y" /></floor>
    <add name="weave_phase" type="float"><input name="in1" type="float" nodename="weave_x" /><input name="in2" type="float" nodename="weave_rows" /></add>
    <multiply name="weave_radians" type="float"><input name="in1" type="float" nodename="weave_phase" /><input name="in2" type="float" value="3.141592653589793" /></multiply>
    <sin name="weave_wave" type="float"><input name="in" type="float" nodename="weave_radians" /></sin>
    <multiply name="weave_contrast" type="float"><input name="in1" type="float" nodename="weave_wave" /><input name="in2" type="float" value="0.45" /></multiply>
    <add name="weave_mask" type="float"><input name="in1" type="float" nodename="weave_contrast" /><input name="in2" type="float" value="0.5" /></add>
    <multiply name="height_weave" type="float"><input name="in1" type="float" nodename="weave_mask" /><input name="in2" type="float" value="2.5e-05" /></multiply>
    <mix name="base_color" type="color3"><input name="bg" type="color3" value="0.0036, 0.0044, 0.0052" /><input name="fg" type="color3" value="0.0144, 0.0176, 0.0208" /><input name="mix" type="float" nodename="weave_mask" /></mix>
    <mix name="roughness" type="float"><input name="bg" type="float" value="0.845" /><input name="fg" type="float" value="0.895" /><input name="mix" type="float" nodename="weave_mask" /></mix>
    <constant name="metalness" type="float"><input name="value" type="float" value="0.0" /></constant>
    <multiply name="roughness_finish_detail" type="float"><input name="in1" type="float" nodename="finish_mask" /><input name="in2" type="float" value="0.008" /></multiply>
    <add name="roughness_correlated" type="float"><input name="in1" type="float" nodename="roughness" /><input name="in2" type="float" nodename="roughness_finish_detail" /></add>
    <add name="height_combined" type="float"><input name="in1" type="float" nodename="height_weave" /><input name="in2" type="float" nodename="height" /></add>
    <multiply name="uv_mm" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000.0" /></multiply>
    <multiply name="height_mm" type="float"><input name="in1" type="float" nodename="height_combined" /><input name="in2" type="float" value="1000.0" /></multiply>
    <heighttonormal name="n_tangent" type="vector3"><input name="in" type="float" nodename="height_mm" /><input name="scale" type="float" value="16.0" /><input name="texcoord" type="vector2" nodename="uv_mm" /></heighttonormal>
    <normalmap name="n_world" type="vector3"><input name="in" type="vector3" nodename="n_tangent" /></normalmap>
    <constant name="specular_weight" type="float"><input name="value" type="float" value="0.2" /></constant>
    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="roughness_out" type="float" nodename="roughness_correlated" />
    <output name="metalness_out" type="float" nodename="metalness" />
    <output name="normal_out" type="vector3" nodename="n_world" />
    <output name="specular_out" type="float" nodename="specular_weight" />
  </nodegraph>
  <standard_surface name="SR_rubberBeltFabricFacingBlack" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_rubberBeltFabricFacingBlack" output="base_color_out" />
    <input name="specular_roughness" type="float" nodegraph="NG_rubberBeltFabricFacingBlack" output="roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_rubberBeltFabricFacingBlack" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_rubberBeltFabricFacingBlack" output="normal_out" />
    <input name="base" type="float" value="1.0" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_anisotropy" type="float" value="0.0" />
    <input name="coat" type="float" value="0.0" />
    <input name="coat_roughness" type="float" value="0.09" />
    <input name="coat_IOR" type="float" value="1.5" />
    <input name="sheen" type="float" value="0.16" />
    <input name="sheen_roughness" type="float" value="0.65" />
    <input name="specular" type="float" nodegraph="NG_rubberBeltFabricFacingBlack" output="specular_out" />
  </standard_surface>
  <surfacematerial name="M_rubberBeltFabricFacingBlack" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_rubberBeltFabricFacingBlack" /></surfacematerial>
</materialx>
