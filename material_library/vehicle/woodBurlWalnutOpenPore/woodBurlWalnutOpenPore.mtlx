<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- New decorative burlWalnut veneer; rich brown with swirling burl figure and small dark eyes, thin matte-to-satin protective finish retaining visible pore texture. -->
  <!-- Real-world scale: UV 0..1 = 1 meter; height is meters. Recipe: wood; feature frequency 300 × 6 per meter; relief span 4.5e-05 m. Coated fiber and wood substrate relief stays beneath the separate smooth dielectric coat. -->
  <nodegraph name="NG_woodBurlWalnutOpenPore">
    <texcoord name="uv" type="vector2"></texcoord>
    <multiply name="tone_drift_uv" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="4, 4" /></multiply>
    <fractal2d name="tone_drift" type="float"><input name="texcoord" type="vector2" nodename="tone_drift_uv" /><input name="octaves" type="integer" value="2" /></fractal2d>
    <multiply name="grain_warp_uv" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="7, 4" /></multiply>
    <fractal2d name="grain_warp" type="float"><input name="texcoord" type="vector2" nodename="grain_warp_uv" /><input name="octaves" type="integer" value="2" /></fractal2d>
    <multiply name="grain_warp_size" type="float"><input name="in1" type="float" nodename="grain_warp" /><input name="in2" type="float" value="0.008" /></multiply>
    <combine2 name="grain_shift" type="vector2"><input name="in1" type="float" nodename="grain_warp_size" /><input name="in2" type="float" value="0" /></combine2>
    <add name="grain_distorted" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" nodename="grain_shift" /></add>
    <multiply name="grain_uv" type="vector2"><input name="in1" type="vector2" nodename="grain_distorted" /><input name="in2" type="vector2" value="300, 6" /></multiply>
    <fractal2d name="grain" type="float"><input name="texcoord" type="vector2" nodename="grain_uv" /><input name="octaves" type="integer" value="3" /></fractal2d>
    <multiply name="grain_scale" type="float"><input name="in1" type="float" nodename="grain" /><input name="in2" type="float" value="0.65" /></multiply>
    <add name="grain_center" type="float"><input name="in1" type="float" nodename="grain_scale" /><input name="in2" type="float" value="0.5" /></add>
    <multiply name="figure_warp_uv" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="13, 9" /></multiply>
    <fractal2d name="figure_warp_x" type="float"><input name="texcoord" type="vector2" nodename="figure_warp_uv" /><input name="octaves" type="integer" value="2" /></fractal2d>
    <add name="figure_warp_y_uv" type="vector2"><input name="in1" type="vector2" nodename="figure_warp_uv" /><input name="in2" type="vector2" value="37.31, 19.73" /></add>
    <fractal2d name="figure_warp_y" type="float"><input name="texcoord" type="vector2" nodename="figure_warp_y_uv" /><input name="octaves" type="integer" value="2" /></fractal2d>
    <combine2 name="figure_warp_vector" type="vector2"><input name="in1" type="float" nodename="figure_warp_x" /><input name="in2" type="float" nodename="figure_warp_y" /></combine2>
    <multiply name="figure_warp_size" type="vector2"><input name="in1" type="vector2" nodename="figure_warp_vector" /><input name="in2" type="float" value="0.035" /></multiply>
    <add name="figure_frame" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" nodename="figure_warp_size" /></add>
    <multiply name="figure_fiber_uv" type="vector2"><input name="in1" type="vector2" nodename="figure_frame" /><input name="in2" type="vector2" value="170, 18" /></multiply>
    <fractal2d name="figure_fibers" type="float"><input name="texcoord" type="vector2" nodename="figure_fiber_uv" /><input name="octaves" type="integer" value="2" /></fractal2d>
    <multiply name="figure_contrast" type="float"><input name="in1" type="float" nodename="figure_fibers" /><input name="in2" type="float" value="0.75" /></multiply>
    <add name="figure_center" type="float"><input name="in1" type="float" nodename="figure_contrast" /><input name="in2" type="float" value="0.5" /></add>
    <multiply name="eyes_uv" type="vector2"><input name="in1" type="vector2" nodename="figure_frame" /><input name="in2" type="vector2" value="42, 31" /></multiply>
    <worleynoise2d name="eyes" type="float"><input name="texcoord" type="vector2" nodename="eyes_uv" /><input name="jitter" type="float" value="0.72" /><input name="style" type="integer" value="0" /></worleynoise2d>
    <smoothstep name="eye_profile" type="float"><input name="in" type="float" nodename="eyes" /><input name="low" type="float" value="0.045" /><input name="high" type="float" value="0.19" /></smoothstep>
    <mix name="eye_darkening" type="float"><input name="bg" type="float" value="0.48" /><input name="fg" type="float" value="1" /><input name="mix" type="float" nodename="eye_profile" /></mix>
    <multiply name="figure_with_eyes" type="float"><input name="in1" type="float" nodename="figure_center" /><input name="in2" type="float" nodename="eye_darkening" /></multiply>
    <mix name="figured_grain" type="float"><input name="bg" type="float" nodename="grain_center" /><input name="fg" type="float" nodename="figure_with_eyes" /><input name="mix" type="float" value="0.85" /></mix>
    <mix name="base_color" type="color3"><input name="bg" type="color3" value="0.0832, 0.0338, 0.01196" /><input name="fg" type="color3" value="0.2368, 0.0962, 0.03404" /><input name="mix" type="float" nodename="figured_grain" /></mix>
    <multiply name="drift_amount" type="float"><input name="in1" type="float" nodename="tone_drift" /><input name="in2" type="float" value="0.025" /></multiply>
    <add name="drift_gain" type="float"><input name="in1" type="float" nodename="drift_amount" /><input name="in2" type="float" value="1" /></add>
    <multiply name="body_color" type="color3"><input name="in1" type="color3" nodename="base_color" /><input name="in2" type="float" nodename="drift_gain" /></multiply>
    <subtract name="relief_center" type="float"><input name="in1" type="float" nodename="figured_grain" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="height" type="float"><input name="in1" type="float" nodename="relief_center" /><input name="in2" type="float" value="4.5e-05" /></multiply>
    <subtract name="roughness_center" type="float"><input name="in1" type="float" nodename="figured_grain" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="roughness_variation" type="float"><input name="in1" type="float" nodename="roughness_center" /><input name="in2" type="float" value="-0.072" /></multiply>
    <add name="roughness" type="float"><input name="in1" type="float" value="0.48" /><input name="in2" type="float" nodename="roughness_variation" /></add>
    <multiply name="uv_mm" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="height_mm" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="n_tangent" type="vector3"><input name="in" type="float" nodename="height_mm" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="uv_mm" /></heighttonormal>
    <normalmap name="n_world" type="vector3"><input name="in" type="vector3" nodename="n_tangent" /></normalmap>
    <constant name="metalness" type="float"><input name="value" type="float" value="0" /></constant>
    <constant name="specular" type="float"><input name="value" type="float" value="0.5" /></constant>
    <output name="base_color_out" type="color3" nodename="body_color" />
    <output name="roughness_out" type="float" nodename="roughness" />
    <output name="normal_out" type="vector3" nodename="n_world" />
    <output name="metalness_out" type="float" nodename="metalness" />
    <output name="specular_out" type="float" nodename="specular" />
  </nodegraph>
  <standard_surface name="SR_woodBurlWalnutOpenPore" type="surfaceshader"><input name="base" type="float" value="1" /><input name="specular_IOR" type="float" value="1.5" /><input name="sheen" type="float" value="0" /><input name="sheen_roughness" type="float" value="0.7" /><input name="specular_anisotropy" type="float" value="0" /><input name="coat" type="float" value="0.12" /><input name="coat_roughness" type="float" value="0.45" /><input name="base_color" type="color3" nodegraph="NG_woodBurlWalnutOpenPore" output="base_color_out" /><input name="specular_roughness" type="float" nodegraph="NG_woodBurlWalnutOpenPore" output="roughness_out" /><input name="normal" type="vector3" nodegraph="NG_woodBurlWalnutOpenPore" output="normal_out" /><input name="metalness" type="float" nodegraph="NG_woodBurlWalnutOpenPore" output="metalness_out" /><input name="specular" type="float" nodegraph="NG_woodBurlWalnutOpenPore" output="specular_out" /></standard_surface>
  <surfacematerial name="M_woodBurlWalnutOpenPore" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_woodBurlWalnutOpenPore" /></surfacematerial>
</materialx>
