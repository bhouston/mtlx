<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- brown pigmented leather with pronounced pebbled grain; soft satin protective finish, fine pores, and low-contrast grain color variation. -->
  <!-- Real-world scale: UV 0..1 = 1 meter; height is meters. Recipe: leather; feature frequency 350 × 350 per meter; relief span 0.0001 m. Coated fiber and wood substrate relief stays beneath the separate smooth dielectric coat. -->
  <nodegraph name="NG_leatherPigmentedPebbledBrown">
    <texcoord name="uv" type="vector2"></texcoord>
    <multiply name="tone_drift_uv" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="4, 4" /></multiply>
    <fractal2d name="tone_drift" type="float"><input name="texcoord" type="vector2" nodename="tone_drift_uv" /><input name="octaves" type="integer" value="2" /></fractal2d>
    <multiply name="cell_uv" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="350, 350" /></multiply>
    <worleynoise2d name="pebble_pair" type="vector2"><input name="texcoord" type="vector2" nodename="cell_uv" /><input name="jitter" type="float" value="0.72" /><input name="style" type="integer" value="0" /></worleynoise2d>
    <dotproduct name="pebble_boundary" type="float"><input name="in1" type="vector2" nodename="pebble_pair" /><input name="in2" type="vector2" value="-1, 1" /></dotproduct>
    <smoothstep name="pebble_crests" type="float"><input name="in" type="float" nodename="pebble_boundary" /><input name="low" type="float" value="0.025" /><input name="high" type="float" value="0.24" /></smoothstep>
    <mix name="base_color" type="color3"><input name="bg" type="color3" value="0.117, 0.0558, 0.0252" /><input name="fg" type="color3" value="0.143, 0.0682, 0.0308" /><input name="mix" type="float" nodename="pebble_crests" /></mix>
    <multiply name="drift_amount" type="float"><input name="in1" type="float" nodename="tone_drift" /><input name="in2" type="float" value="0.025" /></multiply>
    <add name="drift_gain" type="float"><input name="in1" type="float" nodename="drift_amount" /><input name="in2" type="float" value="1" /></add>
    <multiply name="body_color" type="color3"><input name="in1" type="color3" nodename="base_color" /><input name="in2" type="float" nodename="drift_gain" /></multiply>
    <subtract name="relief_center" type="float"><input name="in1" type="float" nodename="pebble_crests" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="height" type="float"><input name="in1" type="float" nodename="relief_center" /><input name="in2" type="float" value="0.0001" /></multiply>
    <multiply name="fine_pore_frequency" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="1700, 1700" /></multiply>
    <add name="fine_pore_uv" type="vector2"><input name="in1" type="vector2" nodename="fine_pore_frequency" /><input name="in2" type="vector2" value="13.47, 31.21" /></add>
    <worleynoise2d name="fine_pores" type="float"><input name="texcoord" type="vector2" nodename="fine_pore_uv" /><input name="jitter" type="float" value="0.7" /><input name="style" type="integer" value="0" /></worleynoise2d>
    <smoothstep name="fine_pore_profile" type="float"><input name="in" type="float" nodename="fine_pores" /><input name="low" type="float" value="0.035" /><input name="high" type="float" value="0.12" /></smoothstep>
    <subtract name="fine_pore_center" type="float"><input name="in1" type="float" nodename="fine_pore_profile" /><input name="in2" type="float" value="1" /></subtract>
    <multiply name="fine_pore_depth" type="float"><input name="in1" type="float" nodename="fine_pore_center" /><input name="in2" type="float" value="6e-06" /></multiply>
    <add name="pebbled_height" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" nodename="fine_pore_depth" /></add>
    <subtract name="roughness_center" type="float"><input name="in1" type="float" nodename="pebble_crests" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="roughness_variation" type="float"><input name="in1" type="float" nodename="roughness_center" /><input name="in2" type="float" value="-0.072" /></multiply>
    <add name="roughness" type="float"><input name="in1" type="float" value="0.48" /><input name="in2" type="float" nodename="roughness_variation" /></add>
    <multiply name="uv_mm" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="height_mm" type="float"><input name="in1" type="float" nodename="pebbled_height" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="n_tangent" type="vector3"><input name="in" type="float" nodename="height_mm" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="uv_mm" /></heighttonormal>
    <normalmap name="n_world" type="vector3"><input name="in" type="vector3" nodename="n_tangent" /></normalmap>
    <constant name="metalness" type="float"><input name="value" type="float" value="0" /></constant>
    <constant name="specular" type="float"><input name="value" type="float" value="0.5" /></constant>
    <output name="base_color_out" type="color3" nodename="body_color" />
    <output name="roughness_out" type="float" nodename="roughness" />
    <output name="normal_out" type="vector3" nodename="n_world" />
    <output name="metalness_out" type="float" nodename="metalness" />
    <output name="specular_out" type="float" nodename="specular" />
  </nodegraph>
  <standard_surface name="SR_leatherPigmentedPebbledBrown" type="surfaceshader"><input name="base" type="float" value="1" /><input name="specular_IOR" type="float" value="1.5" /><input name="sheen" type="float" value="0" /><input name="sheen_roughness" type="float" value="0.7" /><input name="specular_anisotropy" type="float" value="0" /><input name="coat" type="float" value="0" /><input name="coat_roughness" type="float" value="0.15" /><input name="base_color" type="color3" nodegraph="NG_leatherPigmentedPebbledBrown" output="base_color_out" /><input name="specular_roughness" type="float" nodegraph="NG_leatherPigmentedPebbledBrown" output="roughness_out" /><input name="normal" type="vector3" nodegraph="NG_leatherPigmentedPebbledBrown" output="normal_out" /><input name="metalness" type="float" nodegraph="NG_leatherPigmentedPebbledBrown" output="metalness_out" /><input name="specular" type="float" nodegraph="NG_leatherPigmentedPebbledBrown" output="specular_out" /></standard_surface>
  <surfacematerial name="M_leatherPigmentedPebbledBrown" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_leatherPigmentedPebbledBrown" /></surfacematerial>
</materialx>
