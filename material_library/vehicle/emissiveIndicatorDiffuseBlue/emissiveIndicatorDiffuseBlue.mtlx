<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- blue diffuse luminous polymer material; soft scattering emission with a low-gloss surface; emitted intensity is a separately controlled parameter. -->
  <!-- Factory-new appearance target; colors are linear Rec.709 artistic reflectances, not measured OEM data.  -->
  <nodegraph name="NG_emissiveIndicatorDiffuseBlue">
    <!-- UV 0..1 is exactly one metre; all height values below are metres. skin: frequencies 850 × 850 cycles/metre; relief amplitude 0 m. -->
    <texcoord name="uv" type="vector2"></texcoord>
    <multiply name="feature_uv" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="850, 850" /></multiply>
    <noise2d name="micro" type="float"><input name="texcoord" type="vector2" nodename="feature_uv" /><input name="amplitude" type="float" value="0.45" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <multiply name="height" type="float"><input name="in1" type="float" nodename="micro" /><input name="in2" type="float" value="0" /></multiply>
    <mix name="base_color" type="color3"><input name="bg" type="color3" value="0.012, 0.075, 0.37" /><input name="fg" type="color3" value="0.012, 0.075, 0.37" /><input name="mix" type="float" nodename="micro" /></mix>
    <multiply name="roughness_detail" type="float"><input name="in1" type="float" nodename="micro" /><input name="in2" type="float" value="0.04" /></multiply>
    <add name="roughness" type="float"><input name="in1" type="float" nodename="roughness_detail" /><input name="in2" type="float" value="0.63" /></add>
    <constant name="metalness" type="float"><input name="value" type="float" value="0" /></constant>
    <multiply name="uv_mm" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="height_mm" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="normal_tangent" type="vector3"><input name="in" type="float" nodename="height_mm" /><input name="texcoord" type="vector2" nodename="uv_mm" /><input name="scale" type="float" value="16" /></heighttonormal>
    <normalmap name="normal_world" type="vector3"><input name="in" type="vector3" nodename="normal_tangent" /></normalmap>
    <constant name="specular" type="float"><input name="value" type="float" value="0.5" /></constant>
    <!-- Operating state 1 = powered, 0 = off. Emission intensity is scene-linear relative radiance, requiring renderer luminance calibration. Display image_color is the replaceable image signal. Phosphorescence defaults uncharged/off. -->
    <constant name="operating_state" type="float"><input name="value" type="float" value="1" /></constant>
    <constant name="emission_intensity" type="float"><input name="value" type="float" value="2" /></constant>
    <multiply name="emission_strength" type="float"><input name="in1" type="float" nodename="operating_state" /><input name="in2" type="float" nodename="emission_intensity" /></multiply>
    <constant name="emission_color" type="color3"><input name="value" type="color3" value="0.012, 0.075, 0.37" /></constant>
    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="specular_roughness_out" type="float" nodename="roughness" />
    <output name="metalness_out" type="float" nodename="metalness" />
    <output name="normal_out" type="vector3" nodename="normal_world" />
    <output name="specular_out" type="float" nodename="specular" />
    <output name="emission_out" type="float" nodename="emission_strength" />
    <output name="emission_color_out" type="color3" nodename="emission_color" />
  </nodegraph>
  <standard_surface name="SR_emissiveIndicatorDiffuseBlue" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_emissiveIndicatorDiffuseBlue" output="base_color_out" />
    <input name="specular_roughness" type="float" nodegraph="NG_emissiveIndicatorDiffuseBlue" output="specular_roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_emissiveIndicatorDiffuseBlue" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_emissiveIndicatorDiffuseBlue" output="normal_out" />
    <input name="specular" type="float" nodegraph="NG_emissiveIndicatorDiffuseBlue" output="specular_out" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="emission" type="float" nodegraph="NG_emissiveIndicatorDiffuseBlue" output="emission_out" />
    <input name="emission_color" type="color3" nodegraph="NG_emissiveIndicatorDiffuseBlue" output="emission_color_out" />
  </standard_surface>
  <surfacematerial name="M_emissiveIndicatorDiffuseBlue" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_emissiveIndicatorDiffuseBlue" /></surfacematerial>
</materialx>
