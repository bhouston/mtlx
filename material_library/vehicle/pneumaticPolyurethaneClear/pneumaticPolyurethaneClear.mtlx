<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- clear pneumatic-grade polyurethane; smooth semi-gloss polymer skin; clear variant has low-haze transparent transmission. -->
  <!-- Factory-new appearance target; colors are linear Rec.709 artistic reflectances, not measured OEM data.  -->
  <nodegraph name="NG_pneumaticPolyurethaneClear">
    <!-- UV 0..1 is exactly one metre; all height values below are metres. skin: frequencies 35 × 1400 cycles/metre; relief amplitude 3e-7 m. -->
    <texcoord name="uv" type="vector2"></texcoord>
    <multiply name="feature_uv" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="35, 1400" /></multiply>
    <noise2d name="micro" type="float"><input name="texcoord" type="vector2" nodename="feature_uv" /><input name="amplitude" type="float" value="0.45" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <multiply name="height" type="float"><input name="in1" type="float" nodename="micro" /><input name="in2" type="float" value="3e-7" /></multiply>
    <mix name="base_color" type="color3"><input name="bg" type="color3" value="0.96, 0.98, 0.99" /><input name="fg" type="color3" value="0.96, 0.98, 0.98" /><input name="mix" type="float" nodename="micro" /></mix>
    <multiply name="roughness_detail" type="float"><input name="in1" type="float" nodename="micro" /><input name="in2" type="float" value="0.027200000000000002" /></multiply>
    <add name="roughness" type="float"><input name="in1" type="float" nodename="roughness_detail" /><input name="in2" type="float" value="0.32" /></add>
    <constant name="metalness" type="float"><input name="value" type="float" value="0" /></constant>
    <multiply name="uv_mm" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="height_mm" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="normal_tangent" type="vector3"><input name="in" type="float" nodename="height_mm" /><input name="texcoord" type="vector2" nodename="uv_mm" /><input name="scale" type="float" value="16" /></heighttonormal>
    <normalmap name="normal_world" type="vector3"><input name="in" type="vector3" nodename="normal_tangent" /></normalmap>
    <constant name="specular" type="float"><input name="value" type="float" value="0.5" /></constant>
    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="specular_roughness_out" type="float" nodename="roughness" />
    <output name="metalness_out" type="float" nodename="metalness" />
    <output name="normal_out" type="vector3" nodename="normal_world" />
    <output name="specular_out" type="float" nodename="specular" />
  </nodegraph>
  <standard_surface name="SR_pneumaticPolyurethaneClear" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_pneumaticPolyurethaneClear" output="base_color_out" />
    <input name="specular_roughness" type="float" nodegraph="NG_pneumaticPolyurethaneClear" output="specular_roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_pneumaticPolyurethaneClear" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_pneumaticPolyurethaneClear" output="normal_out" />
    <input name="specular" type="float" nodegraph="NG_pneumaticPolyurethaneClear" output="specular_out" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="transmission" type="float" value="1" />
    <input name="transmission_color" type="color3" value="0.995, 0.997, 0.999" />
    <input name="transmission_depth" type="float" value="0.001" />
    <input name="transmission_scatter" type="color3" value="0, 0, 0" />
  </standard_surface>
  <surfacematerial name="M_pneumaticPolyurethaneClear" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_pneumaticPolyurethaneClear" /></surfacematerial>
</materialx>
