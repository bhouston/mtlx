<?xml version='1.0' encoding='utf-8'?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Terracotta; mineral render with visibly coarse embedded aggregate, deep local microrelief, and diffuse reflection. -->
  <!-- Authored linear Rec.709 art target; not a calibrated manufacturer sample. Regenerate with authoring/generate-mineral-wood.py. -->
  <nodegraph name="NG_stuccoTerracottaCoarse">
    <texcoord name="uv" type="vector2" />
    <!-- Metric UVs: one UV unit = one metre. Height values below are metres. -->
    <multiply name="multiply_1" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="float" value="3.1" />
    </multiply>
    <add name="add_2" type="vector2">
      <input name="in1" type="vector2" nodename="multiply_1" />
      <input name="in2" type="vector2" value="13.3923077, 3.40615385" />
    </add>
    <fractal2d name="fractal2d_3" type="float">
      <input name="texcoord" type="vector2" nodename="add_2" />
      <input name="amplitude" type="float" value="1" />
      <input name="octaves" type="integer" value="3" />
      <input name="lacunarity" type="float" value="2.03" />
      <input name="diminish" type="float" value="0.5" />
    </fractal2d>
    <multiply name="multiply_4" type="float">
      <input name="in1" type="float" nodename="fractal2d_3" />
      <input name="in2" type="float" value="0.6" />
    </multiply>
    <add name="add_5" type="float">
      <input name="in1" type="float" nodename="multiply_4" />
      <input name="in2" type="float" value="0.5" />
    </add>
    <clamp name="clamp_6" type="float">
      <input name="in" type="float" nodename="add_5" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" value="1" />
    </clamp>
    <rotate2d name="rotate2d_7" type="vector2">
      <input name="in" type="vector2" nodename="uv" />
      <input name="amount" type="float" value="31" />
    </rotate2d>
    <multiply name="multiply_8" type="vector2">
      <input name="in1" type="vector2" nodename="rotate2d_7" />
      <input name="in2" type="float" value="110" />
    </multiply>
    <add name="add_9" type="vector2">
      <input name="in1" type="vector2" nodename="multiply_8" />
      <input name="in2" type="vector2" value="16.9923077, 6.80615385" />
    </add>
    <fractal2d name="fractal2d_10" type="float">
      <input name="texcoord" type="vector2" nodename="add_9" />
      <input name="amplitude" type="float" value="0.00021" />
      <input name="octaves" type="integer" value="2" />
      <input name="lacunarity" type="float" value="2.03" />
      <input name="diminish" type="float" value="0.5" />
    </fractal2d>
    <mix name="mix_11" type="float">
      <input name="bg" type="float" value="0.93" />
      <input name="fg" type="float" value="1.07" />
      <input name="mix" type="float" nodename="clamp_6" />
    </mix>
    <multiply name="multiply_12" type="color3">
      <input name="in1" type="color3" value="0.43, 0.14, 0.067" />
      <input name="in2" type="float" nodename="mix_11" />
    </multiply>
    <multiply name="multiply_17" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="float" value="1320" />
    </multiply>
    <add name="add_18" type="vector2">
      <input name="in1" type="vector2" nodename="multiply_17" />
      <input name="in2" type="vector2" value="10.9923077, 74.0061538" />
    </add>
    <fractal2d name="fractal2d_19" type="vector3">
      <input name="texcoord" type="vector2" nodename="add_18" />
      <input name="amplitude" type="vector3" value="0.0001, 0.0001, 0" />
      <input name="octaves" type="integer" value="1" />
    </fractal2d>
    <convert name="convert_20" type="vector2">
      <input name="in" type="vector3" nodename="fractal2d_19" />
    </convert>
    <add name="add_21" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" nodename="convert_20" />
    </add>
    <rotate2d name="rotate2d_22" type="vector2">
      <input name="in" type="vector2" nodename="add_21" />
      <input name="amount" type="float" value="23" />
    </rotate2d>
    <multiply name="multiply_23" type="vector2">
      <input name="in1" type="vector2" nodename="rotate2d_22" />
      <input name="in2" type="float" value="220" />
    </multiply>
    <add name="add_24" type="vector2">
      <input name="in1" type="vector2" nodename="multiply_23" />
      <input name="in2" type="vector2" value="14.4923077, 42.4061538" />
    </add>
    <worleynoise2d name="worleynoise2d_25" type="float">
      <input name="texcoord" type="vector2" nodename="add_24" />
      <input name="jitter" type="float" value="0.55" />
    </worleynoise2d>
    <worleynoise2d name="worleynoise2d_26" type="float">
      <input name="texcoord" type="vector2" nodename="add_24" />
      <input name="jitter" type="float" value="0.55" />
      <input name="style" type="integer" value="1" />
    </worleynoise2d>
    <multiply name="multiply_27" type="float">
      <input name="in1" type="float" nodename="worleynoise2d_26" />
      <input name="in2" type="float" value="13.73" />
    </multiply>
    <fract name="fract_28" type="float">
      <input name="in" type="float" nodename="multiply_27" />
    </fract>
    <multiply name="multiply_29" type="float">
      <input name="in1" type="float" nodename="fract_28" />
      <input name="in2" type="float" value="0.1" />
    </multiply>
    <add name="add_30" type="float">
      <input name="in1" type="float" value="0.11" />
      <input name="in2" type="float" nodename="multiply_29" />
    </add>
    <subtract name="subtract_31" type="float">
      <input name="in1" type="float" nodename="add_30" />
      <input name="in2" type="float" nodename="worleynoise2d_25" />
    </subtract>
    <smoothstep name="smoothstep_32" type="float">
      <input name="in" type="float" nodename="subtract_31" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" nodename="add_30" />
    </smoothstep>
    <multiply name="multiply_33" type="float">
      <input name="in1" type="float" nodename="smoothstep_32" />
      <input name="in2" type="float" nodename="worleynoise2d_26" />
    </multiply>
    <mix name="mix_34" type="float">
      <input name="bg" type="float" value="0.84" />
      <input name="fg" type="float" value="1.16" />
      <input name="mix" type="float" nodename="multiply_33" />
    </mix>
    <multiply name="multiply_35" type="color3">
      <input name="in1" type="color3" nodename="multiply_12" />
      <input name="in2" type="float" nodename="mix_34" />
    </multiply>
    <multiply name="multiply_36" type="float">
      <input name="in1" type="float" nodename="smoothstep_32" />
      <input name="in2" type="float" value="6.5e-05" />
    </multiply>
    <add name="add_37" type="float">
      <input name="in1" type="float" nodename="fractal2d_10" />
      <input name="in2" type="float" nodename="multiply_36" />
    </add>
    <mix name="mix_38" type="float">
      <input name="bg" type="float" value="0.8" />
      <input name="fg" type="float" value="0.95" />
      <input name="mix" type="float" nodename="smoothstep_32" />
    </mix>
    <multiply name="height_mm" type="float">
      <input name="in1" type="float" nodename="add_37" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <multiply name="uv_mm" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <heighttonormal name="n_tangent" type="vector3">
      <input name="in" type="float" nodename="height_mm" />
      <input name="scale" type="float" value="16" />
      <input name="texcoord" type="vector2" nodename="uv_mm" />
    </heighttonormal>
    <normalmap name="n_world" type="vector3">
      <input name="in" type="vector3" nodename="n_tangent" />
    </normalmap>
    <constant name="metalness" type="float">
      <input name="value" type="float" value="0" />
    </constant>
    <output name="base_color_out" type="color3" nodename="multiply_35" />
    <output name="roughness_out" type="float" nodename="mix_38" />
    <output name="metalness_out" type="float" nodename="metalness" />
    <output name="normal_out" type="vector3" nodename="n_world" />
  </nodegraph>
  <standard_surface name="SR_stuccoTerracottaCoarse" type="surfaceshader">
    <input name="base" type="float" value="1" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="base_color" type="color3" nodegraph="NG_stuccoTerracottaCoarse" output="base_color_out" />
    <input name="specular_roughness" type="float" nodegraph="NG_stuccoTerracottaCoarse" output="roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_stuccoTerracottaCoarse" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_stuccoTerracottaCoarse" output="normal_out" />
  </standard_surface>
  <surfacematerial name="M_stuccoTerracottaCoarse" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_stuccoTerracottaCoarse" />
  </surfacematerial>
</materialx>