<?xml version='1.0' encoding='utf-8'?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Pale green paper facing with visible fine fiber and a matte finish. -->
  <!-- Authored linear Rec.709 art target; not a calibrated manufacturer sample. Regenerate with authoring/generate-mineral-wood.py. -->
  <nodegraph name="NG_gypsumBoardMoistureResistantGreen">
    <texcoord name="uv" type="vector2" />
    <!-- Metric UVs: one UV unit = one metre. Height values below are metres. -->
    <multiply name="multiply_17" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="float" value="3.1" />
    </multiply>
    <add name="add_18" type="vector2">
      <input name="in1" type="vector2" nodename="multiply_17" />
      <input name="in2" type="vector2" value="10.8538462, 2.46692308" />
    </add>
    <fractal2d name="fractal2d_19" type="float">
      <input name="texcoord" type="vector2" nodename="add_18" />
      <input name="amplitude" type="float" value="1" />
      <input name="octaves" type="integer" value="3" />
      <input name="lacunarity" type="float" value="2.03" />
      <input name="diminish" type="float" value="0.5" />
    </fractal2d>
    <multiply name="multiply_20" type="float">
      <input name="in1" type="float" nodename="fractal2d_19" />
      <input name="in2" type="float" value="0.6" />
    </multiply>
    <add name="add_21" type="float">
      <input name="in1" type="float" nodename="multiply_20" />
      <input name="in2" type="float" value="0.5" />
    </add>
    <clamp name="clamp_22" type="float">
      <input name="in" type="float" nodename="add_21" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" value="1" />
    </clamp>
    <rotate2d name="rotate2d_23" type="vector2">
      <input name="in" type="vector2" nodename="uv" />
      <input name="amount" type="float" value="31" />
    </rotate2d>
    <multiply name="multiply_24" type="vector2">
      <input name="in1" type="vector2" nodename="rotate2d_23" />
      <input name="in2" type="float" value="650" />
    </multiply>
    <add name="add_25" type="vector2">
      <input name="in1" type="vector2" nodename="multiply_24" />
      <input name="in2" type="vector2" value="14.4538462, 5.86692308" />
    </add>
    <fractal2d name="fractal2d_26" type="float">
      <input name="texcoord" type="vector2" nodename="add_25" />
      <input name="amplitude" type="float" value="1.2e-05" />
      <input name="octaves" type="integer" value="2" />
      <input name="lacunarity" type="float" value="2.03" />
      <input name="diminish" type="float" value="0.5" />
    </fractal2d>
    <mix name="mix_27" type="float">
      <input name="bg" type="float" value="0.96" />
      <input name="fg" type="float" value="1.04" />
      <input name="mix" type="float" nodename="clamp_22" />
    </mix>
    <multiply name="multiply_28" type="color3">
      <input name="in1" type="color3" value="0.45, 0.59, 0.32" />
      <input name="in2" type="float" nodename="mix_27" />
    </multiply>
    <subtract name="subtract_29" type="float">
      <input name="in1" type="float" value="0.5" />
      <input name="in2" type="float" nodename="clamp_22" />
    </subtract>
    <multiply name="multiply_30" type="float">
      <input name="in1" type="float" nodename="subtract_29" />
      <input name="in2" type="float" value="0.06" />
    </multiply>
    <add name="add_31" type="float">
      <input name="in1" type="float" value="0.94" />
      <input name="in2" type="float" nodename="multiply_30" />
    </add>
    <clamp name="clamp_32" type="float">
      <input name="in" type="float" nodename="add_31" />
      <input name="low" type="float" value="0.03" />
      <input name="high" type="float" value="0.99" />
    </clamp>
    <rotate2d name="rotate2d_33" type="vector2">
      <input name="in" type="vector2" nodename="uv" />
      <input name="amount" type="float" value="11" />
    </rotate2d>
    <multiply name="multiply_34" type="vector2">
      <input name="in1" type="vector2" nodename="rotate2d_33" />
      <input name="in2" type="vector2" value="750, 12" />
    </multiply>
    <add name="add_35" type="vector2">
      <input name="in1" type="vector2" nodename="multiply_34" />
      <input name="in2" type="vector2" value="6.52384615, 9.77692308" />
    </add>
    <fractal2d name="fractal2d_36" type="float">
      <input name="texcoord" type="vector2" nodename="add_35" />
      <input name="amplitude" type="float" value="6e-06" />
      <input name="octaves" type="integer" value="1" />
      <input name="lacunarity" type="float" value="2.03" />
      <input name="diminish" type="float" value="0.5" />
    </fractal2d>
    <add name="add_37" type="float">
      <input name="in1" type="float" nodename="fractal2d_26" />
      <input name="in2" type="float" nodename="fractal2d_36" />
    </add>
    <multiply name="height_mm" type="float">
      <input name="in1" type="float" nodename="add_37" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <multiply name="uv_mm" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <heighttonormal name="n_tangent" type="vector3">
      <input name="in" type="float" nodename="height_mm" />
      <input name="scale" type="float" value="16" />
      <input name="texcoord" type="vector2" nodename="uv_mm" />
    </heighttonormal>
    <normalmap name="n_world" type="vector3">
      <input name="in" type="vector3" nodename="n_tangent" />
    </normalmap>
    <constant name="metalness" type="float">
      <input name="value" type="float" value="0" />
    </constant>
    <output name="base_color_out" type="color3" nodename="multiply_28" />
    <output name="roughness_out" type="float" nodename="clamp_32" />
    <output name="metalness_out" type="float" nodename="metalness" />
    <output name="normal_out" type="vector3" nodename="n_world" />
  </nodegraph>
  <standard_surface name="SR_gypsumBoardMoistureResistantGreen" type="surfaceshader">
    <input name="base" type="float" value="1" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="base_color" type="color3" nodegraph="NG_gypsumBoardMoistureResistantGreen" output="base_color_out" />
    <input name="specular_roughness" type="float" nodegraph="NG_gypsumBoardMoistureResistantGreen" output="roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_gypsumBoardMoistureResistantGreen" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_gypsumBoardMoistureResistantGreen" output="normal_out" />
  </standard_surface>
  <surfacematerial name="M_gypsumBoardMoistureResistantGreen" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_gypsumBoardMoistureResistantGreen" />
  </surfacematerial>
</materialx>