<?xml version='1.0' encoding='utf-8'?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Catalog: Clear glass with sparse fine trapped bubbles and slight optical waviness; smooth glossy reflection. -->
  <!-- Art-directed linear Rec.709; 1 UV = 1 m; height in m. Closed geometry supplies optical path length. transmission_color is reference transmittance at transmission_depth in metres, not opacity. Rendering of volume scattering, films and multibounce refraction depends on renderer support. Trapped bubbles are represented as sparse optical roughness/normal inclusions, not explicit volume geometry. -->
  <!-- Recipe bubbles: feature frequencies 650, 650 per m; relief amplitude 4e-06 m; macro drift about 0.25 m. Subpixel detail requires filtering at distance. -->
  <nodegraph name="NG_glassSeededClear">
    <texcoord name="uv" type="vector2">
      <input name="index" type="integer" value="0" />
    </texcoord>
    <multiply name="multiply_2" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="3.1, 4.3" />
    </multiply>
    <add name="add_3" type="vector2">
      <input name="in1" type="vector2" nodename="multiply_2" />
      <input name="in2" type="vector2" value="11.37, 29.17" />
    </add>
    <fractal2d name="fractal2d_4" type="float">
      <input name="texcoord" type="vector2" nodename="add_3" />
      <input name="octaves" type="integer" value="3" />
    </fractal2d>
    <multiply name="multiply_12" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="650, 650" />
    </multiply>
    <add name="add_13" type="vector2">
      <input name="in1" type="vector2" nodename="multiply_12" />
      <input name="in2" type="vector2" value="5.81, 17.37" />
    </add>
    <worleynoise2d name="worleynoise2d_14" type="float">
      <input name="texcoord" type="vector2" nodename="add_13" />
      <input name="jitter" type="float" value="0.85" />
      <input name="style" type="integer" value="0" />
    </worleynoise2d>
    <smoothstep name="smoothstep_15" type="float">
      <input name="in" type="float" nodename="worleynoise2d_14" />
      <input name="low" type="float" value="0.05" />
      <input name="high" type="float" value="0.13" />
    </smoothstep>
    <subtract name="subtract_16" type="float">
      <input name="in1" type="float" value="1" />
      <input name="in2" type="float" nodename="smoothstep_15" />
    </subtract>
    <multiply name="multiply_17" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="40, 40" />
    </multiply>
    <add name="add_18" type="vector2">
      <input name="in1" type="vector2" nodename="multiply_17" />
      <input name="in2" type="vector2" value="5.81, 17.37" />
    </add>
    <worleynoise2d name="worleynoise2d_19" type="float">
      <input name="texcoord" type="vector2" nodename="add_18" />
      <input name="jitter" type="float" value="0.85" />
      <input name="style" type="integer" value="1" />
    </worleynoise2d>
    <smoothstep name="smoothstep_20" type="float">
      <input name="in" type="float" nodename="worleynoise2d_19" />
      <input name="low" type="float" value="0.92" />
      <input name="high" type="float" value="0.99" />
    </smoothstep>
    <multiply name="multiply_21" type="float">
      <input name="in1" type="float" nodename="subtract_16" />
      <input name="in2" type="float" nodename="smoothstep_20" />
    </multiply>
    <multiply name="multiply_22" type="float">
      <input name="in1" type="float" nodename="multiply_21" />
      <input name="in2" type="float" value="4e-06" />
    </multiply>
    <multiply name="multiply_23" type="float">
      <input name="in1" type="float" nodename="fractal2d_4" />
      <input name="in2" type="float" value="0" />
    </multiply>
    <add name="add_24" type="float">
      <input name="in1" type="float" value="1" />
      <input name="in2" type="float" nodename="multiply_23" />
    </add>
    <mix name="mix_25" type="color3">
      <input name="bg" type="color3" value="1, 1, 1" />
      <input name="fg" type="color3" value="1, 1, 1" />
      <input name="mix" type="float" nodename="multiply_21" />
    </mix>
    <multiply name="base_color" type="color3">
      <input name="in1" type="color3" nodename="mix_25" />
      <input name="in2" type="float" nodename="add_24" />
    </multiply>
    <subtract name="subtract_27" type="float">
      <input name="in1" type="float" nodename="multiply_21" />
      <input name="in2" type="float" value="0.5" />
    </subtract>
    <multiply name="multiply_28" type="float">
      <input name="in1" type="float" nodename="subtract_27" />
      <input name="in2" type="float" value="-0.00252" />
    </multiply>
    <add name="add_29" type="float">
      <input name="in1" type="float" value="0.018" />
      <input name="in2" type="float" nodename="multiply_28" />
    </add>
    <clamp name="roughness" type="float">
      <input name="in" type="float" nodename="add_29" />
      <input name="low" type="float" value="0.005" />
      <input name="high" type="float" value="1" />
    </clamp>
    <constant name="metalness" type="float">
      <input name="value" type="float" value="0" />
    </constant>
    <multiply name="multiply_32" type="float">
      <input name="in1" type="float" nodename="fractal2d_4" />
      <input name="in2" type="float" value="1e-06" />
    </multiply>
    <add name="height" type="float">
      <input name="in1" type="float" nodename="multiply_22" />
      <input name="in2" type="float" nodename="multiply_32" />
    </add>
    <multiply name="uv_mm" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <multiply name="height_mm" type="float">
      <input name="in1" type="float" nodename="height" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <heighttonormal name="n_tangent" type="vector3">
      <input name="in" type="float" nodename="height_mm" />
      <input name="scale" type="float" value="16" />
      <input name="texcoord" type="vector2" nodename="uv_mm" />
    </heighttonormal>
    <normalmap name="n_world" type="vector3">
      <input name="in" type="vector3" nodename="n_tangent" />
    </normalmap>
    <output name="out_base_color" type="color3" nodename="base_color" />
    <output name="out_roughness" type="float" nodename="roughness" />
    <output name="out_metalness" type="float" nodename="metalness" />
    <output name="out_normal" type="vector3" nodename="n_world" />
  </nodegraph>
  <standard_surface name="SR_glassSeededClear" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_glassSeededClear" output="out_base_color" />
    <input name="specular_roughness" type="float" nodegraph="NG_glassSeededClear" output="out_roughness" />
    <input name="metalness" type="float" nodegraph="NG_glassSeededClear" output="out_metalness" />
    <input name="normal" type="vector3" nodegraph="NG_glassSeededClear" output="out_normal" />
    <input name="specular" type="float" value="0.5" />
    <input name="base" type="float" value="0" />
    <input name="transmission" type="float" value="1" />
    <input name="transmission_color" type="color3" value="0.92, 0.98, 0.94" />
    <input name="transmission_depth" type="float" value="0.1" />
    <input name="specular_IOR" type="float" value="1.52" />
  </standard_surface>
  <surfacematerial name="glassSeededClear" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_glassSeededClear" />
  </surfacematerial>
</materialx>