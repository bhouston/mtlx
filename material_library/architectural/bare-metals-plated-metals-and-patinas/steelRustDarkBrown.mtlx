<?xml version='1.0' encoding='utf-8'?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Catalog: Deep brown iron oxide with uneven fine grain and a rough diffuse response. -->
  <!-- Art-directed linear Rec.709; 1 UV = 1 m; height in m. Continuous oxide grains at 320 per m add 90 micrometre crowns; fine 600 per m pits cut 50 micrometres. Oxide coverage modulates conductor weight; dielectric oxide and remaining bare metal are an energy-weighted standard_surface approximation, not a spectral layered conductor. -->
  <!-- Recipe oxide: feature frequencies 180, 180 per m; relief amplitude 3.5e-05 m; macro drift about 0.25 m. -->
  <nodegraph name="NG_steelRustDarkBrown">
    <texcoord name="uv" type="vector2">
      <input name="index" type="integer" value="0" />
    </texcoord>
    <multiply name="multiply_2" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="3.1, 4.3" />
    </multiply>
    <add name="add_3" type="vector2">
      <input name="in1" type="vector2" nodename="multiply_2" />
      <input name="in2" type="vector2" value="11.37, 29.17" />
    </add>
    <fractal2d name="fractal2d_4" type="float">
      <input name="texcoord" type="vector2" nodename="add_3" />
      <input name="octaves" type="integer" value="3" />
    </fractal2d>
    <multiply name="multiply_5" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="180, 180" />
    </multiply>
    <add name="add_6" type="vector2">
      <input name="in1" type="vector2" nodename="multiply_5" />
      <input name="in2" type="vector2" value="3.71, 9.17" />
    </add>
    <fractal2d name="fractal2d_7" type="float">
      <input name="texcoord" type="vector2" nodename="add_6" />
      <input name="octaves" type="integer" value="1" />
    </fractal2d>
    <multiply name="multiply_11" type="float">
      <input name="in1" type="float" nodename="fractal2d_7" />
      <input name="in2" type="float" value="3.5e-05" />
    </multiply>
    <multiply name="multiply_12" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="320, 320" />
    </multiply>
    <add name="add_13" type="vector2">
      <input name="in1" type="vector2" nodename="multiply_12" />
      <input name="in2" type="vector2" value="5.81, 17.37" />
    </add>
    <worleynoise2d name="worleynoise2d_14" type="float">
      <input name="texcoord" type="vector2" nodename="add_13" />
      <input name="jitter" type="float" value="0.85" />
      <input name="style" type="integer" value="0" />
    </worleynoise2d>
    <smoothstep name="smoothstep_15" type="float">
      <input name="in" type="float" nodename="worleynoise2d_14" />
      <input name="low" type="float" value="0.08" />
      <input name="high" type="float" value="0.52" />
    </smoothstep>
    <subtract name="subtract_16" type="float">
      <input name="in1" type="float" value="1" />
      <input name="in2" type="float" nodename="smoothstep_15" />
    </subtract>
    <multiply name="multiply_17" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="600, 600" />
    </multiply>
    <add name="add_18" type="vector2">
      <input name="in1" type="vector2" nodename="multiply_17" />
      <input name="in2" type="vector2" value="21.31, 8.91" />
    </add>
    <fractal2d name="fractal2d_19" type="float">
      <input name="texcoord" type="vector2" nodename="add_18" />
      <input name="octaves" type="integer" value="1" />
    </fractal2d>
    <smoothstep name="smoothstep_20" type="float">
      <input name="in" type="float" nodename="fractal2d_19" />
      <input name="low" type="float" value="0.24" />
      <input name="high" type="float" value="0.65" />
    </smoothstep>
    <multiply name="multiply_21" type="float">
      <input name="in1" type="float" nodename="subtract_16" />
      <input name="in2" type="float" value="9e-05" />
    </multiply>
    <multiply name="multiply_22" type="float">
      <input name="in1" type="float" nodename="smoothstep_20" />
      <input name="in2" type="float" value="5e-05" />
    </multiply>
    <subtract name="subtract_23" type="float">
      <input name="in1" type="float" nodename="multiply_21" />
      <input name="in2" type="float" nodename="multiply_22" />
    </subtract>
    <add name="add_24" type="float">
      <input name="in1" type="float" nodename="multiply_11" />
      <input name="in2" type="float" nodename="subtract_23" />
    </add>
    <multiply name="multiply_25" type="float">
      <input name="in1" type="float" nodename="fractal2d_4" />
      <input name="in2" type="float" value="0.8" />
    </multiply>
    <add name="add_26" type="float">
      <input name="in1" type="float" nodename="multiply_25" />
      <input name="in2" type="float" value="0.5" />
    </add>
    <clamp name="clamp_27" type="float">
      <input name="in" type="float" nodename="add_26" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" value="1" />
    </clamp>
    <multiply name="multiply_28" type="float">
      <input name="in1" type="float" nodename="clamp_27" />
      <input name="in2" type="float" value="0.8" />
    </multiply>
    <multiply name="multiply_29" type="float">
      <input name="in1" type="float" nodename="subtract_16" />
      <input name="in2" type="float" value="0.2" />
    </multiply>
    <add name="add_30" type="float">
      <input name="in1" type="float" nodename="multiply_28" />
      <input name="in2" type="float" nodename="multiply_29" />
    </add>
    <clamp name="clamp_31" type="float">
      <input name="in" type="float" nodename="add_30" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" value="1" />
    </clamp>
    <multiply name="multiply_32" type="float">
      <input name="in1" type="float" nodename="fractal2d_4" />
      <input name="in2" type="float" value="0.0672" />
    </multiply>
    <add name="add_33" type="float">
      <input name="in1" type="float" value="1" />
      <input name="in2" type="float" nodename="multiply_32" />
    </add>
    <mix name="mix_34" type="color3">
      <input name="bg" type="color3" value="0.0912, 0.0304, 0.0114" />
      <input name="fg" type="color3" value="0.1488, 0.0496, 0.0186" />
      <input name="mix" type="float" nodename="clamp_31" />
    </mix>
    <multiply name="base_color" type="color3">
      <input name="in1" type="color3" nodename="mix_34" />
      <input name="in2" type="float" nodename="add_33" />
    </multiply>
    <mix name="oxide_metalness" type="float">
      <input name="bg" type="float" value="0.005" />
      <input name="fg" type="float" value="0.25" />
      <input name="mix" type="float" nodename="clamp_31" />
    </mix>
    <mix name="oxide_roughness" type="float">
      <input name="bg" type="float" value="0.82" />
      <input name="fg" type="float" value="0.47" />
      <input name="mix" type="float" nodename="clamp_31" />
    </mix>
    <multiply name="multiply_43" type="float">
      <input name="in1" type="float" nodename="fractal2d_4" />
      <input name="in2" type="float" value="8.75e-06" />
    </multiply>
    <add name="height" type="float">
      <input name="in1" type="float" nodename="add_24" />
      <input name="in2" type="float" nodename="multiply_43" />
    </add>
    <multiply name="uv_mm" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <multiply name="height_mm" type="float">
      <input name="in1" type="float" nodename="height" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <heighttonormal name="n_tangent" type="vector3">
      <input name="in" type="float" nodename="height_mm" />
      <input name="scale" type="float" value="16" />
      <input name="texcoord" type="vector2" nodename="uv_mm" />
    </heighttonormal>
    <normalmap name="n_world" type="vector3">
      <input name="in" type="vector3" nodename="n_tangent" />
    </normalmap>
    <output name="out_base_color" type="color3" nodename="base_color" />
    <output name="out_roughness" type="float" nodename="oxide_roughness" />
    <output name="out_metalness" type="float" nodename="oxide_metalness" />
    <output name="out_normal" type="vector3" nodename="n_world" />
  </nodegraph>
  <standard_surface name="SR_steelRustDarkBrown" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_steelRustDarkBrown" output="out_base_color" />
    <input name="specular_roughness" type="float" nodegraph="NG_steelRustDarkBrown" output="out_roughness" />
    <input name="metalness" type="float" nodegraph="NG_steelRustDarkBrown" output="out_metalness" />
    <input name="normal" type="vector3" nodegraph="NG_steelRustDarkBrown" output="out_normal" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
  </standard_surface>
  <surfacematerial name="steelRustDarkBrown" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_steelRustDarkBrown" />
  </surfacematerial>
</materialx>