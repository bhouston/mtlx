<?xml version="1.0" encoding="UTF-8"?>
<materialx version="1.39" colorspace="lin_rec709" doc="Dark green leaf tissue with fine branching vein coloration, glossy waxy highlights, and reduced green transmission; no leaf outline included. Recipe: leaf. mineral skin grains 1–2 mm with 8–120 micrometre relief, no stone distribution; organic longitudinal striae 3.8 mm/0.12 mm; tissue vein color spacing 3–15 mm. Requires renderer support for refraction, Beer-Lambert transmission_depth, and volume/scattering inputs; opacity remains 1. Closed solids need physical thickness. Thin films use thin_walled where stated. Subsurface scattering is an effective homogeneous approximation; renderer support varies. All colors are art-directed scene-linear Rec.709, not calibrated manufacturer measurements. UV 0–1 = 1 metre; height in metres. Relief is filtered surface appearance, not silhouette geometry.">
  <nodegraph name="NG_leafDeciduousDarkGreen">
    <texcoord name="uv" type="vector2">
      <input name="index" type="integer" value="0" />
    </texcoord>
    <multiply name="vein_network_scale" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="28, 95" />
    </multiply>
    <rotate2d name="vein_network_rotate" type="vector2">
      <input name="in" type="vector2" nodename="vein_network_scale" />
      <input name="amount" type="float" value="27" />
    </rotate2d>
    <add name="vein_network_offset" type="vector2">
      <input name="in1" type="vector2" nodename="vein_network_rotate" />
      <input name="in2" type="vector2" value="3.71, 8.29" />
    </add>
    <fractal2d name="vein_network" type="float">
      <input name="texcoord" type="vector2" nodename="vein_network_offset" />
      <input name="amplitude" type="float" value="1" />
      <input name="octaves" type="integer" value="2" />
    </fractal2d>
    <absval name="vein_abs" type="float">
      <input name="in" type="float" nodename="vein_network" />
    </absval>
    <smoothstep name="vein_ramp" type="float">
      <input name="in" type="float" nodename="vein_abs" />
      <input name="low" type="float" value="0.015" />
      <input name="high" type="float" value="0.07" />
    </smoothstep>
    <subtract name="vein_mask" type="float">
      <input name="in1" type="float" value="1" />
      <input name="in2" type="float" nodename="vein_ramp" />
    </subtract>
    <multiply name="vein_height" type="float">
      <input name="in1" type="float" nodename="vein_mask" />
      <input name="in2" type="float" value="1.2e-05" />
    </multiply>
    <multiply name="tone_drift_noise_scale" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="3.7, 4.9" />
    </multiply>
    <add name="tone_drift_noise_offset" type="vector2">
      <input name="in1" type="vector2" nodename="tone_drift_noise_scale" />
      <input name="in2" type="vector2" value="15.1, 9.7" />
    </add>
    <fractal2d name="tone_drift_noise" type="float">
      <input name="texcoord" type="vector2" nodename="tone_drift_noise_offset" />
      <input name="amplitude" type="float" value="1" />
      <input name="octaves" type="integer" value="2" />
    </fractal2d>
    <multiply name="tone_drift_gain" type="float">
      <input name="in1" type="float" nodename="tone_drift_noise" />
      <input name="in2" type="float" value="0.6" />
    </multiply>
    <add name="tone_drift_bias" type="float">
      <input name="in1" type="float" nodename="tone_drift_gain" />
      <input name="in2" type="float" value="0.5" />
    </add>
    <clamp name="tone_drift" type="float">
      <input name="in" type="float" nodename="tone_drift_bias" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" value="1" />
    </clamp>
    <mix name="pigment_variation" type="float">
      <input name="bg" type="float" value="0.88" />
      <input name="fg" type="float" value="1.12" />
      <input name="mix" type="float" nodename="vein_mask" />
    </mix>
    <multiply name="micro_color" type="color3">
      <input name="in1" type="color3" value="0.025, 0.075, 0.035" />
      <input name="in2" type="float" nodename="pigment_variation" />
    </multiply>
    <mix name="macro_pigment" type="float">
      <input name="bg" type="float" value="0.964" />
      <input name="fg" type="float" value="1.036" />
      <input name="mix" type="float" nodename="tone_drift" />
    </mix>
    <multiply name="base_color" type="color3">
      <input name="in1" type="color3" nodename="micro_color" />
      <input name="in2" type="float" nodename="macro_pigment" />
    </multiply>
    <mix name="roughness" type="float">
      <input name="bg" type="float" value="0.2" />
      <input name="fg" type="float" value="0.26" />
      <input name="mix" type="float" nodename="vein_mask" />
    </mix>
    <constant name="metalness" type="float">
      <input name="value" type="float" value="0" />
    </constant>
    <add name="height" type="float">
      <input name="in1" type="float" nodename="vein_height" />
      <input name="in2" type="float" value="0" />
    </add>
    <multiply name="uv_mm" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <multiply name="height_mm" type="float">
      <input name="in1" type="float" nodename="height" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <heighttonormal name="n_tangent" type="vector3">
      <input name="in" type="float" nodename="height_mm" />
      <input name="scale" type="float" value="16" />
      <input name="texcoord" type="vector2" nodename="uv_mm" />
    </heighttonormal>
    <normalmap name="n_world" type="vector3">
      <input name="in" type="vector3" nodename="n_tangent" />
    </normalmap>
    <constant name="base" type="float">
      <input name="value" type="float" value="1" />
    </constant>
    <constant name="specular" type="float">
      <input name="value" type="float" value="0.5" />
    </constant>
    <constant name="specular_IOR" type="float">
      <input name="value" type="float" value="1.5" />
    </constant>
    <constant name="diffuse_roughness" type="float">
      <input name="value" type="float" value="0.25" />
    </constant>
    <constant name="thin_walled" type="boolean">
      <input name="value" type="boolean" value="true" />
    </constant>
    <constant name="subsurface" type="float">
      <input name="value" type="float" value="0.35" />
    </constant>
    <constant name="subsurface_color" type="color3">
      <input name="value" type="color3" value="0.025, 0.075, 0.035" />
    </constant>
    <constant name="subsurface_scale" type="float">
      <input name="value" type="float" value="0.0004" />
    </constant>
    <constant name="transmission" type="float">
      <input name="value" type="float" value="0.05" />
    </constant>
    <constant name="transmission_color" type="color3">
      <input name="value" type="color3" value="0.025, 0.075, 0.035" />
    </constant>
    <output name="out_base_color" type="color3" nodename="base_color" />
    <output name="out_roughness" type="float" nodename="roughness" />
    <output name="out_metalness" type="float" nodename="metalness" />
    <output name="out_normal" type="vector3" nodename="n_world" />
    <output name="out_base" type="float" nodename="base" />
    <output name="out_specular" type="float" nodename="specular" />
    <output name="out_specular_IOR" type="float" nodename="specular_IOR" />
    <output name="out_diffuse_roughness" type="float" nodename="diffuse_roughness" />
    <output name="out_thin_walled" type="boolean" nodename="thin_walled" />
    <output name="out_subsurface" type="float" nodename="subsurface" />
    <output name="out_subsurface_color" type="color3" nodename="subsurface_color" />
    <output name="out_subsurface_scale" type="float" nodename="subsurface_scale" />
    <output name="out_transmission" type="float" nodename="transmission" />
    <output name="out_transmission_color" type="color3" nodename="transmission_color" />
  </nodegraph>
  <standard_surface name="SR_leafDeciduousDarkGreen" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_leafDeciduousDarkGreen" output="out_base_color" />
    <input name="specular_roughness" type="float" nodegraph="NG_leafDeciduousDarkGreen" output="out_roughness" />
    <input name="metalness" type="float" nodegraph="NG_leafDeciduousDarkGreen" output="out_metalness" />
    <input name="normal" type="vector3" nodegraph="NG_leafDeciduousDarkGreen" output="out_normal" />
    <input name="base" type="float" nodegraph="NG_leafDeciduousDarkGreen" output="out_base" />
    <input name="specular" type="float" nodegraph="NG_leafDeciduousDarkGreen" output="out_specular" />
    <input name="specular_IOR" type="float" nodegraph="NG_leafDeciduousDarkGreen" output="out_specular_IOR" />
    <input name="diffuse_roughness" type="float" nodegraph="NG_leafDeciduousDarkGreen" output="out_diffuse_roughness" />
    <input name="thin_walled" type="boolean" nodegraph="NG_leafDeciduousDarkGreen" output="out_thin_walled" />
    <input name="subsurface" type="float" nodegraph="NG_leafDeciduousDarkGreen" output="out_subsurface" />
    <input name="subsurface_color" type="color3" nodegraph="NG_leafDeciduousDarkGreen" output="out_subsurface_color" />
    <input name="subsurface_scale" type="float" nodegraph="NG_leafDeciduousDarkGreen" output="out_subsurface_scale" />
    <input name="transmission" type="float" nodegraph="NG_leafDeciduousDarkGreen" output="out_transmission" />
    <input name="transmission_color" type="color3" nodegraph="NG_leafDeciduousDarkGreen" output="out_transmission_color" />
  </standard_surface>
  <surfacematerial name="M_leafDeciduousDarkGreen" type="material" doc="Dark green leaf tissue with fine branching vein coloration, glossy waxy highlights, and reduced green transmission; no leaf outline included.">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_leafDeciduousDarkGreen" />
  </surfacematerial>
</materialx>
