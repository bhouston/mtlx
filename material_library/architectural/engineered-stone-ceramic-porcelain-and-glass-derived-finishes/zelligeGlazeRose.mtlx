      <input name="mix" type="float" nodename="clamp_22" />
    </mix>
    <multiply name="multiply_24" type="color3">
      <input name="in1" type="color3" nodename="multiply_12" />
      <input name="in2" type="float" nodename="mix_23" />
    </multiply>
    <multiply name="multiply_25" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="float" value="18" />
    </multiply>
    <add name="add_26" type="vector2">
      <input name="in1" type="vector2" nodename="multiply_25" />
      <input name="in2" type="vector2" value="44.9853846, 24.0076923" />
    </add>
    <fractal2d name="fractal2d_27" type="float">
      <input name="texcoord" type="vector2" nodename="add_26" />
      <input name="amplitude" type="float" value="5.5e-05" />
      <input name="octaves" type="integer" value="2" />
      <input name="lacunarity" type="float" value="2.03" />
      <input name="diminish" type="float" value="0.5" />
    </fractal2d>
    <add name="add_28" type="float">
      <input name="in1" type="float" nodename="fractal2d_10" />
      <input name="in2" type="float" nodename="fractal2d_27" />
    </add>
    <rotate2d name="rotate2d_29" type="vector2">
      <input name="in" type="vector2" nodename="uv" />
      <input name="amount" type="float" value="31" />
