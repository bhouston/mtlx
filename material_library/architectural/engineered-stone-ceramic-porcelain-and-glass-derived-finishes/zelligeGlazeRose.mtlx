    <multiply name="multiply_30" type="vector2">
      <input name="in1" type="vector2" nodename="rotate2d_29" />
      <input name="in2" type="float" value="210" />
    </multiply>
    <add name="add_31" type="vector2">
      <input name="in1" type="vector2" nodename="multiply_30" />
      <input name="in2" type="vector2" value="71.2153846, 30.5976923" />
    </add>
    <worleynoise2d name="worleynoise2d_32" type="float">
      <input name="texcoord" type="vector2" nodename="add_31" />
      <input name="jitter" type="float" value="0.55" />
    </worleynoise2d>
    <smoothstep name="smoothstep_33" type="float">
      <input name="in" type="float" nodename="worleynoise2d_32" />
      <input name="low" type="float" value="0.0285" />
      <input name="high" type="float" value="0.19" />
    </smoothstep>
    <subtract name="subtract_34" type="float">
      <input name="in1" type="float" value="1" />
      <input name="in2" type="float" nodename="smoothstep_33" />
    </subtract>
    <multiply name="multiply_35" type="float">
      <input name="in1" type="float" nodename="subtract_34" />
      <input name="in2" type="float" value="-1.2e-05" />
    </multiply>
    <add name="add_36" type="float">
      <input name="in1" type="float" nodename="add_28" />
      <input name="in2" type="float" nodename="multiply_35" />
    </add>
    <mix name="mix_37" type="float">
      <input name="bg" type="float" value="0.07" />
      <input name="fg" type="float" value="0.22" />
      <input name="mix" type="float" nodename="clamp_22" />
    </mix>
    <multiply name="height_mm" type="float">
      <input name="in1" type="float" nodename="add_36" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <multiply name="uv_mm" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <heighttonormal name="n_tangent" type="vector3">
      <input name="in" type="float" nodename="height_mm" />
      <input name="scale" type="float" value="16" />
      <input name="texcoord" type="vector2" nodename="uv_mm" />
    </heighttonormal>
    <normalmap name="n_world" type="vector3">
      <input name="in" type="vector3" nodename="n_tangent" />
    </normalmap>
    <constant name="metalness" type="float">
      <input name="value" type="float" value="0" />
    </constant>
    <output name="base_color_out" type="color3" nodename="multiply_24" />
    <output name="roughness_out" type="float" nodename="mix_37" />
    <output name="metalness_out" type="float" nodename="metalness" />
    <output name="normal_out" type="vector3" nodename="n_world" />
    <output name="coat_normal_out" type="vector3" nodename="n_world" />
  </nodegraph>
  <standard_surface name="SR_zelligeGlazeRose" type="surfaceshader">
    <input name="base" type="float" value="1" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="base_color" type="color3" nodegraph="NG_zelligeGlazeRose" output="base_color_out" />
    <input name="specular_roughness" type="float" nodegraph="NG_zelligeGlazeRose" output="roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_zelligeGlazeRose" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_zelligeGlazeRose" output="normal_out" />
    <input name="coat_normal" type="vector3" nodegraph="NG_zelligeGlazeRose" output="coat_normal_out" />
    <input name="coat" type="float" value="0.35" />
    <input name="coat_roughness" type="float" value="0.1" />
  </standard_surface>
  <surfacematerial name="M_zelligeGlazeRose" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_zelligeGlazeRose" />
  </surfacematerial>
</materialx>