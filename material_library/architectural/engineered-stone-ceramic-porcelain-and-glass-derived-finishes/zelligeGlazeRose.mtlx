<?xml version='1.0' encoding='utf-8'?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Rose; handmade-look glaze with pooled pigment, pinholes, and locally uneven gloss; no tile shapes or layout included. -->
  <!-- Authored linear Rec.709 art target; not a calibrated manufacturer sample. Regenerate with authoring/generate-mineral-wood.py. -->
  <nodegraph name="NG_zelligeGlazeRose">
    <texcoord name="uv" type="vector2" />
    <!-- Metric UVs: one UV unit = one metre. Height values below are metres. -->
    <multiply name="multiply_1" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="float" value="3.1" />
    </multiply>
    <add name="add_2" type="vector2">
      <input name="in1" type="vector2" nodename="multiply_1" />
      <input name="in2" type="vector2" value="49.3153846, 16.6976923" />
    </add>
    <fractal2d name="fractal2d_3" type="float">
      <input name="texcoord" type="vector2" nodename="add_2" />
      <input name="amplitude" type="float" value="1" />
      <input name="octaves" type="integer" value="3" />
      <input name="lacunarity" type="float" value="2.03" />
      <input name="diminish" type="float" value="0.5" />
    </fractal2d>
    <multiply name="multiply_4" type="float">
      <input name="in1" type="float" nodename="fractal2d_3" />
      <input name="in2" type="float" value="0.6" />
    </multiply>
    <add name="add_5" type="float">
      <input name="in1" type="float" nodename="multiply_4" />
      <input name="in2" type="float" value="0.5" />
    </add>
    <clamp name="clamp_6" type="float">
      <input name="in" type="float" nodename="add_5" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" value="1" />
    </clamp>
    <rotate2d name="rotate2d_7" type="vector2">
      <input name="in" type="vector2" nodename="uv" />
      <input name="amount" type="float" value="31" />
    </rotate2d>
    <multiply name="multiply_8" type="vector2">
      <input name="in1" type="vector2" nodename="rotate2d_7" />
      <input name="in2" type="float" value="500" />
    </multiply>
    <add name="add_9" type="vector2">
      <input name="in1" type="vector2" nodename="multiply_8" />
      <input name="in2" type="vector2" value="52.9153846, 20.0976923" />
    </add>
    <fractal2d name="fractal2d_10" type="float">
      <input name="texcoord" type="vector2" nodename="add_9" />
      <input name="amplitude" type="float" value="3e-06" />
      <input name="octaves" type="integer" value="2" />
      <input name="lacunarity" type="float" value="2.03" />
      <input name="diminish" type="float" value="0.5" />
    </fractal2d>
    <mix name="mix_11" type="float">
      <input name="bg" type="float" value="0.975" />
      <input name="fg" type="float" value="1.025" />
      <input name="mix" type="float" nodename="clamp_6" />
    </mix>
    <multiply name="multiply_12" type="color3">
      <input name="in1" type="color3" value="0.48, 0.23, 0.21" />
      <input name="in2" type="float" nodename="mix_11" />
    </multiply>
    <multiply name="multiply_17" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="9, 16" />
    </multiply>
    <add name="add_18" type="vector2">
      <input name="in1" type="vector2" nodename="multiply_17" />
      <input name="in2" type="vector2" value="44.9853846, 24.0076923" />
    </add>
    <fractal2d name="fractal2d_19" type="float">
      <input name="texcoord" type="vector2" nodename="add_18" />
      <input name="amplitude" type="float" value="1" />
      <input name="octaves" type="integer" value="3" />
      <input name="lacunarity" type="float" value="2.03" />
      <input name="diminish" type="float" value="0.5" />
    </fractal2d>
    <multiply name="multiply_20" type="float">
      <input name="in1" type="float" nodename="fractal2d_19" />
      <input name="in2" type="float" value="0.6" />
    </multiply>
    <add name="add_21" type="float">
      <input name="in1" type="float" nodename="multiply_20" />
      <input name="in2" type="float" value="0.5" />
    </add>
    <clamp name="clamp_22" type="float">
      <input name="in" type="float" nodename="add_21" />
      <input name="low" type="float" value="0" />
