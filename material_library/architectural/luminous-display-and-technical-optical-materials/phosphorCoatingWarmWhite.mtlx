<?xml version="1.0" encoding="UTF-8"?>
<materialx version="1.39" colorspace="lin_rec709" doc="Pale yellow phosphor-bearing coating that emits warm white light under excitation, with a fine matte non-emitting surface appearance. Recipe: powder. diffuser molded skin 5 mm/2 micrometres; silicon crystal color domains 20 mm; thin-film thicknesses in nm; emission strength explicit. Excitation is external: emission_strength defaults to 0; drive it from a scene excitation model to activate glow. All colors are art-directed scene-linear Rec.709, not calibrated manufacturer measurements. UV 0–1 = 1 metre; height in metres. Relief is filtered surface appearance, not silhouette geometry.">
  <nodegraph name="NG_phosphorCoatingWarmWhite">
    <texcoord name="uv" type="vector2">
      <input name="index" type="integer" value="0" />
    </texcoord>
    <multiply name="grains_scale" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="200, 200" />
    </multiply>
    <rotate2d name="grains_rotate" type="vector2">
      <input name="in" type="vector2" nodename="grains_scale" />
      <input name="amount" type="float" value="17" />
    </rotate2d>
    <add name="grains_offset" type="vector2">
      <input name="in1" type="vector2" nodename="grains_rotate" />
      <input name="in2" type="vector2" value="21.3, 7.9" />
    </add>
    <worleynoise2d name="grains_distance" type="float">
      <input name="texcoord" type="vector2" nodename="grains_offset" />
      <input name="jitter" type="float" value="0.6" />
    </worleynoise2d>
    <smoothstep name="grains_edge" type="float">
      <input name="in" type="float" nodename="grains_distance" />
      <input name="low" type="float" value="0.025" />
      <input name="high" type="float" value="0.19" />
    </smoothstep>
    <subtract name="grains" type="float">
      <input name="in1" type="float" value="1" />
      <input name="in2" type="float" nodename="grains_edge" />
    </subtract>
    <multiply name="grain_height" type="float">
      <input name="in1" type="float" nodename="grains" />
      <input name="in2" type="float" value="8e-06" />
    </multiply>
    <multiply name="tone_drift_noise_scale" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="3.7, 4.9" />
    </multiply>
    <add name="tone_drift_noise_offset" type="vector2">
      <input name="in1" type="vector2" nodename="tone_drift_noise_scale" />
      <input name="in2" type="vector2" value="15.1, 9.7" />
    </add>
    <fractal2d name="tone_drift_noise" type="float">
      <input name="texcoord" type="vector2" nodename="tone_drift_noise_offset" />
      <input name="amplitude" type="float" value="1" />
      <input name="octaves" type="integer" value="2" />
    </fractal2d>
    <multiply name="tone_drift_gain" type="float">
      <input name="in1" type="float" nodename="tone_drift_noise" />
      <input name="in2" type="float" value="0.6" />
    </multiply>
    <add name="tone_drift_bias" type="float">
      <input name="in1" type="float" nodename="tone_drift_gain" />
      <input name="in2" type="float" value="0.5" />
    </add>
    <clamp name="tone_drift" type="float">
      <input name="in" type="float" nodename="tone_drift_bias" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" value="1" />
    </clamp>
    <mix name="pigment_variation" type="float">
      <input name="bg" type="float" value="0.995" />
      <input name="fg" type="float" value="1.005" />
      <input name="mix" type="float" nodename="grains" />
    </mix>
    <multiply name="micro_color" type="color3">
      <input name="in1" type="color3" value="0.74, 0.65, 0.3" />
      <input name="in2" type="float" nodename="pigment_variation" />
    </multiply>
    <mix name="macro_pigment" type="float">
      <input name="bg" type="float" value="0.9985" />
      <input name="fg" type="float" value="1.0015" />
      <input name="mix" type="float" nodename="tone_drift" />
    </mix>
    <multiply name="base_color" type="color3">
      <input name="in1" type="color3" nodename="micro_color" />
      <input name="in2" type="float" nodename="macro_pigment" />
    </multiply>
    <mix name="roughness" type="float">
      <input name="bg" type="float" value="0.87" />
      <input name="fg" type="float" value="0.93" />
      <input name="mix" type="float" nodename="grains" />
    </mix>
    <constant name="metalness" type="float">
      <input name="value" type="float" value="0" />
    </constant>
    <add name="height" type="float">
      <input name="in1" type="float" nodename="grain_height" />
      <input name="in2" type="float" value="0" />
    </add>
    <multiply name="uv_mm" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <multiply name="height_mm" type="float">
      <input name="in1" type="float" nodename="height" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <heighttonormal name="n_tangent" type="vector3">
      <input name="in" type="float" nodename="height_mm" />
      <input name="scale" type="float" value="16" />
      <input name="texcoord" type="vector2" nodename="uv_mm" />
    </heighttonormal>
    <normalmap name="n_world" type="vector3">
      <input name="in" type="vector3" nodename="n_tangent" />
    </normalmap>
    <constant name="base" type="float">
      <input name="value" type="float" value="1" />
    </constant>
    <constant name="specular" type="float">
      <input name="value" type="float" value="0.5" />
    </constant>
    <constant name="specular_IOR" type="float">
      <input name="value" type="float" value="1.5" />
    </constant>
    <constant name="diffuse_roughness" type="float">
      <input name="value" type="float" value="0.25" />
    </constant>
    <constant name="emission_strength" type="float">
      <input name="value" type="float" value="0" />
    </constant>
    <constant name="emission_color" type="color3">
      <input name="value" type="color3" value="1, 0.68, 0.37" />
    </constant>
    <output name="out_base_color" type="color3" nodename="base_color" />
    <output name="out_roughness" type="float" nodename="roughness" />
    <output name="out_metalness" type="float" nodename="metalness" />
    <output name="out_normal" type="vector3" nodename="n_world" />
    <output name="out_base" type="float" nodename="base" />
    <output name="out_specular" type="float" nodename="specular" />
    <output name="out_specular_IOR" type="float" nodename="specular_IOR" />
    <output name="out_diffuse_roughness" type="float" nodename="diffuse_roughness" />
    <output name="out_emission_strength" type="float" nodename="emission_strength" />
    <output name="out_emission_color" type="color3" nodename="emission_color" />
  </nodegraph>
  <standard_surface name="SR_phosphorCoatingWarmWhite" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_phosphorCoatingWarmWhite" output="out_base_color" />
    <input name="specular_roughness" type="float" nodegraph="NG_phosphorCoatingWarmWhite" output="out_roughness" />
    <input name="metalness" type="float" nodegraph="NG_phosphorCoatingWarmWhite" output="out_metalness" />
    <input name="normal" type="vector3" nodegraph="NG_phosphorCoatingWarmWhite" output="out_normal" />
    <input name="base" type="float" nodegraph="NG_phosphorCoatingWarmWhite" output="out_base" />
    <input name="specular" type="float" nodegraph="NG_phosphorCoatingWarmWhite" output="out_specular" />
    <input name="specular_IOR" type="float" nodegraph="NG_phosphorCoatingWarmWhite" output="out_specular_IOR" />
    <input name="diffuse_roughness" type="float" nodegraph="NG_phosphorCoatingWarmWhite" output="out_diffuse_roughness" />
    <input name="emission" type="float" nodegraph="NG_phosphorCoatingWarmWhite" output="out_emission_strength" />
    <input name="emission_color" type="color3" nodegraph="NG_phosphorCoatingWarmWhite" output="out_emission_color" />
  </standard_surface>
  <surfacematerial name="M_phosphorCoatingWarmWhite" type="material" doc="Pale yellow phosphor-bearing coating that emits warm white light under excitation, with a fine matte non-emitting surface appearance.">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_phosphorCoatingWarmWhite" />
  </surfacematerial>
</materialx>
