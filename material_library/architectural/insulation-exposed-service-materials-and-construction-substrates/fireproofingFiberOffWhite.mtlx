<?xml version="1.0" encoding="UTF-8"?>
<materialx version="1.39" colorspace="lin_rec709" doc="Off-white sprayed mineral fibers with fuzzy irregular microtexture and matte reflection. Recipe: fiber. bonded fiber bundles 2.6 mm across/55 mm long; 65 micrometre relief; foam cells 2.5–5.9 mm, 0.08–0.16 mm relief; foil wrinkles 28 mm/0.18 mm. All colors are art-directed scene-linear Rec.709, not calibrated manufacturer measurements. UV 0–1 = 1 metre; height in metres. Relief is filtered surface appearance, not silhouette geometry.">
  <nodegraph name="NG_fireproofingFiberOffWhite">
    <texcoord name="uv" type="vector2">
      <input name="index" type="integer" value="0" />
    </texcoord>
    <multiply name="fibers_a_scale" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="18, 390" />
    </multiply>
    <rotate2d name="fibers_a_rotate" type="vector2">
      <input name="in" type="vector2" nodename="fibers_a_scale" />
      <input name="amount" type="float" value="11" />
    </rotate2d>
    <add name="fibers_a_offset" type="vector2">
      <input name="in1" type="vector2" nodename="fibers_a_rotate" />
      <input name="in2" type="vector2" value="3.71, 8.29" />
    </add>
    <fractal2d name="fibers_a" type="float">
      <input name="texcoord" type="vector2" nodename="fibers_a_offset" />
      <input name="amplitude" type="float" value="6.5e-05" />
      <input name="octaves" type="integer" value="1" />
    </fractal2d>
    <multiply name="fibers_b_scale" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="390, 18" />
    </multiply>
    <rotate2d name="fibers_b_rotate" type="vector2">
      <input name="in" type="vector2" nodename="fibers_b_scale" />
      <input name="amount" type="float" value="-31" />
    </rotate2d>
    <add name="fibers_b_offset" type="vector2">
      <input name="in1" type="vector2" nodename="fibers_b_rotate" />
      <input name="in2" type="vector2" value="19.4, 31.7" />
    </add>
    <fractal2d name="fibers_b" type="float">
      <input name="texcoord" type="vector2" nodename="fibers_b_offset" />
      <input name="amplitude" type="float" value="3.575e-05" />
      <input name="octaves" type="integer" value="1" />
    </fractal2d>
    <add name="fibers" type="float">
      <input name="in1" type="float" nodename="fibers_a" />
      <input name="in2" type="float" nodename="fibers_b" />
    </add>
    <multiply name="fiber_tone_scale" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="18, 390" />
    </multiply>
    <rotate2d name="fiber_tone_rotate" type="vector2">
      <input name="in" type="vector2" nodename="fiber_tone_scale" />
      <input name="amount" type="float" value="11" />
    </rotate2d>
    <add name="fiber_tone_offset" type="vector2">
      <input name="in1" type="vector2" nodename="fiber_tone_rotate" />
      <input name="in2" type="vector2" value="3.71, 8.29" />
    </add>
    <fractal2d name="fiber_tone" type="float">
      <input name="texcoord" type="vector2" nodename="fiber_tone_offset" />
      <input name="amplitude" type="float" value="1" />
      <input name="octaves" type="integer" value="1" />
    </fractal2d>
    <multiply name="fiber_mask_gain" type="float">
      <input name="in1" type="float" nodename="fiber_tone" />
      <input name="in2" type="float" value="0.6" />
    </multiply>
    <add name="fiber_mask_bias" type="float">
      <input name="in1" type="float" nodename="fiber_mask_gain" />
      <input name="in2" type="float" value="0.5" />
    </add>
    <clamp name="fiber_mask" type="float">
      <input name="in" type="float" nodename="fiber_mask_bias" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" value="1" />
    </clamp>
    <multiply name="tone_drift_noise_scale" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="3.7, 4.9" />
    </multiply>
    <add name="tone_drift_noise_offset" type="vector2">
      <input name="in1" type="vector2" nodename="tone_drift_noise_scale" />
      <input name="in2" type="vector2" value="15.1, 9.7" />
    </add>
    <fractal2d name="tone_drift_noise" type="float">
      <input name="texcoord" type="vector2" nodename="tone_drift_noise_offset" />
      <input name="amplitude" type="float" value="1" />
      <input name="octaves" type="integer" value="2" />
    </fractal2d>
    <multiply name="tone_drift_gain" type="float">
      <input name="in1" type="float" nodename="tone_drift_noise" />
      <input name="in2" type="float" value="0.6" />
    </multiply>
    <add name="tone_drift_bias" type="float">
      <input name="in1" type="float" nodename="tone_drift_gain" />
      <input name="in2" type="float" value="0.5" />
    </add>
    <clamp name="tone_drift" type="float">
      <input name="in" type="float" nodename="tone_drift_bias" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" value="1" />
    </clamp>
    <mix name="pigment_variation" type="float">
      <input name="bg" type="float" value="0.9" />
      <input name="fg" type="float" value="1.1" />
      <input name="mix" type="float" nodename="fiber_mask" />
    </mix>
    <multiply name="micro_color" type="color3">
      <input name="in1" type="color3" value="0.72, 0.7, 0.65" />
      <input name="in2" type="float" nodename="pigment_variation" />
    </multiply>
    <mix name="macro_pigment" type="float">
      <input name="bg" type="float" value="0.97" />
      <input name="fg" type="float" value="1.03" />
      <input name="mix" type="float" nodename="tone_drift" />
    </mix>
    <multiply name="base_color" type="color3">
      <input name="in1" type="color3" nodename="micro_color" />
      <input name="in2" type="float" nodename="macro_pigment" />
    </multiply>
    <mix name="roughness" type="float">
      <input name="bg" type="float" value="0.88" />
      <input name="fg" type="float" value="0.94" />
      <input name="mix" type="float" nodename="fiber_mask" />
    </mix>
    <constant name="metalness" type="float">
      <input name="value" type="float" value="0" />
    </constant>
    <add name="height" type="float">
      <input name="in1" type="float" nodename="fibers" />
      <input name="in2" type="float" value="0" />
    </add>
    <multiply name="uv_mm" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <multiply name="height_mm" type="float">
      <input name="in1" type="float" nodename="height" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <heighttonormal name="n_tangent" type="vector3">
      <input name="in" type="float" nodename="height_mm" />
      <input name="scale" type="float" value="16" />
      <input name="texcoord" type="vector2" nodename="uv_mm" />
    </heighttonormal>
    <normalmap name="n_world" type="vector3">
      <input name="in" type="vector3" nodename="n_tangent" />
    </normalmap>
    <constant name="base" type="float">
      <input name="value" type="float" value="1" />
    </constant>
    <constant name="specular" type="float">
      <input name="value" type="float" value="0.2" />
    </constant>
    <constant name="specular_IOR" type="float">
      <input name="value" type="float" value="1.5" />
    </constant>
    <constant name="diffuse_roughness" type="float">
      <input name="value" type="float" value="0.25" />
    </constant>
    <constant name="sheen" type="float">
      <input name="value" type="float" value="0.22" />
    </constant>
    <constant name="sheen_color" type="color3">
      <input name="value" type="color3" value="0.93, 0.905, 0.8425" />
    </constant>
    <constant name="sheen_roughness" type="float">
      <input name="value" type="float" value="0.7" />
    </constant>
    <output name="out_base_color" type="color3" nodename="base_color" />
    <output name="out_roughness" type="float" nodename="roughness" />
    <output name="out_metalness" type="float" nodename="metalness" />
    <output name="out_normal" type="vector3" nodename="n_world" />
    <output name="out_base" type="float" nodename="base" />
    <output name="out_specular" type="float" nodename="specular" />
    <output name="out_specular_IOR" type="float" nodename="specular_IOR" />
    <output name="out_diffuse_roughness" type="float" nodename="diffuse_roughness" />
    <output name="out_sheen" type="float" nodename="sheen" />
    <output name="out_sheen_color" type="color3" nodename="sheen_color" />
    <output name="out_sheen_roughness" type="float" nodename="sheen_roughness" />
  </nodegraph>
  <standard_surface name="SR_fireproofingFiberOffWhite" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_fireproofingFiberOffWhite" output="out_base_color" />
    <input name="specular_roughness" type="float" nodegraph="NG_fireproofingFiberOffWhite" output="out_roughness" />
    <input name="metalness" type="float" nodegraph="NG_fireproofingFiberOffWhite" output="out_metalness" />
    <input name="normal" type="vector3" nodegraph="NG_fireproofingFiberOffWhite" output="out_normal" />
    <input name="base" type="float" nodegraph="NG_fireproofingFiberOffWhite" output="out_base" />
    <input name="specular" type="float" nodegraph="NG_fireproofingFiberOffWhite" output="out_specular" />
    <input name="specular_IOR" type="float" nodegraph="NG_fireproofingFiberOffWhite" output="out_specular_IOR" />
    <input name="diffuse_roughness" type="float" nodegraph="NG_fireproofingFiberOffWhite" output="out_diffuse_roughness" />
    <input name="sheen" type="float" nodegraph="NG_fireproofingFiberOffWhite" output="out_sheen" />
    <input name="sheen_color" type="color3" nodegraph="NG_fireproofingFiberOffWhite" output="out_sheen_color" />
    <input name="sheen_roughness" type="float" nodegraph="NG_fireproofingFiberOffWhite" output="out_sheen_roughness" />
  </standard_surface>
  <surfacematerial name="M_fireproofingFiberOffWhite" type="material" doc="Off-white sprayed mineral fibers with fuzzy irregular microtexture and matte reflection.">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_fireproofingFiberOffWhite" />
  </surfacematerial>
</materialx>
