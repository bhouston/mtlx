<?xml version='1.0' encoding='utf-8'?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Catalog: Light gray; dense nylon fiber surface with fine loop-scale texture, slightly brighter fiber highlights, and directional nap; no flooring layout included. -->
  <!-- Art-directed linear Rec.709; 1 UV = 1 m; height in m. Surface-scale fiber and sheen model; actual pile silhouettes and self-shadowing require geometry. Fine fibers are intended for closeup/detail views and may need filtering at distance. -->
  <!-- Recipe loops: feature frequencies 400, 400 per m; relief amplitude 9e-05 m; macro drift about 0.25 m. Subpixel detail requires filtering at distance. -->
  <nodegraph name="NG_carpetNylonLightGrayLoopPile">
    <texcoord name="uv" type="vector2">
      <input name="index" type="integer" value="0" />
    </texcoord>
    <multiply name="multiply_2" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="3.1, 4.3" />
    </multiply>
    <add name="add_3" type="vector2">
      <input name="in1" type="vector2" nodename="multiply_2" />
      <input name="in2" type="vector2" value="11.37, 29.17" />
    </add>
    <fractal2d name="fractal2d_4" type="float">
      <input name="texcoord" type="vector2" nodename="add_3" />
      <input name="octaves" type="integer" value="3" />
    </fractal2d>
    <multiply name="multiply_12" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="400, 400" />
    </multiply>
    <add name="add_13" type="vector2">
      <input name="in1" type="vector2" nodename="multiply_12" />
      <input name="in2" type="vector2" value="5.81, 17.37" />
    </add>
    <worleynoise2d name="worleynoise2d_14" type="float">
      <input name="texcoord" type="vector2" nodename="add_13" />
      <input name="jitter" type="float" value="0.85" />
      <input name="style" type="integer" value="0" />
    </worleynoise2d>
    <smoothstep name="smoothstep_15" type="float">
      <input name="in" type="float" nodename="worleynoise2d_14" />
      <input name="low" type="float" value="0.05" />
      <input name="high" type="float" value="0.48" />
    </smoothstep>
    <subtract name="subtract_16" type="float">
      <input name="in1" type="float" value="1" />
      <input name="in2" type="float" nodename="smoothstep_15" />
    </subtract>
    <multiply name="multiply_17" type="float">
      <input name="in1" type="float" nodename="subtract_16" />
      <input name="in2" type="float" value="9e-05" />
    </multiply>
    <multiply name="multiply_18" type="float">
      <input name="in1" type="float" nodename="fractal2d_4" />
      <input name="in2" type="float" value="0.0448" />
    </multiply>
    <add name="add_19" type="float">
      <input name="in1" type="float" value="1" />
      <input name="in2" type="float" nodename="multiply_18" />
    </add>
    <mix name="mix_20" type="color3">
      <input name="bg" type="color3" value="0.4116, 0.4116, 0.4032" />
      <input name="fg" type="color3" value="0.5684, 0.5684, 0.5568" />
      <input name="mix" type="float" nodename="subtract_16" />
    </mix>
    <multiply name="base_color" type="color3">
      <input name="in1" type="color3" nodename="mix_20" />
      <input name="in2" type="float" nodename="add_19" />
    </multiply>
    <subtract name="subtract_22" type="float">
      <input name="in1" type="float" nodename="subtract_16" />
      <input name="in2" type="float" value="0.5" />
    </subtract>
    <multiply name="multiply_23" type="float">
      <input name="in1" type="float" nodename="subtract_22" />
      <input name="in2" type="float" value="-0.12" />
    </multiply>
    <add name="add_24" type="float">
      <input name="in1" type="float" value="0.92" />
      <input name="in2" type="float" nodename="multiply_23" />
    </add>
    <clamp name="roughness" type="float">
      <input name="in" type="float" nodename="add_24" />
      <input name="low" type="float" value="0.005" />
      <input name="high" type="float" value="1" />
    </clamp>
    <constant name="metalness" type="float">
      <input name="value" type="float" value="0" />
    </constant>
    <multiply name="multiply_27" type="float">
      <input name="in1" type="float" nodename="fractal2d_4" />
      <input name="in2" type="float" value="2.25e-05" />
    </multiply>
    <add name="height" type="float">
      <input name="in1" type="float" nodename="multiply_17" />
      <input name="in2" type="float" nodename="multiply_27" />
    </add>
    <multiply name="uv_mm" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <multiply name="height_mm" type="float">
      <input name="in1" type="float" nodename="height" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <heighttonormal name="n_tangent" type="vector3">
      <input name="in" type="float" nodename="height_mm" />
      <input name="scale" type="float" value="16" />
      <input name="texcoord" type="vector2" nodename="uv_mm" />
    </heighttonormal>
    <normalmap name="n_world" type="vector3">
      <input name="in" type="vector3" nodename="n_tangent" />
    </normalmap>
    <output name="out_base_color" type="color3" nodename="base_color" />
    <output name="out_roughness" type="float" nodename="roughness" />
    <output name="out_metalness" type="float" nodename="metalness" />
    <output name="out_normal" type="vector3" nodename="n_world" />
    <constant name="specular_weight" type="float">
      <input name="value" type="float" value="0.2" />
    </constant>
    <output name="out_specular" type="float" nodename="specular_weight" />
  </nodegraph>
  <standard_surface name="SR_carpetNylonLightGrayLoopPile" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_carpetNylonLightGrayLoopPile" output="out_base_color" />
    <input name="specular_roughness" type="float" nodegraph="NG_carpetNylonLightGrayLoopPile" output="out_roughness" />
    <input name="metalness" type="float" nodegraph="NG_carpetNylonLightGrayLoopPile" output="out_metalness" />
    <input name="normal" type="vector3" nodegraph="NG_carpetNylonLightGrayLoopPile" output="out_normal" />
    <input name="specular" type="float" nodegraph="NG_carpetNylonLightGrayLoopPile" output="out_specular" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="sheen" type="float" value="0.4" />
    <input name="sheen_color" type="color3" value="0.677, 0.677, 0.664" />
    <input name="sheen_roughness" type="float" value="0.8" />
  </standard_surface>
  <surfacematerial name="carpetNylonLightGrayLoopPile" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_carpetNylonLightGrayLoopPile" />
  </surfacematerial>
</materialx>