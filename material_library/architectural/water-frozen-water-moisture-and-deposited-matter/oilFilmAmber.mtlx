<?xml version="1.0" encoding="UTF-8"?>
<materialx version="1.39" colorspace="lin_rec709" doc="Transparent amber oil with smooth glossy reflection, warm volume absorption, and optional thin-film interference at very low thickness. Recipe: smooth. powder/crystal grains 1–2 mm, 20–50 micrometre relief; liquid surface flat, motion excluded; absorption depth 4 mm oil to 2 m pool water. Optional interference is disabled at thin_film_thickness=0 nm; enable only at appropriate film thickness. Requires renderer support for refraction, Beer-Lambert transmission_depth, and volume/scattering inputs; opacity remains 1. Closed solids need physical thickness. Thin films use thin_walled where stated. All colors are art-directed scene-linear Rec.709, not calibrated manufacturer measurements. UV 0–1 = 1 metre; height in metres. Relief is filtered surface appearance, not silhouette geometry.">
  <nodegraph name="NG_oilFilmAmber">
    <texcoord name="uv" type="vector2">
      <input name="index" type="integer" value="0" />
    </texcoord>
    <multiply name="surface_skin_scale" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="450, 450" />
    </multiply>
    <add name="surface_skin_offset" type="vector2">
      <input name="in1" type="vector2" nodename="surface_skin_scale" />
      <input name="in2" type="vector2" value="3.71, 8.29" />
    </add>
    <fractal2d name="surface_skin" type="float">
      <input name="texcoord" type="vector2" nodename="surface_skin_offset" />
      <input name="amplitude" type="float" value="0" />
      <input name="octaves" type="integer" value="2" />
    </fractal2d>
    <multiply name="skin_tone_scale" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="450, 450" />
    </multiply>
    <add name="skin_tone_offset" type="vector2">
      <input name="in1" type="vector2" nodename="skin_tone_scale" />
      <input name="in2" type="vector2" value="3.71, 8.29" />
    </add>
    <fractal2d name="skin_tone" type="float">
      <input name="texcoord" type="vector2" nodename="skin_tone_offset" />
      <input name="amplitude" type="float" value="1" />
      <input name="octaves" type="integer" value="2" />
    </fractal2d>
    <multiply name="skin_mask_gain" type="float">
      <input name="in1" type="float" nodename="skin_tone" />
      <input name="in2" type="float" value="0.6" />
    </multiply>
    <add name="skin_mask_bias" type="float">
      <input name="in1" type="float" nodename="skin_mask_gain" />
      <input name="in2" type="float" value="0.5" />
    </add>
    <clamp name="skin_mask" type="float">
      <input name="in" type="float" nodename="skin_mask_bias" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" value="1" />
    </clamp>
    <multiply name="tone_drift_noise_scale" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="3.7, 4.9" />
    </multiply>
    <add name="tone_drift_noise_offset" type="vector2">
      <input name="in1" type="vector2" nodename="tone_drift_noise_scale" />
      <input name="in2" type="vector2" value="15.1, 9.7" />
    </add>
    <fractal2d name="tone_drift_noise" type="float">
      <input name="texcoord" type="vector2" nodename="tone_drift_noise_offset" />
      <input name="amplitude" type="float" value="1" />
      <input name="octaves" type="integer" value="2" />
    </fractal2d>
    <multiply name="tone_drift_gain" type="float">
      <input name="in1" type="float" nodename="tone_drift_noise" />
      <input name="in2" type="float" value="0.6" />
    </multiply>
    <add name="tone_drift_bias" type="float">
      <input name="in1" type="float" nodename="tone_drift_gain" />
      <input name="in2" type="float" value="0.5" />
    </add>
    <clamp name="tone_drift" type="float">
      <input name="in" type="float" nodename="tone_drift_bias" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" value="1" />
    </clamp>
    <mix name="pigment_variation" type="float">
      <input name="bg" type="float" value="1" />
      <input name="fg" type="float" value="1" />
      <input name="mix" type="float" nodename="skin_mask" />
    </mix>
    <multiply name="micro_color" type="color3">
      <input name="in1" type="color3" value="0.6, 0.28, 0.045" />
      <input name="in2" type="float" nodename="pigment_variation" />
    </multiply>
    <mix name="macro_pigment" type="float">
      <input name="bg" type="float" value="1" />
      <input name="fg" type="float" value="1" />
      <input name="mix" type="float" nodename="tone_drift" />
    </mix>
    <multiply name="base_color" type="color3">
      <input name="in1" type="color3" nodename="micro_color" />
      <input name="in2" type="float" nodename="macro_pigment" />
    </multiply>
    <mix name="roughness" type="float">
      <input name="bg" type="float" value="0.018" />
      <input name="fg" type="float" value="0.018" />
      <input name="mix" type="float" nodename="skin_mask" />
    </mix>
    <constant name="metalness" type="float">
      <input name="value" type="float" value="0" />
    </constant>
    <add name="height" type="float">
      <input name="in1" type="float" nodename="surface_skin" />
      <input name="in2" type="float" value="0" />
    </add>
    <multiply name="uv_mm" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <multiply name="height_mm" type="float">
      <input name="in1" type="float" nodename="height" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <heighttonormal name="n_tangent" type="vector3">
      <input name="in" type="float" nodename="height_mm" />
      <input name="scale" type="float" value="16" />
      <input name="texcoord" type="vector2" nodename="uv_mm" />
    </heighttonormal>
    <normalmap name="n_world" type="vector3">
      <input name="in" type="vector3" nodename="n_tangent" />
    </normalmap>
    <constant name="base" type="float">
      <input name="value" type="float" value="0" />
    </constant>
    <constant name="specular" type="float">
      <input name="value" type="float" value="0.5" />
    </constant>
    <constant name="specular_IOR" type="float">
      <input name="value" type="float" value="1.47" />
    </constant>
    <constant name="diffuse_roughness" type="float">
      <input name="value" type="float" value="0.25" />
    </constant>
    <constant name="transmission" type="float">
      <input name="value" type="float" value="1" />
    </constant>
    <constant name="transmission_color" type="color3">
      <input name="value" type="color3" value="0.87, 0.52, 0.13" />
    </constant>
    <constant name="transmission_depth" type="float">
      <input name="value" type="float" value="0.004" />
    </constant>
    <constant name="thin_film_thickness" type="float">
      <input name="value" type="float" value="0" />
    </constant>
    <constant name="thin_film_IOR" type="float">
      <input name="value" type="float" value="1.47" />
    </constant>
    <output name="out_base_color" type="color3" nodename="base_color" />
    <output name="out_roughness" type="float" nodename="roughness" />
    <output name="out_metalness" type="float" nodename="metalness" />
    <output name="out_normal" type="vector3" nodename="n_world" />
    <output name="out_base" type="float" nodename="base" />
    <output name="out_specular" type="float" nodename="specular" />
    <output name="out_specular_IOR" type="float" nodename="specular_IOR" />
    <output name="out_diffuse_roughness" type="float" nodename="diffuse_roughness" />
    <output name="out_transmission" type="float" nodename="transmission" />
    <output name="out_transmission_color" type="color3" nodename="transmission_color" />
    <output name="out_transmission_depth" type="float" nodename="transmission_depth" />
    <output name="out_thin_film_thickness" type="float" nodename="thin_film_thickness" />
    <output name="out_thin_film_IOR" type="float" nodename="thin_film_IOR" />
  </nodegraph>
  <standard_surface name="SR_oilFilmAmber" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_oilFilmAmber" output="out_base_color" />
    <input name="specular_roughness" type="float" nodegraph="NG_oilFilmAmber" output="out_roughness" />
    <input name="metalness" type="float" nodegraph="NG_oilFilmAmber" output="out_metalness" />
    <input name="normal" type="vector3" nodegraph="NG_oilFilmAmber" output="out_normal" />
    <input name="base" type="float" nodegraph="NG_oilFilmAmber" output="out_base" />
    <input name="specular" type="float" nodegraph="NG_oilFilmAmber" output="out_specular" />
    <input name="specular_IOR" type="float" nodegraph="NG_oilFilmAmber" output="out_specular_IOR" />
    <input name="diffuse_roughness" type="float" nodegraph="NG_oilFilmAmber" output="out_diffuse_roughness" />
    <input name="transmission" type="float" nodegraph="NG_oilFilmAmber" output="out_transmission" />
    <input name="transmission_color" type="color3" nodegraph="NG_oilFilmAmber" output="out_transmission_color" />
    <input name="transmission_depth" type="float" nodegraph="NG_oilFilmAmber" output="out_transmission_depth" />
    <input name="thin_film_thickness" type="float" nodegraph="NG_oilFilmAmber" output="out_thin_film_thickness" />
    <input name="thin_film_IOR" type="float" nodegraph="NG_oilFilmAmber" output="out_thin_film_IOR" />
  </standard_surface>
  <surfacematerial name="M_oilFilmAmber" type="material" doc="Transparent amber oil with smooth glossy reflection, warm volume absorption, and optional thin-film interference at very low thickness.">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_oilFilmAmber" />
  </surfacematerial>
</materialx>
