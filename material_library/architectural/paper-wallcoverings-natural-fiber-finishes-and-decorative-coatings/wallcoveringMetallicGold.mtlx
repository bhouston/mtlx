<?xml version="1.0" encoding="UTF-8"?>
<materialx version="1.39" colorspace="lin_rec709" doc="Gold-colored metallic-pigment wallcovering with fine paper texture and softly directional reflective flecks. Recipe: flakes. paper fiber bundles 2.4 mm across/67 mm long, 25 micrometre relief; grasscloth 3.6 mm/0.12 mm; leaf wrinkles 14–18 mm/55 micrometres; flakes &lt;0.8 mm. Pigment flake coverage drives metalness locally; dielectric binder remains nonmetallic. All colors are art-directed scene-linear Rec.709, not calibrated manufacturer measurements. UV 0–1 = 1 metre; height in metres. Relief is filtered surface appearance, not silhouette geometry.">
  <nodegraph name="NG_wallcoveringMetallicGold">
    <texcoord name="uv" type="vector2">
      <input name="index" type="integer" value="0" />
    </texcoord>
    <multiply name="grains_scale" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="480, 480" />
    </multiply>
    <rotate2d name="grains_rotate" type="vector2">
      <input name="in" type="vector2" nodename="grains_scale" />
      <input name="amount" type="float" value="17" />
    </rotate2d>
    <add name="grains_offset" type="vector2">
      <input name="in1" type="vector2" nodename="grains_rotate" />
      <input name="in2" type="vector2" value="21.3, 7.9" />
    </add>
    <worleynoise2d name="grains_distance" type="float">
      <input name="texcoord" type="vector2" nodename="grains_offset" />
      <input name="jitter" type="float" value="0.6" />
    </worleynoise2d>
    <smoothstep name="grains_edge" type="float">
      <input name="in" type="float" nodename="grains_distance" />
      <input name="low" type="float" value="0.025" />
      <input name="high" type="float" value="0.19" />
    </smoothstep>
    <subtract name="grains" type="float">
      <input name="in1" type="float" value="1" />
      <input name="in2" type="float" nodename="grains_edge" />
    </subtract>
    <multiply name="grain_height" type="float">
      <input name="in1" type="float" nodename="grains" />
      <input name="in2" type="float" value="8e-06" />
    </multiply>
    <mix name="base_color" type="color3">
      <input name="bg" type="color3" value="0.83, 0.61, 0.21" />
      <input name="fg" type="color3" value="0.92, 0.7065, 0.2465" />
      <input name="mix" type="float" nodename="grains" />
    </mix>
    <mix name="roughness" type="float">
      <input name="bg" type="float" value="0.49" />
      <input name="fg" type="float" value="0.55" />
      <input name="mix" type="float" nodename="grains" />
    </mix>
    <multiply name="flake_metalness" type="float">
      <input name="in1" type="float" nodename="grains" />
      <input name="in2" type="float" value="0.75" />
    </multiply>
    <add name="height" type="float">
      <input name="in1" type="float" nodename="grain_height" />
      <input name="in2" type="float" value="0" />
    </add>
    <multiply name="uv_mm" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <multiply name="height_mm" type="float">
      <input name="in1" type="float" nodename="height" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <heighttonormal name="n_tangent" type="vector3">
      <input name="in" type="float" nodename="height_mm" />
      <input name="scale" type="float" value="16" />
      <input name="texcoord" type="vector2" nodename="uv_mm" />
    </heighttonormal>
    <normalmap name="n_world" type="vector3">
      <input name="in" type="vector3" nodename="n_tangent" />
    </normalmap>
    <constant name="base" type="float">
      <input name="value" type="float" value="1" />
    </constant>
    <constant name="specular" type="float">
      <input name="value" type="float" value="0.5" />
    </constant>
    <constant name="specular_IOR" type="float">
      <input name="value" type="float" value="1.5" />
    </constant>
    <constant name="diffuse_roughness" type="float">
      <input name="value" type="float" value="0.25" />
    </constant>
    <constant name="coat" type="float">
      <input name="value" type="float" value="0.15" />
    </constant>
    <constant name="coat_roughness" type="float">
      <input name="value" type="float" value="0.12" />
    </constant>
    <output name="out_base_color" type="color3" nodename="base_color" />
    <output name="out_roughness" type="float" nodename="roughness" />
    <output name="out_metalness" type="float" nodename="flake_metalness" />
    <output name="out_normal" type="vector3" nodename="n_world" />
    <output name="out_base" type="float" nodename="base" />
    <output name="out_specular" type="float" nodename="specular" />
    <output name="out_specular_IOR" type="float" nodename="specular_IOR" />
    <output name="out_diffuse_roughness" type="float" nodename="diffuse_roughness" />
    <output name="out_coat" type="float" nodename="coat" />
    <output name="out_coat_roughness" type="float" nodename="coat_roughness" />
  </nodegraph>
  <standard_surface name="SR_wallcoveringMetallicGold" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_wallcoveringMetallicGold" output="out_base_color" />
    <input name="specular_roughness" type="float" nodegraph="NG_wallcoveringMetallicGold" output="out_roughness" />
    <input name="metalness" type="float" nodegraph="NG_wallcoveringMetallicGold" output="out_metalness" />
    <input name="normal" type="vector3" nodegraph="NG_wallcoveringMetallicGold" output="out_normal" />
    <input name="base" type="float" nodegraph="NG_wallcoveringMetallicGold" output="out_base" />
    <input name="specular" type="float" nodegraph="NG_wallcoveringMetallicGold" output="out_specular" />
    <input name="specular_IOR" type="float" nodegraph="NG_wallcoveringMetallicGold" output="out_specular_IOR" />
    <input name="diffuse_roughness" type="float" nodegraph="NG_wallcoveringMetallicGold" output="out_diffuse_roughness" />
    <input name="coat" type="float" nodegraph="NG_wallcoveringMetallicGold" output="out_coat" />
    <input name="coat_roughness" type="float" nodegraph="NG_wallcoveringMetallicGold" output="out_coat_roughness" />
    <input name="coat_normal" type="vector3" nodegraph="NG_wallcoveringMetallicGold" output="out_normal" />
  </standard_surface>
  <surfacematerial name="M_wallcoveringMetallicGold" type="material" doc="Gold-colored metallic-pigment wallcovering with fine paper texture and softly directional reflective flecks.">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_wallcoveringMetallicGold" />
  </surfacematerial>
</materialx>
