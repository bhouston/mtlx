<?xml version="1.0" encoding="UTF-8"?>
<materialx version="1.39" colorspace="lin_rec709" doc="Thin copper metal finish with warm red-orange reflection, fine micro-wrinkles, and subtle oxidation variation. Recipe: foil. paper fiber bundles 2.4 mm across/67 mm long, 25 micrometre relief; grasscloth 3.6 mm/0.12 mm; leaf wrinkles 14–18 mm/55 micrometres; flakes &lt;0.8 mm. All colors are art-directed scene-linear Rec.709, not calibrated manufacturer measurements. UV 0–1 = 1 metre; height in metres. Relief is filtered surface appearance, not silhouette geometry.">
  <nodegraph name="NG_copperLeaf">
    <texcoord name="uv" type="vector2">
      <input name="index" type="integer" value="0" />
    </texcoord>
    <multiply name="coarse_crinkle_scale" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="70, 55" />
    </multiply>
    <add name="coarse_crinkle_offset" type="vector2">
      <input name="in1" type="vector2" nodename="coarse_crinkle_scale" />
      <input name="in2" type="vector2" value="3.71, 8.29" />
    </add>
    <fractal2d name="coarse_crinkle" type="float">
      <input name="texcoord" type="vector2" nodename="coarse_crinkle_offset" />
      <input name="amplitude" type="float" value="5.5e-05" />
      <input name="octaves" type="integer" value="2" />
    </fractal2d>
    <multiply name="fine_crinkle_scale" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="210, 165" />
    </multiply>
    <add name="fine_crinkle_offset" type="vector2">
      <input name="in1" type="vector2" nodename="fine_crinkle_scale" />
      <input name="in2" type="vector2" value="18.3, 2.7" />
    </add>
    <fractal2d name="fine_crinkle" type="float">
      <input name="texcoord" type="vector2" nodename="fine_crinkle_offset" />
      <input name="amplitude" type="float" value="8.8e-06" />
      <input name="octaves" type="integer" value="1" />
    </fractal2d>
    <add name="wrinkles" type="float">
      <input name="in1" type="float" nodename="coarse_crinkle" />
      <input name="in2" type="float" nodename="fine_crinkle" />
    </add>
    <multiply name="foil_drift_scale" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="4, 3" />
    </multiply>
    <add name="foil_drift_offset" type="vector2">
      <input name="in1" type="vector2" nodename="foil_drift_scale" />
      <input name="in2" type="vector2" value="3.71, 8.29" />
    </add>
    <fractal2d name="foil_drift" type="float">
      <input name="texcoord" type="vector2" nodename="foil_drift_offset" />
      <input name="amplitude" type="float" value="1" />
      <input name="octaves" type="integer" value="2" />
    </fractal2d>
    <multiply name="crinkle_tone_gain" type="float">
      <input name="in1" type="float" nodename="foil_drift" />
      <input name="in2" type="float" value="0.6" />
    </multiply>
    <add name="crinkle_tone_bias" type="float">
      <input name="in1" type="float" nodename="crinkle_tone_gain" />
      <input name="in2" type="float" value="0.5" />
    </add>
    <clamp name="crinkle_tone" type="float">
      <input name="in" type="float" nodename="crinkle_tone_bias" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" value="1" />
    </clamp>
    <multiply name="tone_drift_noise_scale" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="3.7, 4.9" />
    </multiply>
    <add name="tone_drift_noise_offset" type="vector2">
      <input name="in1" type="vector2" nodename="tone_drift_noise_scale" />
      <input name="in2" type="vector2" value="15.1, 9.7" />
    </add>
    <fractal2d name="tone_drift_noise" type="float">
      <input name="texcoord" type="vector2" nodename="tone_drift_noise_offset" />
      <input name="amplitude" type="float" value="1" />
      <input name="octaves" type="integer" value="2" />
    </fractal2d>
    <multiply name="tone_drift_gain" type="float">
      <input name="in1" type="float" nodename="tone_drift_noise" />
      <input name="in2" type="float" value="0.6" />
    </multiply>
    <add name="tone_drift_bias" type="float">
      <input name="in1" type="float" nodename="tone_drift_gain" />
      <input name="in2" type="float" value="0.5" />
    </add>
    <clamp name="tone_drift" type="float">
      <input name="in" type="float" nodename="tone_drift_bias" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" value="1" />
    </clamp>
    <mix name="pigment_variation" type="float">
      <input name="bg" type="float" value="0.955" />
      <input name="fg" type="float" value="1.045" />
      <input name="mix" type="float" nodename="crinkle_tone" />
    </mix>
    <multiply name="micro_color" type="color3">
      <input name="in1" type="color3" value="0.95, 0.57, 0.35" />
      <input name="in2" type="float" nodename="pigment_variation" />
    </multiply>
    <mix name="macro_pigment" type="float">
      <input name="bg" type="float" value="0.9865" />
      <input name="fg" type="float" value="1.0135" />
      <input name="mix" type="float" nodename="tone_drift" />
    </mix>
    <multiply name="base_color" type="color3">
      <input name="in1" type="color3" nodename="micro_color" />
      <input name="in2" type="float" nodename="macro_pigment" />
    </multiply>
    <mix name="roughness" type="float">
      <input name="bg" type="float" value="0.18" />
      <input name="fg" type="float" value="0.24" />
      <input name="mix" type="float" nodename="crinkle_tone" />
    </mix>
    <constant name="metalness" type="float">
      <input name="value" type="float" value="1" />
    </constant>
    <add name="height" type="float">
      <input name="in1" type="float" nodename="wrinkles" />
      <input name="in2" type="float" value="0" />
    </add>
    <multiply name="uv_mm" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <multiply name="height_mm" type="float">
      <input name="in1" type="float" nodename="height" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <heighttonormal name="n_tangent" type="vector3">
      <input name="in" type="float" nodename="height_mm" />
      <input name="scale" type="float" value="16" />
      <input name="texcoord" type="vector2" nodename="uv_mm" />
    </heighttonormal>
    <normalmap name="n_world" type="vector3">
      <input name="in" type="vector3" nodename="n_tangent" />
    </normalmap>
    <constant name="base" type="float">
      <input name="value" type="float" value="1" />
    </constant>
    <constant name="specular" type="float">
      <input name="value" type="float" value="1" />
    </constant>
    <constant name="specular_IOR" type="float">
      <input name="value" type="float" value="1.5" />
    </constant>
    <constant name="diffuse_roughness" type="float">
      <input name="value" type="float" value="0.25" />
    </constant>
    <output name="out_base_color" type="color3" nodename="base_color" />
    <output name="out_roughness" type="float" nodename="roughness" />
    <output name="out_metalness" type="float" nodename="metalness" />
    <output name="out_normal" type="vector3" nodename="n_world" />
    <output name="out_base" type="float" nodename="base" />
    <output name="out_specular" type="float" nodename="specular" />
    <output name="out_specular_IOR" type="float" nodename="specular_IOR" />
    <output name="out_diffuse_roughness" type="float" nodename="diffuse_roughness" />
  </nodegraph>
  <standard_surface name="SR_copperLeaf" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_copperLeaf" output="out_base_color" />
    <input name="specular_roughness" type="float" nodegraph="NG_copperLeaf" output="out_roughness" />
    <input name="metalness" type="float" nodegraph="NG_copperLeaf" output="out_metalness" />
    <input name="normal" type="vector3" nodegraph="NG_copperLeaf" output="out_normal" />
    <input name="base" type="float" nodegraph="NG_copperLeaf" output="out_base" />
    <input name="specular" type="float" nodegraph="NG_copperLeaf" output="out_specular" />
    <input name="specular_IOR" type="float" nodegraph="NG_copperLeaf" output="out_specular_IOR" />
    <input name="diffuse_roughness" type="float" nodegraph="NG_copperLeaf" output="out_diffuse_roughness" />
  </standard_surface>
  <surfacematerial name="M_copperLeaf" type="material" doc="Thin copper metal finish with warm red-orange reflection, fine micro-wrinkles, and subtle oxidation variation.">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_copperLeaf" />
  </surfacematerial>
</materialx>
