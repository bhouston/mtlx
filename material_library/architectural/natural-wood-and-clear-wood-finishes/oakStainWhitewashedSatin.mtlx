<?xml version='1.0' encoding='utf-8'?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Whitewashed pale oak; open oak grain remains visible beneath a translucent stain and a clear satin coating. -->
  <!-- Authored linear Rec.709 art target; not a calibrated manufacturer sample. Regenerate with authoring/generate-mineral-wood.py. -->
  <nodegraph name="NG_oakStainWhitewashedSatin">
    <texcoord name="uv" type="vector2" />
    <!-- Metric UVs: one UV unit = one metre. Height values below are metres. -->
    <multiply name="multiply_1" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="65, 1.7" />
    </multiply>
    <add name="add_2" type="vector2">
      <input name="in1" type="vector2" nodename="multiply_1" />
      <input name="in2" type="vector2" value="11.1392308, 11.4846154" />
    </add>
    <fractal2d name="fractal2d_3" type="float">
      <input name="texcoord" type="vector2" nodename="add_2" />
      <input name="amplitude" type="float" value="1" />
      <input name="octaves" type="integer" value="3" />
      <input name="lacunarity" type="float" value="2.03" />
      <input name="diminish" type="float" value="0.5" />
    </fractal2d>
    <multiply name="multiply_4" type="float">
      <input name="in1" type="float" nodename="fractal2d_3" />
      <input name="in2" type="float" value="0.6" />
    </multiply>
    <add name="add_5" type="float">
      <input name="in1" type="float" nodename="multiply_4" />
      <input name="in2" type="float" value="0.5" />
    </add>
    <clamp name="clamp_6" type="float">
      <input name="in" type="float" nodename="add_5" />
      <input name="low" type="float" value="0" />
      <input name="high" type="float" value="1" />
    </clamp>
    <multiply name="multiply_7" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="320, 2.8" />
    </multiply>
    <add name="add_8" type="vector2">
      <input name="in1" type="vector2" nodename="multiply_7" />
      <input name="in2" type="vector2" value="37.3692308, 18.0746154" />
    </add>
    <fractal2d name="fractal2d_9" type="float">
      <input name="texcoord" type="vector2" nodename="add_8" />
      <input name="amplitude" type="float" value="1" />
      <input name="octaves" type="integer" value="2" />
      <input name="lacunarity" type="float" value="2.03" />
      <input name="diminish" type="float" value="0.5" />
    </fractal2d>
    <smoothstep name="smoothstep_10" type="float">
      <input name="in" type="float" nodename="fractal2d_9" />
      <input name="low" type="float" value="0.05" />
      <input name="high" type="float" value="0.38" />
    </smoothstep>
    <mix name="mix_11" type="float">
      <input name="bg" type="float" nodename="clamp_6" />
      <input name="fg" type="float" nodename="smoothstep_10" />
      <input name="mix" type="float" value="0.45" />
    </mix>
    <mix name="mix_12" type="float">
      <input name="bg" type="float" value="0.75" />
      <input name="fg" type="float" value="1.25" />
      <input name="mix" type="float" nodename="mix_11" />
    </mix>
    <multiply name="multiply_13" type="color3">
      <input name="in1" type="color3" value="0.6, 0.53, 0.41" />
      <input name="in2" type="float" nodename="mix_12" />
    </multiply>
    <subtract name="subtract_14" type="float">
      <input name="in1" type="float" nodename="clamp_6" />
      <input name="in2" type="float" value="0.5" />
    </subtract>
    <multiply name="multiply_15" type="float">
      <input name="in1" type="float" nodename="subtract_14" />
      <input name="in2" type="float" value="2.5e-05" />
    </multiply>
    <multiply name="multiply_16" type="float">
      <input name="in1" type="float" nodename="smoothstep_10" />
      <input name="in2" type="float" value="-2.5e-05" />
    </multiply>
    <add name="add_17" type="float">
      <input name="in1" type="float" nodename="multiply_15" />
      <input name="in2" type="float" nodename="multiply_16" />
    </add>
    <multiply name="multiply_18" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="vector2" value="1000, 90" />
    </multiply>
    <add name="add_19" type="vector2">
      <input name="in1" type="vector2" nodename="multiply_18" />
      <input name="in2" type="vector2" value="79.6692308, 26.1746154" />
    </add>
    <fractal2d name="fractal2d_20" type="float">
      <input name="texcoord" type="vector2" nodename="add_19" />
      <input name="amplitude" type="float" value="1" />
      <input name="octaves" type="integer" value="1" />
      <input name="lacunarity" type="float" value="2.03" />
      <input name="diminish" type="float" value="0.5" />
    </fractal2d>
    <smoothstep name="smoothstep_21" type="float">
      <input name="in" type="float" nodename="fractal2d_20" />
      <input name="low" type="float" value="0.27" />
      <input name="high" type="float" value="0.58" />
    </smoothstep>
    <subtract name="subtract_22" type="float">
      <input name="in1" type="float" value="1" />
      <input name="in2" type="float" nodename="smoothstep_21" />
    </subtract>
    <mix name="mix_23" type="float">
      <input name="bg" type="float" value="0.86" />
      <input name="fg" type="float" value="1.14" />
      <input name="mix" type="float" nodename="subtract_22" />
    </mix>
    <multiply name="multiply_24" type="color3">
      <input name="in1" type="color3" nodename="multiply_13" />
      <input name="in2" type="float" nodename="mix_23" />
    </multiply>
    <multiply name="multiply_25" type="float">
      <input name="in1" type="float" nodename="smoothstep_21" />
      <input name="in2" type="float" value="-1.5e-05" />
    </multiply>
    <add name="add_26" type="float">
      <input name="in1" type="float" nodename="add_17" />
      <input name="in2" type="float" nodename="multiply_25" />
    </add>
    <subtract name="subtract_27" type="float">
      <input name="in1" type="float" nodename="mix_11" />
      <input name="in2" type="float" value="0.5" />
    </subtract>
    <multiply name="multiply_28" type="float">
      <input name="in1" type="float" nodename="subtract_27" />
      <input name="in2" type="float" value="0.13" />
    </multiply>
    <add name="add_29" type="float">
      <input name="in1" type="float" value="0.38" />
      <input name="in2" type="float" nodename="multiply_28" />
    </add>
    <clamp name="clamp_30" type="float">
      <input name="in" type="float" nodename="add_29" />
      <input name="low" type="float" value="0.05" />
      <input name="high" type="float" value="0.97" />
    </clamp>
    <multiply name="height_mm" type="float">
      <input name="in1" type="float" nodename="add_26" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <multiply name="uv_mm" type="vector2">
      <input name="in1" type="vector2" nodename="uv" />
      <input name="in2" type="float" value="1000" />
    </multiply>
    <heighttonormal name="n_tangent" type="vector3">
      <input name="in" type="float" nodename="height_mm" />
      <input name="scale" type="float" value="16" />
      <input name="texcoord" type="vector2" nodename="uv_mm" />
    </heighttonormal>
    <normalmap name="n_world" type="vector3">
      <input name="in" type="vector3" nodename="n_tangent" />
    </normalmap>
    <constant name="metalness" type="float">
      <input name="value" type="float" value="0" />
    </constant>
    <output name="base_color_out" type="color3" nodename="multiply_24" />
    <output name="roughness_out" type="float" nodename="clamp_30" />
    <output name="metalness_out" type="float" nodename="metalness" />
    <output name="normal_out" type="vector3" nodename="n_world" />
    <output name="coat_normal_out" type="vector3" nodename="n_world" />
  </nodegraph>
  <standard_surface name="SR_oakStainWhitewashedSatin" type="surfaceshader">
    <input name="base" type="float" value="1" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="base_color" type="color3" nodegraph="NG_oakStainWhitewashedSatin" output="base_color_out" />
    <input name="specular_roughness" type="float" nodegraph="NG_oakStainWhitewashedSatin" output="roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_oakStainWhitewashedSatin" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_oakStainWhitewashedSatin" output="normal_out" />
    <input name="coat_normal" type="vector3" nodegraph="NG_oakStainWhitewashedSatin" output="coat_normal_out" />
    <input name="coat" type="float" value="0.65" />
    <input name="coat_roughness" type="float" value="0.32" />
    <input name="coat_IOR" type="float" value="1.5" />
  </standard_surface>
  <surfacematerial name="M_oakStainWhitewashedSatin" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_oakStainWhitewashedSatin" />
  </surfacematerial>
</materialx>