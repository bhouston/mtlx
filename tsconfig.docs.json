{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "composite": false,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "outDir": "dist-docs"
  },
  "include": ["packages/core/src/**/*", "packages/viewer/src/**/*"],
  "exclude": ["**/node_modules/**", "**/dist/**", "**/*.test.ts"]
}
