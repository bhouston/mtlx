<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- unifiednoise2d, freq 6, output shown directly as grey.
       UV 0..1 = 1 m. Layout (3x2, row 1 at the bottom = v small, column 1 at the left):
         [r1 c1] type 0 perlin: 0.5 + 0.5*noise2d
         [r1 c2] type 1 cell noise: one random 0..1 per unit cell
         [r1 c3] type 2 worley F1 distance (jitter, style apply)
         [r2 c1] type 3 fractal, defaults: signed, clamped -> black holes
         [r2 c2] type 3, outmin 0.5 outmax 1 clampoutput false: 0.5 + 0.5*fractal
         [r2 c3] type 0, jitter 1.0001: same noise rotated 9 degrees about texcoord 0
  -->
  <nodegraph name="NG_unified">
    <texcoord name="uv" type="vector2" />
    <separate2 name="uv_s" type="multioutput"><input name="in" type="vector2" nodename="uv" /><output name="outx" type="float" /><output name="outy" type="float" /></separate2>

    <!-- ===== [r1 c1] type 0 perlin: 0.5 + 0.5*noise2d ===== -->
    <unifiednoise2d name="p11_n" type="float"><input name="texcoord" type="vector2" nodename="uv" /><input name="freq" type="vector2" value="6, 6" /><input name="type" type="integer" value="0" /></unifiednoise2d>

    <!-- ===== [r1 c2] type 1 cell noise: one random 0..1 per unit cell ===== -->
    <subtract name="p12_uv0" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="0.3333, 0.0000" /></subtract>
    <unifiednoise2d name="p12_n" type="float"><input name="texcoord" type="vector2" nodename="p12_uv0" /><input name="freq" type="vector2" value="6, 6" /><input name="type" type="integer" value="1" /></unifiednoise2d>

    <!-- ===== [r1 c3] type 2 worley F1 distance (jitter, style apply) ===== -->
    <subtract name="p13_uv0" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="0.6667, 0.0000" /></subtract>
    <unifiednoise2d name="p13_n" type="float"><input name="texcoord" type="vector2" nodename="p13_uv0" /><input name="freq" type="vector2" value="6, 6" /><input name="type" type="integer" value="2" /></unifiednoise2d>

    <!-- ===== [r2 c1] type 3 fractal, defaults: signed, clamped -> black holes ===== -->
    <subtract name="p21_uv0" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="0.0000, 0.5000" /></subtract>
    <unifiednoise2d name="p21_n" type="float"><input name="texcoord" type="vector2" nodename="p21_uv0" /><input name="freq" type="vector2" value="6, 6" /><input name="type" type="integer" value="3" /></unifiednoise2d>

    <!-- ===== [r2 c2] type 3, outmin 0.5 outmax 1 clampoutput false: 0.5 + 0.5*fractal ===== -->
    <subtract name="p22_uv0" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="0.3333, 0.5000" /></subtract>
    <unifiednoise2d name="p22_n" type="float"><input name="texcoord" type="vector2" nodename="p22_uv0" /><input name="freq" type="vector2" value="6, 6" /><input name="type" type="integer" value="3" /><input name="outmin" type="float" value="0.5" /><input name="outmax" type="float" value="1" /><input name="clampoutput" type="boolean" value="false" /></unifiednoise2d>

    <!-- ===== [r2 c3] type 0, jitter 1.0001: same noise rotated 9 degrees about texcoord 0 ===== -->
    <subtract name="p23_uv0" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="0.6667, 0.5000" /></subtract>
    <unifiednoise2d name="p23_n" type="float"><input name="texcoord" type="vector2" nodename="p23_uv0" /><input name="freq" type="vector2" value="6, 6" /><input name="type" type="integer" value="0" /><input name="jitter" type="float" value="1.0001" /></unifiednoise2d>

    <!-- ===== panel selection ===== -->
    <ifgreater name="sel_r0_c1" type="float"><input name="value1" type="float" nodename="uv_s" output="outx" /><input name="value2" type="float" value="0.3333" /><input name="in1" type="float" nodename="p12_n" /><input name="in2" type="float" nodename="p11_n" /></ifgreater>
    <ifgreater name="sel_r0_c2" type="float"><input name="value1" type="float" nodename="uv_s" output="outx" /><input name="value2" type="float" value="0.6667" /><input name="in1" type="float" nodename="p13_n" /><input name="in2" type="float" nodename="sel_r0_c1" /></ifgreater>
    <ifgreater name="sel_r1_c1" type="float"><input name="value1" type="float" nodename="uv_s" output="outx" /><input name="value2" type="float" value="0.3333" /><input name="in1" type="float" nodename="p22_n" /><input name="in2" type="float" nodename="p21_n" /></ifgreater>
    <ifgreater name="sel_r1_c2" type="float"><input name="value1" type="float" nodename="uv_s" output="outx" /><input name="value2" type="float" value="0.6667" /><input name="in1" type="float" nodename="p23_n" /><input name="in2" type="float" nodename="sel_r1_c1" /></ifgreater>
    <ifgreater name="sel_row1" type="float"><input name="value1" type="float" nodename="uv_s" output="outy" /><input name="value2" type="float" value="0.5000" /><input name="in1" type="float" nodename="sel_r1_c2" /><input name="in2" type="float" nodename="sel_r0_c2" /></ifgreater>
    <!-- selected panel value -->
    <multiply name="value" type="float"><input name="in1" type="float" nodename="sel_row1" /><input name="in2" type="float" value="1" /></multiply>
    <convert name="value_c" type="color3"><input name="in" type="float" nodename="value" /></convert>
    <output name="emission_out" type="color3" nodename="value_c" />
  </nodegraph>
  <standard_surface name="SR_unified" type="surfaceshader"><input name="base" type="float" value="0" /><input name="specular" type="float" value="0" /><input name="emission" type="float" value="1" /><input name="emission_color" type="color3" nodegraph="NG_unified" output="emission_out" /></standard_surface>
  <surfacematerial name="M_unified" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_unified" /></surfacematerial>
</materialx>
