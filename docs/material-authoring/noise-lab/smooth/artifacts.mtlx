<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Bottom row noise2d at 24/m, top row at 6/m; grey = 0.5 + 0.4*value. Lattice pinch points (value 0 at every integer texcoord) and float32 precision.
       UV 0..1 = 1 m. Layout (2x2, row 1 at the bottom = v small, column 1 at the left):
         [r1 c1] plain noise2d(uv*24): mid-grey pinch dots on a square grid, blobs aligned to the axes
         [r1 c2] two rotated, offset copies averaged (x0.75): no visible grid
         [r2 c1] noise2d(uv*6 + 1e5): still smooth
         [r2 c2] noise2d(uv*6 + 1e6): float32 steps of 1/16 cell visible
  -->
  <nodegraph name="NG_artifacts">
    <texcoord name="uv" type="vector2" />
    <separate2 name="uv_s" type="multioutput"><input name="in" type="vector2" nodename="uv" /><output name="outx" type="float" /><output name="outy" type="float" /></separate2>

    <!-- ===== [r1 c1] plain noise2d(uv*24): mid-grey pinch dots on a square grid, blobs aligned to the axes ===== -->
    <multiply name="p11_uv" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="24" /></multiply>
    <noise2d name="p11_n" type="float"><input name="texcoord" type="vector2" nodename="p11_uv" /></noise2d>
    <multiply name="p11_g0" type="float"><input name="in1" type="float" nodename="p11_n" /><input name="in2" type="float" value="0.8" /></multiply>
    <add name="p11_g" type="float"><input name="in1" type="float" nodename="p11_g0" /><input name="in2" type="float" value="0.5" /></add>

    <!-- ===== [r1 c2] two rotated, offset copies averaged (x0.75): no visible grid ===== -->
    <subtract name="p12_uv0" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="0.5000, 0.0000" /></subtract>
    <multiply name="p12_uv" type="vector2"><input name="in1" type="vector2" nodename="p12_uv0" /><input name="in2" type="float" value="24" /></multiply>
    <rotate2d name="p12_ra" type="vector2"><input name="in" type="vector2" nodename="p12_uv" /><input name="amount" type="float" value="31" /></rotate2d>
    <add name="p12_oa" type="vector2"><input name="in1" type="vector2" nodename="p12_ra" /><input name="in2" type="vector2" value="17.31, 5.77" /></add>
    <noise2d name="p12_na" type="float"><input name="texcoord" type="vector2" nodename="p12_oa" /></noise2d>
    <rotate2d name="p12_rb" type="vector2"><input name="in" type="vector2" nodename="p12_uv" /><input name="amount" type="float" value="-58" /></rotate2d>
    <add name="p12_ob" type="vector2"><input name="in1" type="vector2" nodename="p12_rb" /><input name="in2" type="vector2" value="-3.13, 41.9" /></add>
    <noise2d name="p12_nb" type="float"><input name="texcoord" type="vector2" nodename="p12_ob" /></noise2d>
    <add name="p12_s" type="float"><input name="in1" type="float" nodename="p12_na" /><input name="in2" type="float" nodename="p12_nb" /></add>
    <multiply name="p12_n" type="float"><input name="in1" type="float" nodename="p12_s" /><input name="in2" type="float" value="0.75" /></multiply>
    <multiply name="p12_g0" type="float"><input name="in1" type="float" nodename="p12_n" /><input name="in2" type="float" value="0.8" /></multiply>
    <add name="p12_g" type="float"><input name="in1" type="float" nodename="p12_g0" /><input name="in2" type="float" value="0.5" /></add>

    <!-- ===== [r2 c1] noise2d(uv*6 + 1e5): still smooth ===== -->
    <subtract name="p21_uv0" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="0.0000, 0.5000" /></subtract>
    <multiply name="p21_uv" type="vector2"><input name="in1" type="vector2" nodename="p21_uv0" /><input name="in2" type="float" value="6" /></multiply>
    <add name="p21_uvo" type="vector2"><input name="in1" type="vector2" nodename="p21_uv" /><input name="in2" type="vector2" value="100000, 100000" /></add>
    <noise2d name="p21_n" type="float"><input name="texcoord" type="vector2" nodename="p21_uvo" /></noise2d>
    <multiply name="p21_g0" type="float"><input name="in1" type="float" nodename="p21_n" /><input name="in2" type="float" value="0.8" /></multiply>
    <add name="p21_g" type="float"><input name="in1" type="float" nodename="p21_g0" /><input name="in2" type="float" value="0.5" /></add>

    <!-- ===== [r2 c2] noise2d(uv*6 + 1e6): float32 steps of 1/16 cell visible ===== -->
    <subtract name="p22_uv0" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="0.5000, 0.5000" /></subtract>
    <multiply name="p22_uv" type="vector2"><input name="in1" type="vector2" nodename="p22_uv0" /><input name="in2" type="float" value="6" /></multiply>
    <add name="p22_uvo" type="vector2"><input name="in1" type="vector2" nodename="p22_uv" /><input name="in2" type="vector2" value="1000000, 1000000" /></add>
    <noise2d name="p22_n" type="float"><input name="texcoord" type="vector2" nodename="p22_uvo" /></noise2d>
    <multiply name="p22_g0" type="float"><input name="in1" type="float" nodename="p22_n" /><input name="in2" type="float" value="0.8" /></multiply>
    <add name="p22_g" type="float"><input name="in1" type="float" nodename="p22_g0" /><input name="in2" type="float" value="0.5" /></add>

    <!-- ===== panel selection ===== -->
    <ifgreater name="sel_r0_c1" type="float"><input name="value1" type="float" nodename="uv_s" output="outx" /><input name="value2" type="float" value="0.5000" /><input name="in1" type="float" nodename="p12_g" /><input name="in2" type="float" nodename="p11_g" /></ifgreater>
    <ifgreater name="sel_r1_c1" type="float"><input name="value1" type="float" nodename="uv_s" output="outx" /><input name="value2" type="float" value="0.5000" /><input name="in1" type="float" nodename="p22_g" /><input name="in2" type="float" nodename="p21_g" /></ifgreater>
    <ifgreater name="sel_row1" type="float"><input name="value1" type="float" nodename="uv_s" output="outy" /><input name="value2" type="float" value="0.5000" /><input name="in1" type="float" nodename="sel_r1_c1" /><input name="in2" type="float" nodename="sel_r0_c1" /></ifgreater>
    <!-- selected panel value -->
    <multiply name="value" type="float"><input name="in1" type="float" nodename="sel_row1" /><input name="in2" type="float" value="1" /></multiply>
    <convert name="value_c" type="color3"><input name="in" type="float" nodename="value" /></convert>
    <output name="emission_out" type="color3" nodename="value_c" />
  </nodegraph>
  <standard_surface name="SR_artifacts" type="surfaceshader"><input name="base" type="float" value="0" /><input name="specular" type="float" value="0" /><input name="emission" type="float" value="1" /><input name="emission_color" type="color3" nodegraph="NG_artifacts" output="emission_out" /></standard_surface>
  <surfacematerial name="M_artifacts" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_artifacts" /></surfacematerial>
</materialx>
