    <mix name="mix_125" type="color3"><input name="bg" type="color3" nodename="mix_122" /><input name="fg" type="color3" value="1.0, 0.6, 0.1" /><input name="mix" type="float" nodename="ifgreater_123" /></mix>
    <ifgreater name="ifgreater_126" type="float"><input name="value1" type="float" nodename="jac_det" /><input name="value2" type="float" value="4.0" /><input name="in1" type="float" value="1.0" /><input name="in2" type="float" value="0.0" /></ifgreater>
