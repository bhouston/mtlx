    <separate2 name="dy" type="multioutput"><input name="in" type="vector2" nodename="subtract_104" /></separate2>
    <multiply name="multiply_106" type="float"><input name="in1" type="float" nodename="dx" output="outx" /><input name="in2" type="float" nodename="dy" output="outy" /></multiply>
    <multiply name="multiply_107" type="float"><input name="in1" type="float" nodename="dx" output="outy" /><input name="in2" type="float" nodename="dy" output="outx" /></multiply>
