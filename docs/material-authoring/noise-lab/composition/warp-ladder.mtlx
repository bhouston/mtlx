    <max name="max_139" type="float"><input name="in1" type="float" nodename="smoothstep_133" /><input name="in2" type="float" nodename="smoothstep_138" /></max>
    <mix name="mix_140" type="color3"><input name="bg" type="color3" nodename="mix_128" /><input name="fg" type="color3" value="0.1, 0.3, 1.0" /><input name="mix" type="float" nodename="max_139" /></mix>
    <output name="emission_out" type="color3" nodename="mix_140" />
