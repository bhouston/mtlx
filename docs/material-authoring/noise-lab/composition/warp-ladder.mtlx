    <ifgreater name="ifgreater_100" type="vector2"><input name="value1" type="float" nodename="row" /><input name="value2" type="float" value="1.5" /><input name="in1" type="vector2" nodename="add_78" /><input name="in2" type="vector2" nodename="add_85" /></ifgreater>
    <ifgreater name="ifgreater_101" type="vector2"><input name="value1" type="float" nodename="row" /><input name="value2" type="float" value="0.5" /><input name="in1" type="vector2" nodename="ifgreater_100" /><input name="in2" type="vector2" nodename="add_99" /></ifgreater>
