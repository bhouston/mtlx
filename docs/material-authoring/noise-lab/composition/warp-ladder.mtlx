    <modulo name="modulo_112" type="float"><input name="in1" type="float" nodename="multiply_111" /><input name="in2" type="float" value="1.0" /></modulo>
    <subtract name="subtract_113" type="float"><input name="in1" type="float" nodename="modulo_112" /><input name="in2" type="float" value="0.5" /></subtract>
    <absval name="absval_114" type="float"><input name="in" type="float" nodename="subtract_113" /></absval>
    <smoothstep name="smoothstep_115" type="float"><input name="in" type="float" nodename="absval_114" /><input name="low" type="float" value="0.4" /><input name="high" type="float" value="0.46" /></smoothstep>
