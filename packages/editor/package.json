{
  "name": "mtlx-editor",
  "version": "0.1.0",
  "description": "Reusable MaterialX document editing operations and React Flow components.",
  "license": "MIT",
  "files": [
    "dist",
    "styles.css"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "default": "./dist/model.js"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w --preserveWatchOutput"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.0",
    "lucide-react": "^0.544.0",
    "mtlx-core": "workspace:*",
    "radix-ui": "^1.6.7",
    "react-colorful": "^5.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
