{
  "name": "@mtlx/cli",
  "version": "0.1.0",
  "description": "mtlx: validate, inspect, and pack/unpack MaterialX (.mtlx, .mtlz, .mtlx.zip) files.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/mtlx.git",
    "directory": "packages/cli"
  },
  "bin": {
    "mtlx": "./bin/cli.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w --preserveWatchOutput --noEmitOnError",
    "start": "node bin/cli.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@mtlx/core": "workspace:*",
    "type-fest": "^5.1.0",
    "yaml": "^2.7.0",
    "yargs": "^18.0.0",
    "yargs-file-commands": "^1.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/yargs": "^17.0.35",
    "fflate": "^0.8.3",
    "source-map-support": "^0.5.21",
    "vitest-command-line": "^0.9.0"
  }
}
