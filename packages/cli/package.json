{
  "name": "mtlx-cli",
  "version": "0.6.0",
  "description": "mtlx: validate, inspect, convert, and transform MaterialX (.mtlx, .mtlx.zip) files.",
  "homepage": "https://mtlx.ben3d.ca",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/mtlx.git",
    "directory": "packages/cli"
  },
  "bin": {
    "mtlx": "./bin/cli.js",
    "mtlx-ai": "./bin/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "bin",
    "media"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && node scripts/build-viewer.mjs",
    "dev": "tsc -w --preserveWatchOutput",
    "start": "node bin/cli.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@clidoc/core": "^1.0.0",
    "@clidoc/yargs": "^0.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sentry/node": "^10.74.0",
    "chalk": "^5.3.0",
    "fast-glob": "^3.3.3",
    "hdrify": "^1.1.4",
    "humanize-units": "^2.0.4",
    "js-yaml": "^4.1.1",
    "mtlx-core": "workspace:*",
    "mtlx-sdk": "workspace:*",
    "mtlx-viewer": "workspace:*",
    "open": "^10.1.0",
    "p-limit": "^5.0.0",
    "playwright-core": "^1.63.0",
    "source-map-support": "~0.5.21",
    "type-fest": "^5.1.0",
    "yaml": "^2.7.0",
    "yargs": "^18.0.0",
    "yargs-file-commands": "^1.2.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "@types/source-map-support": "^0.5.10",
    "@types/three": "^0.186.0",
    "@types/yargs": "^17.0.35",
    "esbuild": "^0.27.3",
    "fflate": "^0.8.3",
    "sharp": "^0.35.4",
    "source-map-support": "^0.5.21",
    "three": "^0.186.0",
    "vitest-command-line": "^0.9.0"
  }
}
