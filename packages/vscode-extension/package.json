{
  "name": "mtlx-vscode-extension",
  "displayName": "Mtlx Viewer",
  "version": "0.4.5",
  "description": "Preview, inspect, and convert MaterialX files (.mtlx, .mtlx.zip) with a 3D viewer built on three.js",
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "3d",
    "material",
    "materialx",
    "mtlx",
    "preview",
    "shader"
  ],
  "homepage": "https://mtlx.ben3d.ca",
  "bugs": {
    "url": "https://github.com/bhouston/mtlx/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Ben Houston",
    "url": "https://ben3d.ca"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bhouston/mtlx.git",
    "directory": "packages/vscode-extension"
  },
  "publisher": "benhouston3d",
  "type": "module",
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p .",
    "build:preview": "node scripts/build-preview.js",
    "build:extension": "node scripts/build-extension.js",
    "build": "pnpm run build:preview && pnpm run build:extension",
    "watch": "tsc -watch -p .",
    "package": "pnpm run build && vsce package --no-dependencies",
    "check:preview": "tsc -p tsconfig.preview.json"
  },
  "dependencies": {
    "mtlx-core": "workspace:*",
    "mtlx-viewer": "workspace:*"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.27.3",
    "three": "^0.186.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "mtlx.convertToMtlx",
        "title": "Convert to .mtlx"
      },
      {
        "command": "mtlx.convertToMtlxZip",
        "title": "Convert to .mtlx.zip"
      },
      {
        "command": "mtlx.openPreview",
        "title": "Open with Mtlx Viewer"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mtlx.convertToMtlx",
          "when": "(resourceFilename =~ /\\.mtlx\\.zip$/i) || (listMultiSelection && resourceFilename =~ /\\.(mtlx|mtlx\\.zip)$/i)",
          "group": "7_modification"
        },
        {
          "command": "mtlx.convertToMtlxZip",
          "when": "(resourceFilename =~ /\\.mtlx$/i) || (listMultiSelection && resourceFilename =~ /\\.(mtlx|mtlx\\.zip)$/i)",
          "group": "7_modification"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "mtlx.mtlxPreview",
        "displayName": "Mtlx Viewer",
        "selector": [
          {
            "filenamePattern": "*.mtlx"
          },
          {
            "filenamePattern": "*.mtlx.zip"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Mtlx Viewer",
      "properties": {
        "mtlx.preview.ibls": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "description": "Additional equirectangular HDR, EXR, PNG or JPEG environments. Built-in names: bridge, studio.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "source"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
                "description": "Unique case-sensitive identifier. Built-in names are reserved."
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "description": "Local file path or HTTP(S) URL. Relative paths use the material workspace folder; ~ uses your home folder."
              }
            }
          }
        },
        "mtlx.preview.geometries": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "description": "Additional glTF/GLB preview geometries. Built-in names: totem, sphere, plane.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "source"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
                "description": "Unique case-sensitive identifier. Built-in names are reserved."
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "description": "Local file path or HTTP(S) URL. Relative paths use the material workspace folder; ~ uses your home folder."
              }
            }
          }
        },
        "mtlx.preview.defaultIbl": {
          "type": "string",
          "default": "bridge",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
          "scope": "resource",
          "description": "IBL name used for new previews. Built-ins: bridge, studio; or an additional IBL name."
        },
        "mtlx.preview.defaultGeometry": {
          "type": "string",
          "default": "totem",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
          "scope": "resource",
          "description": "Geometry name used for new previews. Built-ins: totem, sphere, plane; or an additional geometry name."
        },
        "mtlx.preview.autoRotate": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Rotate new previews by default. Reduced-motion preferences take precedence; rotation can still be enabled manually."
        },
        "mtlx.preview.bloom": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable HDR bloom by default."
        },
        "mtlx.preview.ao": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable full-resolution, denoised GTAO ambient occlusion by default."
        },
        "mtlx.preview.toneMapping": {
          "type": "string",
          "default": "neutral",
          "enum": [
            "neutral",
            "aces",
            "agx",
            "reinhard",
            "cineon",
            "linear",
            "none"
          ],
          "scope": "resource",
          "description": "Tone mapping for new previews: Neutral, ACES Filmic, AgX, Reinhard, Cineon, Linear, or None."
        }
      }
    }
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  }
}
