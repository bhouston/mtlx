{
  "name": "mtlx-core",
  "version": "0.4.0",
  "description": "Parse, validate, package, and transform MaterialX (.mtlx, .mtlx.zip) documents in Node and the browser.",
  "keywords": [
    "3d",
    "material",
    "materialx",
    "mtlx",
    "shader",
    "usd"
  ],
  "homepage": "https://mtlx.ben3d.ca",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/mtlx.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "browser": {
    "fs": false,
    "path": false
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./textures": {
      "types": "./dist/textures.d.ts",
      "default": "./dist/textures.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w --preserveWatchOutput --noEmitOnError",
    "test": "vitest run"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0",
    "fflate": "^0.8.3",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.0"
  }
}
