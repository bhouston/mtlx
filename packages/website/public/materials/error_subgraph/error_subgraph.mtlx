<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Intentionally invalid sample: expand finish, then roughness. The color output
       drives amount.in1, which expects float. Disconnect that wire to clear the error
       on both containers. The graph is separate from the valid surface preview. -->
  <nodegraph name="finish" xpos="0" ypos="0">
    <nodegraph name="roughness" xpos="0" ypos="0">
      <constant name="color" type="color3" xpos="0" ypos="0">
        <input name="value" type="color3" value="0.8, 0.2, 0.1"/>
      </constant>
      <add name="amount" type="float" xpos="340" ypos="0">
        <input name="in1" type="float" nodename="color"/>
        <input name="in2" type="float" value="0.3"/>
      </add>
      <output name="out" type="float" nodename="amount" xpos="680" ypos="0"/>
    </nodegraph>
    <output name="out" type="float" nodegraph="roughness" output="out" xpos="340" ypos="0"/>
  </nodegraph>
  <standard_surface name="surface" type="surfaceshader" xpos="340" ypos="0">
    <input name="base_color" type="color3" value="0.8, 0.2, 0.1"/>
    <input name="specular_roughness" type="float" value="0.3"/>
  </standard_surface>
  <surfacematerial name="material" type="material" xpos="680" ypos="240">
    <input name="surfaceshader" type="surfaceshader" nodename="surface"/>
  </surfacematerial>
</materialx>
